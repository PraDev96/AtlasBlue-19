<?xml version='1.0' encoding='utf-8'?>
<odoo>

	<record id="seq_hr_penalty" model="ir.sequence">
        <field name="name">Penalty</field>
        <field name="code">hr.penalty</field>
        <field name="prefix"></field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>

     <record id="hr_salary_rule_penalty_kuwait" model="hr.salary.rule">
            <field name="condition_select">python</field>
            <field name="condition_python">result = employee.get_penalty_deduction(payslip) != 0</field>
            <field name="amount_select">code</field>
            <field name="code">PENA</field>
            <field name="category_id" ref="hr_payroll.DED"/>
            <field name="name">Penalty Deduction</field>
            <field name="sequence" eval="120"/>
            <field name="struct_id" ref="boutiqaat_hr_payslip.payroll_structure_kuwait"/>
            <field name="amount_python_compute">
result = employee.get_penalty_deduction(payslip) * -1
            </field>
        </record>

