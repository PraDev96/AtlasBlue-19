<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_hr_penalty_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <h3 class="text-center">Penalty Report</h3>

                    <div class="row">
                        <table class="table table-borderless">
                            <tr>
                                <td>
                                    <strong>Employee Number</strong>
                                </td>
                                <td>
                                    <strong>
                                        <span t-field="emp.identification_id"/>
                                    </strong>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Employee</strong>
                                </td>
                                <td>
                                    <strong t-field="emp.name"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Employee Position</strong>
                                </td>
                                <td>
                                    <strong t-field="emp.job_id"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Employee Joining Date</strong>
                                </td>
                                <td>
                                    <strong t-field="emp.date_joining"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Company</strong>
                                </td>
                                <td>
                                    <strong t-field="emp.company_id"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="row">
                        <table class="table table-borderless">
                            <thead>
                                <tr>
                                    <th>Penalty Number</th>
                                    <th>Date of Penalty</th>
                                    <th>Penalty Details</th>
                                    <th>Penalty Decision</th>
                                    <th>Amount</th>
                                    <th>Payslip Date</th>
                                    <th>Warning Type</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="emp_wise_data" t-as="penalty">
                                    <tr>
                                        <td>
                                            <span t-field="penalty.name"/>
                                        </td>
                                        <td>
                                            <span t-field="penalty.date_penalty"/>
                                        </td>
                                        <td>
                                            <span t-field="penalty.detail"/>
                                        </td>
                                        <td>
                                            <span t-field="penalty.decision"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="penalty.amount"/>
                                        </td>
                                        <td>
                                            <span t-field="penalty.payslip_date"/>
                                        </td>
                                        <td>
                                            <span t-field="penalty.warning_type"/>
                                        </td>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div style="display: block; height: 165px"/>
                    <div class="row mt256" style="padding-bottom: 10px">
                        <div class="col-4">
                            <strong>Reviewed By</strong>
                        </div>
                        <div class="col-4">
                            <strong>Acknowledged By</strong>
                        </div>
                        <div class="col-4">
                            <strong>Approved By</strong>
                        </div>
                    </div>
                    <div class="row mt32">
                        <div class="col-4">
                            <strong>Date</strong>
                        </div>
                        <div class="col-8"/>
                    </div>
                </div>
            </t>
        </template>


        <template id="report_hr_penalty">
            <t t-call="web.html_container">
                <t t-foreach="docs.mapped('employee_id')" t-as="emp">
                    <t t-call="hr_penalty.report_hr_penalty_document">
                        <t t-set="emp_wise_data" t-value="docs.filtered(lambda d: d.employee_id.id == emp.id)"/>
                    </t>
                </t>
            </t>
        </template>

    </data>
</odoo>
