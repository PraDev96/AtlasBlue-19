<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
    <t t-inherit="web.KanbanView.Group" t-inherit-mode="extension">
        <xpath expr="//div[hasclass('o_kanban_header_title')]" position="after">
            <t t-if="widget.modelName == 'project.task' and widget.groupedBy == 'stage_id'">
                <t t-log="widget" />
            </t>
        </xpath>
    </t>
</templates>
