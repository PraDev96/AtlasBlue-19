<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record model="ir.ui.view" id="account_opportunity_type_form_view">
        <field name="name">account.opportunity.type.form.view</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='company_id']" position="after">
                <field name="project_opportunity_type"/>
            </xpath>

        </field>
    </record>

    <record model="ir.ui.view" id="account_opportunity_type_list_view">
        <field name="name">account.opportunity.type.list.view</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_list"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='company_id']" position="after">
                <field name="project_opportunity_type"/>
            </xpath>

        </field>
    </record>

    <record model="ir.ui.view" id="account_opportunity_type_search_view">
        <field name="name">account.opportunity.type.search.view</field>
        <field name="model">account.account</field>
        <field name="inherit_id" ref="account.view_account_search"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='accounttype']" position="after">
                <filter string="Opportunity Type" name="project_opportunity_type" domain="" context="{'group_by':'project_opportunity_type'}"/>
            </xpath>

        </field>
    </record>

</odoo>
