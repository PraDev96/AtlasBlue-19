<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_sale_order_form_inherite_quick_add_product_button" model="ir.ui.view">
        <field name="name">view.sale.order.form.inherite.quick.add.product.button</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_quotation_send']" position="before">
                <button name="quick_add_product" class="oe_highlight" invisible="state != 'draft'" type="object" string="Quick Add Product"/>
            </xpath>

        </field>
    </record>

</odoo>
