<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_employee_cost_form" model="ir.ui.view">
        <field name="name">employee.cost.form</field>
        <field name="model">employee.cost</field>
        <field name="arch" type="xml">

            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="employee_id"/>
                            <field name="create_date" readonly="True"/>
                            <field name="task_id"/>
                            <field name="currency_id"/>
                            <field name="price_unit" groups="hr_payroll.group_hr_payroll_manager"/>
                            <field name="subtotal" groups="hr_payroll.group_hr_payroll_manager"/>
                            <field name="planned_cost_hours"/>
                            <field name="sale_hour_cost"/>
                            <field name="regular_ot"/>
                            <field name="week_ot"/>
                        </group>
                        <group>
                            <field name="project_id"/>
                            <field name="company_id"/>
                            <field name="description"/>
                            <field name="hours_spent" widget="float_time"/>
                            <field name="planned_hours"/>
                            <field name="hour_cost"/>
                            <field name="sale_cost_hours"/>
                            <field name="holiday_ot"/>
                            <field name="opportunity_type"/>
                            <field name="team_id"/>
                            <field name="user_id"/>
                        </group>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <record id="view_employee_cost_tree" model="ir.ui.view">
        <field name="name">employee.cost.tree</field>
        <field name="model">employee.cost</field>
        <field name="arch" type="xml">

            <list create="0" edit="0" delete="0">
                <field name="employee_id"/>
                <field name="create_date"/>
                <field name="hours_spent" sum="Total Hours" widget="float_time"/>
                <field name="price_unit" sum="Unit Price" groups="hr_payroll.group_hr_payroll_manager"/>
                <field name="subtotal" sum="Subtotal" groups="hr_payroll.group_hr_payroll_manager"/>
            </list>

        </field>
    </record>

    <record id="view_employee_cost_filter" model="ir.ui.view">
        <field name="name">employee.cost.filter</field>
        <field name="model">employee.cost</field>
        <field name="arch" type="xml">

            <search string="Views">
                <field name="employee_id"/>
                <field name="create_date"/>
                <field name="project_id"/>
                <field name="currency_id"/>
                <field name="company_id"/>
                <field name="price_unit" groups="hr_payroll.group_hr_payroll_manager"/>
                <field name="hours_spent"/>
                <field name="subtotal" groups="hr_payroll.group_hr_payroll_manager"/>
                <field name="planned_hours"/>
                <field name="planned_cost_hours"/>
                <field name="hour_cost"/>
                <field name="sale_hour_cost"/>
                <field name="sale_cost_hours"/>
                <field name="regular_ot"/>
                <field name="holiday_ot"/>
                <field name="week_ot"/>
                <field name="opportunity_type"/>
                <field name="team_id"/>
                <field name="user_id"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="project" domain="[]" context="{'group_by':'project_id'}"/>
                    <filter string="Task" name="task" domain="[]" context="{'group_by':'task_id'}"/>
                    <filter string="Employee" name="employee" domain="[]" context="{'group_by':'employee_id'}"/>
                    <filter string="Vehicle" name="vehicle" domain="[]" context="{'group_by':'vehicle_id'}"/>
                    <filter string="Restaurant" name="restaurant" domain="[]" context="{'group_by':'restaurant_id'}"/>
                    <filter string="Currency" name="currency" domain="[]" context="{'group_by':'currency_id'}"/>
                    <filter string="Company" name="company" domain="[]" context="{'group_by':'company_id'}"/>
                    <filter string="Create Date" name="create_date" domain="[]" context="{'group_by':'create_date'}"/>
                    <filter string="Opportunity Type" name="opportunity_type" context="{'group_by':'opportunity_type'}"/>
                    <filter string="Project Team" name="team_id" context="{'group_by':'team_id'}"/>
                    <filter string="Project Team Leader" name="user_id" context="{'group_by': 'user_id'}"/>
                </group>
            </search>

        </field>
    </record>

    <record id="action_employee_cost" model="ir.actions.act_window">
        <field name="name">Employee Cost</field>
        <field name="res_model">employee.cost</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_project': 1}</field>
    </record>

    <menuitem id="menu_employee_cost"
              name="Employee Cost"
              action="action_employee_cost"
              parent="project.menu_project_report"/>

</odoo>
