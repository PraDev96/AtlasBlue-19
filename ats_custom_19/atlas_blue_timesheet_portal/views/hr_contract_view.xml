<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_contract_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit</field>
        <field name="model">hr.version</field>
        <field name="inherit_id" ref="hr.hr_contract_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//label[@for='total_leave_salary']" position="before">
                <label for="per_hour_wage"/>
                <div class="o_row" name="per_hour_wage">
                    <field name="per_hour_wage" nolabel="1"/><span>/ hour</span>
                </div>
            </xpath>
        </field>
    </record>

</odoo>
