<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="atlas_blue_timesheet_portal_portal_my_task_inherits" inherit_id="hr_timesheet.portal_my_task" name="Portal: My Task with Timesheets Inherit">
        <xpath expr="//a[@href='#task_timesheets']" position="attributes">
            <attribute name="style">display: none</attribute>
        </xpath>
    </template>

    <template id="atlas_blue_timesheet_portal_timesheet_table_inherit" inherit_id="hr_timesheet.portal_timesheet_table" name="Portal: Portal Timesheet Table Inherit">
        <xpath expr="//table[hasclass('o_portal_my_doc_table')]" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//div[hasclass('container_subtotal')]" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
    </template>

    <template id="hr_timesheet_portal_my_task_inherit_details" inherit_id="hr_timesheet.portal_my_task" name="Portal: My Task with Timesheet">
        <xpath expr="//div[@id='card_body']" position="inside">
            <div class="container pt-2 portal_custom_timesheet_add" id="task_timesheet_content">
                <div class="row">
                    <div class="col-12">
                        <span>
                            <h2>Timesheet</h2>
                        </span>
                    </div>
                </div>
                <div class="row">
                    <div class="col-md-2 col-sm-12">
                        <input type="hidden" t-att-value="exist_rec and exist_rec.id or ''" id="exist_rec"/>
                        <input type="number" name="timesheet_id" t-att-data-timesheet_id="exist_rec.id" style="display: none"/>
                        <button class="btn btn-primary start_btn_custom" t-att-data-task_id="task.id"
                                t-att-style="'' if (not exist_rec or not exist_rec.start_date) else 'display: none;'">Sign in
                        </button>
                        <span class="start_time_show"
                              t-att-style="'display: none;' if (not exist_rec or not exist_rec.start_date) else ''">
                            <t t-if="exist_rec and exist_rec.start_date" t-esc="account_analytic_rec_start_date.strftime('%Y-%m-%d %H:%M:%S')"/>
                        </span>
                    </div>
                    <div class="col-md-2 col-sm-12 end_time_custom">
                        <button class="btn btn-primary end_btn_custom end_btn_custom_hide_1"
                                t-att-data-timesheet_id="exist_rec.id if exist_rec else ''"
                                t-att-data-task_id="task.id" t-att-data-task_type="task.project_id.project_type_id.name"
                                t-att-style="'' if (exist_rec and exist_rec.start_date and not exist_rec.end_date) else 'display: none;'">Sign Out
                        </button>
                        <span class="end_time_show"
                              t-att-style="'display: none;' if (not exist_rec or not exist_rec.end_date) else ''">
                            <t t-if="exist_rec and exist_rec.end_date" t-esc="account_analytic_rec_end_date.strftime('%Y-%m-%d %H:%M:%S')"/>
                        </span>
                        <button class="btn btn-primary end_btn_custom end_btn_custom_hide" t-att-data-task_type="task.project_id.project_type_id.name"
                                t-att-data-timesheet_id="exist_rec.id if exist_rec else ''" t-att-data-task_id="task.id" style="display: none;">Sign Out
                        </button>
                    </div>
                    <div class="col-md-6 col-sm-12 pt-3 pt-md-0">
                        <input class="form-control description_custom" type="text" name="Description"
                               placeholder="Work Description" t-attf-value="{{exist_rec.name if exist_rec else ''}}"/>
                    </div>
                    <div class="col-md-2 col-sm-12 pt-3 pt-md-0">
                        <input class="form-control duration_time_show text-center o_field_float o_field_number o_field_widget" name="duration" disabled='true' type="text"
                               placeholder="Hours Spent" style="font-size: 14px;" t-attf-value="{{account_analytic_rec_unit_amount if exist_rec and exist_rec.unit_amount else ''}}"/>
                    </div>
                </div>

                <div style="padding: 15px;" id="input_atlas_checklist"
                     t-attf-class="input_atlas_checklist {{'' if exist_rec and exist_rec.is_signature and task.project_id.project_type_id.name == 'Service' else 'd-none'}}"
                     t-if="task.project_id.project_type_id.name == 'Service'">
                    <div class="row pt-1">
                        <span>
                            <h3>Swimming Pool</h3>
                        </span>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row d-flex flex-row-reverse">
                                <div class="col-10 text-left flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Vacuum Pool</label>
                                </div>
                                <div class="col-2 pl-md-0">
                                    <input type="checkbox" name="Vacuum Pool" class="vacuum_pool"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row d-flex flex-row-reverse">
                                <div class="col-10 text-left flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Clean Skimmer/Overflow</label>
                                </div>
                                <div class="col-2 pl-md-0">
                                    <input type="checkbox" name="Clean Skimmer/Overflow" class="clean_skimmer_overflow"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row d-flex flex-row-reverse">
                                <div class="col-10 text-left flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Brush Pool</label>
                                </div>
                                <div class="col-2 pl-md-0">
                                    <input type="checkbox" name="Brush Pool" class="brush_pool"/>
                                </div>
                            </div>
                        </div>

                        <div class="col-12 col-md-6 pb-2">
                            <div class="row d-flex flex-row-reverse">
                                <div class="col-10 text-left flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Skim Pool</label>
                                </div>
                                <div class="col-2 pl-md-0">
                                    <input type="checkbox" name="Skim Pool" class="skim_pool"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row d-flex flex-row-reverse">
                                <div class="col-10 text-left flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Clean Deck Area</label>
                                </div>
                                <div class="col-2 pl-md-0">
                                    <input type="checkbox" name="Clean Deck Area" class="clean_desk_area"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row pt-1">
                        <span>
                            <h3>Machine Room</h3>
                        </span>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Filter Pressure Before Backwash</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="text" name="Filter Pressure Before Backwash" class="col-md-8 col-12 col-lg-8 back_wash_filter_before"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Filter Pressure After Backwash</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="text" name="Filter Pressure After Backwash" class="col-md-8 col-12 col-lg-8 back_wash_filter_after"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row d-flex flex-row-reverse">
                                <div class="col-10 text-left flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Clean Pump Strainer</label>
                                </div>
                                <div class="col-2 pl-md-0">
                                    <input type="checkbox" name="Clean Pump Strainer" class="clean_pump_strainer"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row d-flex flex-row-reverse">
                                <div class="col-10 text-left flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Clean Machine Room</label>
                                </div>
                                <div class="col-2 pl-md-0">
                                    <input type="checkbox" name="Clean Machine Room" class="clean_machine_room"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row d-flex flex-row-reverse">
                                <div class="col-10 text-left flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Clean Balance Tank</label>
                                </div>
                                <div class="col-2 pl-md-0">
                                    <input type="checkbox" name="Clean Balance Tank" class="clean_balance_tank"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row pt-1">
                        <span>
                            <h3>Water Chemistry</h3>
                        </span>
                    </div>
                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Water Temperature</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="Water Temperature" class="col-md-8 col-12 col-lg-8 water_temperature"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Total Alkalinity</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="Total Alkalinity" class="col-md-8 col-12 col-lg-8 total_alkalinity"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row mb-1">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Calcium Hardness</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="Calcium Hardness" class="col-md-8 col-12 col-lg-8 calcium_hardness"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Free Chlorine Level</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="Free Chlorine Level" class="col-md-8 col-12 col-lg-8 free_chlorin_level"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row mb-1">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">PH Level</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="PH Level" class="col-md-8 col-12 col-lg-8 ph_level"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Cyanuric Acid</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="Cyan-uric Acid" class="col-md-8 col-12 col-lg-8 cyanuric_Acid"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row mb-1">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Total Chlorine</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="Total Chlorine" class="col-md-8 col-12 col-lg-8 total_chlorine"/>
                                </div>
                            </div>
                        </div>
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">Salinity</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="Salinity" class="col-md-8 col-12 col-lg-8 salinity"/>
                                </div>
                            </div>
                        </div>
                    </div>

                    <div class="row">
                        <div class="col-12 col-md-6 pb-2">
                            <div class="row mb-1">
                                <div class="col-5 flex-grow-0 pr-3">
                                    <label class="form-check-label fw-normal">TDS</label>
                                </div>
                                <div class="col-7 pl-md-0">
                                    <input type="number" name="TDS" class="col-md-8 col-12 col-lg-8 tds"/>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
                <br/>

                <div class="row pt-1 pt-md-0" style="float: right;">
                    <div class="col-sm-12 submit_signature_checklist">
                        <t t-if="task.project_id.project_type_id.name == 'Service'">
                            <button t-attf-class="btn btn-primary btn-block mb8 mr-3 submit_signature_btn_custom_signature {{'' if exist_rec and exist_rec.end_date else 'd-none'}}"
                                    data-bs-toggle="modal" data-bs-target="#modalaccept" href="#">Signature
                            </button>
                        </t>
                        <t t-else="">
                            <button t-attf-class="btn btn-primary btn-block mb8 mr-3 submit_signature_btn_custom {{'' if exist_rec and exist_rec.end_date else 'd-none'}}"
                                    href="#">Submit
                            </button>
                        </t>
                    </div>
                </div>
            </div>

            <div role="dialog" class="modal fade timesheet_signature" id="modalaccept">
                <div class="modal-dialog">
                    <form id="accept" method="POST" t-att-data-order-id="task.id" t-att-data-token="task.access_token" class="modal-content">
                        <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                        <header class="modal-header">
                            <h4 class="modal-title">Signature</h4>
                            <button type="button" class="close" data-dismiss="modal" aria-label="Close">×</button>
                        </header>
                        <main class="modal-body" id="sign-dialog">
                            <t t-call="portal.signature_form">
                                <t t-set="default_name" t-value="task.partner_id.name"/>
                            </t>
                            <input type="number" name="timesheet_id" t-att-data-timesheet_id="exist_rec.id" style="display: none"/>
                            <button class="btn btn-primary submit_checklist_btn_custom float-right" t-att-data-task_id="task.id">Submit</button>
                        </main>
                    </form>
                </div>
            </div>
        </xpath>

        <xpath expr="//h5[@id='task_timesheets']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//div[@t-if='project_accessible']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//div[@t-else='']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//div[@t-if='task.milestone_id and task.allow_milestones']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//div[@name='portal_my_task_allocated_hours']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>
        <xpath expr="//div[@name='portal_my_task_second_column']" position="attributes">
            <attribute name="style">display: none;</attribute>
        </xpath>

    </template>

    <template id="portal_my_task_inherit_facility_volume" inherit_id="project_enterprise.portal_my_task">
        <xpath expr="//div[@t-elif='task.date_deadline']" position="replace"/>
        <xpath expr="//div[@t-if='task.planned_date_begin']" position="replace">
            <div class="col-12 col-md-12 mb-1">
                <div t-if="task.project_id">
                    <strong>Project :</strong>
                    <strong t-field="task.project_id.display_name" style="margin: 10px;"/>
                </div>
            </div>
            <div class="col-12 col-md-6 mb-1">
                <div t-if="task.date_start">
                    <strong>Start Date :</strong>
                    <span t-field="task.date_start" t-options='{"widget": "date"}' style="margin-left: 10px;"/>
                    <t t-if="task.task_end_date">
                        <i class="fa fa-long-arrow-right" style="margin: 10px;"/>
                        <span t-field="task.task_end_date" t-options='{"widget": "date"}'/>
                    </t>
                </div>
                <div t-elif="task.date_deadline" style="display: none;">
                    <strong>Deadline:</strong>
                    <span t-field="task.date_deadline" t-options='{"widget": "datetime"}'/>
                </div>
                <t t-set="facility_ids_sum" t-value="0.0"/>
                <t t-if="facility_ids_sum">
                    <div class="col pl-sm-0">
                        <strong>Facility Volume:</strong>
                        <span t-esc="facility_ids_sum"/>
                    </div>
                </t>
            </div>
        </xpath>

    </template>

</odoo>
