<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="portal_project_edit_form" model="ir.ui.view">
        <field name="name">project.project.form.v.customized</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project_sale.v_project_edit_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='employee_cost_lines']/list/field[@name='hours_spent']" position="replace">
                <field name="description"/>
                <field name="hours_spent" sum="Total Hours" widget="float_time"/>
            </xpath>

            <field name="employee_id" position="after">
                <field name="create_date" readonly="True"/>
            </field>

        </field>
    </record>

</odoo>
