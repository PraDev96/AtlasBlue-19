<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="sale_order_configure_package_inherit_hide_field" model="ir.ui.view">
        <field name="name">sale.order.configure.package.inherit.hide.field</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="product_package.view_order_form_inherit_configure_package"/>
        <field name="arch" type="xml">

            <field name="root_facility_ids" position="after">
                <separator string="Print Sale Report" style="margin-top: 40px; font-weight: bold;"/>
                <field name="is_hide_all_qty"/>
                <field name="is_hide_all_subtotal"/>
            </field>

        </field>
    </record>


    <record id="sale_order_form_inherit_hide_field" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.hide.field</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='order_line']" position='attributes'>
                <attribute name="context">{
                        "default_is_hide_qty": is_hide_all_qty,
                        "default_is_hide_subtotal": is_hide_all_subtotal
                    }
                </attribute>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field/tree/field[@name='sequence']" position="after">
                <field name="is_hide_row"/>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field/tree/field[@name='product_uom_qty']" position="before">
                <field name="is_hide_qty" string="Hide QTY"/>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[@name='order_lines']/field/tree/field[@name='price_subtotal']" position="before">
                <field name="is_hide_subtotal"/>
            </xpath>

        </field>
    </record>

    <record id="sale_order_option_form_inherit_hide_field" model="ir.ui.view">
        <field name="name">sale.order.option.form.inherit.hide.field</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale_management.sale_order_form_quote"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='sale_order_option_ids']" position='attributes'>
                <attribute name="context">{
                        "default_is_hide_qty": is_hide_all_qty,
                        "default_is_hide_subtotal": is_hide_all_subtotal
                    }
                </attribute>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[@name='optional_products']/field/tree/field[@name='sequence']" position="after">
                <field name="is_hide_row"/>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[@name='optional_products']/field/tree/field[@name='quantity']" position="before">
                <field name="is_hide_qty" string="Hide QTY"/>
            </xpath>

        </field>
    </record>

    <record id="sale_order_option_atlas_base_inherit_hide_field" model="ir.ui.view">
        <field name="name">sale.order.option.atlas.base.inherit.hide.field</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="atlas_base.view_order_form_inherit_altas_base"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/notebook/page[@name='optional_products']/field/tree/field[@name='price_subtotal']" position="before">
                <field name="is_hide_subtotal"/>
            </xpath>

        </field>
    </record>

</odoo>
