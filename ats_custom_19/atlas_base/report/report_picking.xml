<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_report_picking_inherit" inherit_id="stock.report_picking">
            <xpath expr="//div[@name='div_sched_date']" position="after">
                <div class="col-auto" name="div_number">
                    <strong>Project Code</strong><p t-field="o.project_id.number"/>
                </div>
            </xpath>
        </template>

        <template id="report_report_picking_inherit" inherit_id="stock.report_delivery_document">
            <xpath expr="//div[@name='div_sched_date']" position="after">
                <div class="col-auto" name="div_number">
                    <strong>Project Code</strong><p t-field="o.project_id.number"/>
                </div>
            </xpath>

            <xpath expr="//table[@name='stock_move_table']" position="replace">
                <table class="table table-sm" t-if="o.state!='done'" name="stock_move_table">
                    <thead>
                        <tr>
                            <th name="th_sm_product" class="text-left"><strong class="text-left">Product</strong></th>
                            <th class="text-end" name="th_sm_quantity"><strong>Quantity</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="lines" t-value="o.move_ids.filtered(lambda x: x.product_uom_qty)"/>
                        <tr t-foreach="lines" t-as="move">
                            <td>
                                <span t-field="move.product_id">Customizable Desk</span>
                                <p t-if="move.description_picking and move.description_picking != move.product_id.name and move.description_picking != move.product_id.display_name">
                                    <span t-field="move.description_picking">Description on transfer</span>
                                </p>
                            </td>

                            <td class="text-end">
                                <span t-field="move.product_uom_qty">3.00</span>
                                <span t-field="move.product_uom" groups="uom.group_uom">units</span>
                                <span t-if="move.product_packaging_id">
                                    (<span t-field="move.product_packaging_quantity" t-options='{"widget": "integer"}'/>
                                    <span t-field="move.product_packaging_id"/>)
                                </span>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </xpath>

            <xpath expr="//table[@name='stock_move_line_table']//thead" position="replace">
                <thead>
                    <tr>
                        <th name="th_sml_product" class="text-left"><strong class="text-left">Product</strong></th>
                        <th name="th_sml_quantity" class="text-end"><strong>Quantity</strong></th>
                    </tr>
                </thead>
            </xpath>

            <xpath expr="//div[@name='signature']" position="after">
                <br/>
                <h4>Note:</h4>
                <table style="width: 100%;" class="table table-borderless">
                    <tr>
                        <td class="text-justify" style="width: 48%;">
                            <span>
                                I the undersigned, acknowledge receipt (<b t-field="o.name"/>) of the goods are mentioned above, and I commit to safeguarding the received
                                goods and ensuring their protection against any damage or loss until the time of installation. I further acknowledge that the goods have been
                                received in good condition and without any reservations.
                            </span>
                        </td>
                        <td style="4%;">
                            <span>&amp;nbsp;</span>
                        </td>
                        <td class="text-justify" style="width: 48%;" dir="rtl">
                            <span dir="rtl">
                                تــــم إستــــلام البضاعـــة المذكــــورة أعـــلاه.
                                (<b t-field="o.name"/>)
                                كمـــا أتعھـــد بالحفـــاظ على البضاعـــة المستلمـــة وحمایتھـــا مـــن التلـــف أو
                                الضیـــاع
                                حتى موعـــد
                                التركیـــب. كمـــا أقـــر بـــأن البضاعـــة المستلمـــة بحالـــة جیـــدة وبـــدون أي تحفظـــات عنـــد الاستـــلام
                            </span>
                        </td>
                    </tr>
                    <tr>
                        <td class="text-justify" style="width: 48%;">
                            <br/>
                            <br/>
                            <span>Received By :-</span>
                            <br/>
                            <br/>
                            <span>Civil Id</span>
                            <br/>
                            <br/>
                            <span>Mobile No.</span>
                            <br/>
                            <br/>
                            <span>Signature</span>
                            <br/>
                            <br/>
                            <span>Date</span>
                        </td>
                        <td style="4%;">
                            <span>&amp;nbsp;</span>
                        </td>
                        <td class="text-end" style="width: 48%;">
                            <br/>
                            <br/>
                            <span class="text-end" dir="rtl">أســـم المستلـم</span>
                            <br/>
                            <br/>
                            <span class="text-end" dir="rtl">الرقـــم المدنـــي</span>
                            <br/>
                            <br/>
                            <span class="text-end" dir="rtl">رقــم الھاتـــف</span>
                            <br/>
                            <br/>
                            <span class="text-end" dir="rtl">توقیـــع المستلـــم</span>
                            <br/>
                            <br/>
                            <span class="text-end" dir="rtl">تاریــخ الاستـــلام</span>
                        </td>
                    </tr>
                </table>
            </xpath>

        </template>

        <template id="stock.stock_report_delivery_has_serial_move_line">
            <td>
                <span t-field="move_line.product_id"/>
                <!-- this is an annoying workaround for the multiple types of descriptions (often auto-filled) that we do not want to print -->
                <!-- this makes it so we can pre-filter the descriptions in inherited templates since we cannot extend the standard "if" condition -->
                <!-- let's agree that pre-filtered descriptions will be set to "" -->
                <t t-if="not description and description != ''">
                    <t t-set="description" t-value="move_line.move_id.description_picking"/>
                </t>
                <p t-if="description != '' and description != move_line.product_id.display_name and description != move_line.product_id.name">
                    <span t-esc="description"/>
                </p>
            </td>
            <td class="text-center" name="move_line_lot_quantity">
                <span t-field="move_line.quantity"/>
                <span t-field="move_line.product_uom_id"/>
                <span t-if="move_line.move_id.product_packaging_id" groups="product.group_stock_packaging">
                    (
                    <span t-field="move_line.product_packaging_qty" t-options='{"widget": "integer"}'/>
                    <span t-field="move_line.move_id.product_packaging_id.display_name"/>)
                </span>
            </td>
        </template>

        <template id="stock.stock_report_delivery_aggregated_move_lines">
            <tr t-foreach="aggregated_lines" t-as="line">
                <td>
                    <span t-esc="aggregated_lines[line]['name']"/>
                    <p t-if="aggregated_lines[line]['description']">
                        <span t-esc="aggregated_lines[line]['description']" t-options="{'widget': 'text'}"/>
                    </p>
                </td>
                <td class="text-center" name="move_line_aggregated_qty_ordered">
                    <span t-esc="aggregated_lines[line]['qty_ordered']"
                          t-options="{'widget': 'float', 'decimal_precision': 'Product Unit of Measure'}"/>
                    <span t-esc="aggregated_lines[line]['product_uom'].name"/>
                    <span t-if="aggregated_lines[line]['packaging'].name">
                        (
                        <span t-out="aggregated_lines[line]['packaging_qty']" t-options='{"widget": "integer"}'/>
                        <span t-out="aggregated_lines[line]['packaging'].name"/>)
                    </span>
                </td>
            </tr>
        </template>

    </data>
</odoo>
