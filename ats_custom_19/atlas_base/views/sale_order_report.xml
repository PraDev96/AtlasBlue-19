<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="empty_layout">
        <t t-if="not o and doc">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
        </t>
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id.sudo()"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>

        <div class="header">
            <div class="row">
                <div class="col-8"/>
                <div class="col-4">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 250px; max-width: 220px;" alt="Logo"/>
                </div>
            </div>
        </div>

        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>

        <div class="footer">
            <div class="row">
                <div class="col-4"/>
                <div class="col-4" style="color:Blue;font-size: 12px">
                    <center>
                        <span t-field="o.company_id.name"/>
                        <span t-field="o.company_id.country_id"/>
                        <br/>
                        Phone:
                        <span t-field="o.company_id.phone"/>
                        E-Mail:
                        <span t-field="o.company_id.email"/>
                        <span t-field="o.company_id.website"/>
                        <br/>
                        <span t-field="o.company_id.street"/>,
                        <span t-field="o.company_id.street2"/>,
                        <span t-field="o.company_id.city"/>
                    </center>
                </div>
                <div class="col-4"/>
            </div>

        </div>
    </template>

    <template id="report_sale_order_document_inherit">
        <t t-call="atlas_base.empty_layout">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>
            <h1><span t-field="o.partner_id"/></h1>

            <div class="page">
                <div class="row">
                    <div class="col-5" style="color:red;font-size:14px">
                        <span t-if="o.name" t-field="o.name">,</span>
                        <br/>
                        <span t-if="o.partner_id.name" t-field="o.partner_id.name">,</span>
                        <br/>
                        <span t-if="o.partner_id.street" t-field="o.partner_id.street">,</span>
                        <br/>
                        <strong>Telephone</strong>
                        <span t-esc="o.partner_id.mobile or o.partner_id.phone"/>
                        <br/>
                    </div>
                    <div class="col-3"/>
                    <div class="col-4 text-right" style="color:red;font-size:14px">
                        <span t-if="o.name" t-field="o.name">,</span>
                        <br/>
                        <span t-if="o.partner_id.name" t-field="o.partner_id.name">,</span>
                        <br/>
                        <span t-if="o.partner_id.street" t-field="o.partner_id.street">,</span>
                        <br/>
                        <div class="row">
                            <div class="col-9">
                                <span class="pull-right" t-esc="o.partner_id.mobile or o.partner_id.phone"/>
                            </div>
                            <div class="col-3 text-right">
                                <strong>
                                    هاتف:
                                </strong>
                            </div>
                        </div>
                    </div>
                </div>

                <h2><center>Quotation</center></h2>
                <br/>
                <div class="row" style="font-size:18px">
                    <div class="col-6"><h5>Pool Service Quotation</h5></div>
                    <div class="col-6">
                        <h5 class="text-right">
                            عرض سعر صيانة حوض السباحة
                        </h5>
                    </div>
                </div>
                <br/>

                <table class="align-text-top text-justify">
                    <tr>
                        <td class="text-left" width="20px"></td>
                        <td width="43%">
                            <strong style="padding-right: 15px">On</strong>
                            <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                            the quotation prepared this service contract for servicing a
                            <span t-field="o.axis"/>
                            Cubic meters Swimming Pool located
                            <t t-if="o.partner_shipping_id.area_id">in
                                <span t-field="o.partner_shipping_id.area_id"/>
                            </t>
                            at
                            <span t-field="o.partner_shipping_id.street"/>
                            with cleaning, chemicals and water test, for the
                            duration of 12 months at the frequency of
                            <span t-field="o.frequency_time"/>
                            times a week.
                        </td>

                        <td width="20px"></td>
                        <td width="43%" class="text-right">
                            <strong style="padding-right: 15px">بتاريخ</strong>
                            <span t-field="o.date_order" t-options="{'widget': 'date'}"/>
                            تمت كتابة هذا عرض السعر لخدمة
                            السباحه والذي حجمه
                            <span t-field="o.axis"/>
                            متر ³ والواقع فى
                            <t t-if="o.partner_shipping_id.area_id">
                                <span t-field="o.partner_shipping_id.area_id"/>
                            </t>
                            <t t-if="o.partner_shipping_id.street">-
                                <span t-field="o.partner_shipping_id.street"/>
                            </t>
                            عن طريق تنظيف الحوض و فحص الماء واضافة الكيماويات اللازمه ، وذلك لمدة 12أشهر وبتردد
                            <span t-field="o.frequency_time"/>
                            مرة بالأسبوع
                        </td>
                        <td class="text-right" width="20px"></td>
                    </tr>
                </table>
                <br/>

                <div class="row" style="font-size:18px">
                    <div class="col-6"><h5>DETAILS AND CONDITIONS</h5></div>
                    <div class="col-6 text-right">
                        <h5>
                            التفاصيل والشروط
                        </h5>
                    </div>
                </div>
                <br/>

                <table class="align-text-top text-justify w-100">
                    <tr>
                        <td class="text-left">1</td>
                        <td width="43%">Vacuum the swimming pool, remove leaves from skimmer baskets/gutters and pump strainer.</td>
                        <td width="20px"></td>
                        <td class="text-right" width="43%">
                            تنظيف حوض السباحة وتنظيف سلة السكيمر\حافة المجرى المحيط وسلة المضخة من الشوائب .
                        </td>
                        <td class="text-right" width="20px">.1</td>
                    </tr>
                    <tr>
                        <td class="text-left" width="20px">2.</td>
                        <td>Cleaning 50cm width around the deck ground.</td>
                        <td width="20px"></td>
                        <td class="text-right">
                            تنظيف مساحة 50سم حول الحوض من الخارج.
                        </td>
                        <td class="text-right" width="15px">.2</td>
                    </tr>
                    <tr>
                        <td class="align-text-top text-left" width="20px">3.</td>
                        <td class="text-justify">Backwash filter whenever the pressure difference between clean and dirty exceeds 10PSI.</td>
                        <td width="20px"></td>
                        <td class="text-right">
                            تنظيف الفلتر العكسي عندما يرتفع ضغط الفلتر بمقدار 10 رطل للبوصة المربعة .
                        </td>

                        <td class="text-right" width="20px">.3</td>
                    </tr>
                    <tr>
                        <td class="text-left" width="20px">4.</td>
                        <td>
                            Service is carried out
                            <span t-field="o.frequency_time"/>
                            times a week regardless of
                            public or annual holidays (excluding Fridays) during the
                            term of this contract for a maximum period of 1 (One)
                            hour at any time between 06:00 am. And 06:00 pm. The
                            owner should guarantee ease of access to the pool without
                            delay. Should the contractor for whatever reason not be
                            able to gain access to the pool to perform his duty,
                            a message will be left clearly stating date and time our service personnel attempted to perform their duty.
                            In the event of such occurrence, the contractor will consider the service completed without any liability on the part of the contractor
                        </td>
                        <td width="20px"></td>
                        <td class="text-right">
                            تقدم الخدمه<span t-field="o.frequency_time"/>مرة بالأسبوع و ذلك يشمل ايام
                            العطل الرسميه و السنويه، ما عدا ايام الجمعه،
                            طوال فترة العقد ولمدة اقصاها ساعه واحده، في
                            وقت ما بين الساعه السادسه صباحا والسادسه
                            مساءً، وعلى المالك تسهيل دخول الفنيين والعمال
                            في الوقت المحدد فسوف تحسب هذه الزيارة من الجدول المقرر لصيانة الحوض وسوف يقوم فريق العمل بترك رساله للمالك فيها وقت الزياره والتفاصيل
                        </td>
                        <td class="text-right" width="20px">.4</td>
                    </tr>
                    <tr>
                        <td class="text-left" width="20px">5.</td>
                        <td>
                            Chemicals and sanitizers will be added at the cost of the Atlas Blue to ensure that the swimming pool water is clean and disinfected for bathers. A
                            record is kept on the location for the Owner's review showing the level of chlorine, pH, Total Alkalinity, Calcium Hardness, and other useful data.
                            The owner will carry out all instructions and recommendations of the contractor for the safety of all concerned. In the event that any instructions
                            recommendations given by the contractor are not followed, Atlas Blue cannot accept any liability for noncompliance
                        </td>
                        <td width="20px"></td>
                        <td class="text-right">
                            العرض يشمل الكيماويات "على حساب شركة اطلس الازرق" وسيقوم شركة اطلس الازرق بعمل الفحوصات اللازمه للتأكد من صلاحية الماء وعمل تقرير عن حالة الحوض في
                            كل زيارة وتسليمه لمعرفة نسبة الكلور والبي أتش ونسبة أملاح الكالسيوم والصوديوم في الماء ومعلومات أخري وعلى المالك اتباع التعليمات وارشادات السلامه
                            من قبلنا وفي حال لم يتبع التعليمات فإن شركة اطلس الازرق غير مسؤول عما سينتج عدم اتباعها.

                        </td>
                        <td class="text-right" width="20px">.5</td>
                    </tr>
                    <tr>
                        <td class="text-left" width="20px">6.</td>
                        <td>
                            Atlas Blue service team will report evident malfunctioning, regarding lights, visible leaks, irregular noise from pool equipment, leaks from pool
                            equipment or concrete leak, machine room flooded.
                        </td>
                        <td width="20px"></td>
                        <td class="text-right">
                            سيقوم طاقم خدمة شركة اطلس الازرق بالابلاغ عن وجود اعطال ظاهرة مثل الاضاءة او وجود اية تسرب للمياه من الحوض او المعدات الخاصة بالحوض او سماع اية
                            اصوات غير اعتيادية لمعدات حوض السباحة او عن وجود اي فيضان في غرفة المعدات.
                        </td>
                        <td class="text-right" width="20px">.6</td>
                    </tr>
                    <tr>
                        <td class="text-left" width="20px">7.</td>
                        <td>
                            First day Service due on:<span t-field="o.first_serv_due"/>, last service due on
                            <span t-field="o.last_serv_due"/>
                            will be automatically renewed after this date.
                        </td>
                        <td width="20px"></td>
                        <td class="text-right">
                            اول يوم للخدمه<span t-field="o.first_serv_due"/>،آخر يوم للخدمه
                            <span t-field="o.last_serv_due"/>ستجدد تلقائيا بعد هذا التاريخ.
                        </td>
                        <td class="text-right" width="20px">.7</td>
                    </tr>
                    <tr>
                        <td class="text-left" width="20px">8.</td>
                        <td>The contract will be self-renewal, and can be cancelled by either party (owner/Atlas Blue) within minimum 2 week notice.</td>
                        <td width="20px"></td>
                        <td class="text-right">
                            العقد يجدد تلقائياً، وبامكان كل من المالك او شركة اطلس الازرق الغاء العقد، وذلك عن طريق كتاب يرسل الى الطرف الآخر خلال مدة ادناها اسبوعين من تاريخ
                            انتهاء الخدمه.
                        </td>
                        <td class="text-right" width="20px">.8</td>
                    </tr>
                    <tr>
                        <td class="text-left" width="20px">9.</td>
                        <td>The owner will provide at his expense all cleaning equipment i.e. Vacuum head, vacuum hose, Net, Telescopic pole, Brush, etc.</td>
                        <td width="20px"></td>
                        <td class="text-right">
                            على المالك توفير معدات التنظيف التي تشمل رأس المكنسه والهوز والبروش والشبك والعامود التلسكوبي.
                        </td>
                        <td class="text-right" width="20px">.9</td>
                    </tr>
                </table>
                <br/>

                <div class="row" style="font-size:15px">
                    <div class="col-6" style="font-size:18px"><h5>DISCLAIMERS</h5></div>
                    <div class="col-6 text-right" style="font-size:18px"><h5>عدم المسؤولية</h5></div>
                </div>
                <br/>

                <table class="align-text-top text-justify">
                    <tr>
                        <td class="text-left" width="20px">1.</td>
                        <td>
                            Atlas Blue will not be liable under any circumstances for damages, repair and maintenance of pump, filter leakage, heater, electrical and
                            mechanical installation, civil works, etc. or any other that are not included and clearly shown in this contract.
                        </td>
                        <td width="20px"></td>
                        <td class="text-right">
                            شركة اطلس الازرق لا تتحمل المسؤوليه تحت اي من الظروف لأي أعطال أو أعمال الصيانة الميكانيكية والكهربائية والمدنية مثل تهريب الفلتر للماء وصيانة
                            المضخة والسخان والأضاءة وغيرها مما لم يسبق ذكره في هذا عرض السعر.
                        </td>
                        <td class="text-right" width="20px">.1</td>
                    </tr>
                    <tr>
                        <td class="text-left" width="20px">2.</td>
                        <td>
                            The service staff is not authorized to perform water filling tasks, or to adjust the level of water in the pool, Atlas Blue is not liable for any
                            pool filling or possible flooding consequences.
                        </td>
                        <td width="20px"></td>
                        <td class="text-right">
                            لا يسمح لطاقم الخدمة بتعبئة حوض السباحه او زيادة مستوى الماء فيه، والمقاول غير مسؤول عن تعبئة الماء او ما يمكن ان ينتج عنه من فيضان او اضرار.
                        </td>
                        <td class="text-right" width="20px">.2</td>
                    </tr>
                </table>
                <br/>

                <div class="row" style="font-size:15px;page-break-before: always">
                    <div class="col-6" style="font-size:18px"><h5>Total And Payment Terms</h5></div>
                    <div class="col-6  text-right" style="font-size:18px"><h5>السعر وطريقة الدفع.</h5></div>
                </div>
                <br/>

                <table class="align-text-top text-justify">
                    <tr>
                        <td class="text-left" width="20px"></td>
                        <td>The payment is in advance; accepted through cash/cheque, renewals must be paid 1 week before the last service day of the previous contract.</td>
                        <td width="20px"></td>
                        <td class="text-right">
                            الدفع مسبق، ويقبل اما نقدا او عن طريق شيك وذلك لأجمالي قيمة العقد.
                            تدفع التجديدات قبل اسبوع من آخر يوم للخدمه في العقد القديم
                        </td>
                        <td class="text-right" width="20px">.3</td>
                    </tr>
                </table>
                <br/>

                <div class="row" style="font-size:15px;">
                    <div class="col-5">
                        <strong>*Total Payment:</strong>
                        <br/>
                        <strong>
                            <span t-field="o.currency_id"/>
                            <span style="color:red" t-field="o.amount_total" t-options="{'widget': 'float', 'precision': 3}"/>
                        </strong>
                    </div>
                    <div class="col-2"/>
                    <div class="col-5 text-right">
                        <strong>: *السعر للخدمة</strong>
                        <br/>
                        <strong>
                            <span t-field="o.currency_id"/>
                            <span style="color:red" t-field="o.amount_total" t-options="{'widget': 'float', 'precision': 3}"/>
                        </strong>
                    </div>
                </div>
                <br/>

                <div class="row" style="font-size:15px">
                    <div class="col-5"/>
                    <div class="col-3"/>
                    <div class="col-4">
                        <strong>
                            <u>For Client</u>
                            <br/>
                        </strong>
                        <strong>
                            <u>خاص بالعميل</u>
                        </strong>
                        <br/>
                        <strong>Date:
                            <br/>
                        </strong>
                        <strong>التاريخ__________________________</strong>
                        <br/>
                        <strong>Name :
                            <br/>
                        </strong>
                        <strong>الأسم__________________________</strong>
                        <br/>
                    </div>
                </div>
                <br/>

                <div class="row" style="font-size:15px">
                    <div class="col-5">
                        <strong>Atlas Blue Operation Manager
                            <br/>
                            مدير العمليات في اطلس الأزرق
                        </strong>
                    </div>
                    <div class="col-3"/>
                    <div class="col-4">
                        <strong>Signature:
                            <br/>
                        </strong>
                        <strong>التوقيع__________________________</strong>
                        <br/>
                    </div>
                </div>
                <br/>

            </div>
        </t>
    </template>

    <template id="report_sale_order_inherit">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="atlas_base.report_sale_order_document_inherit" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="paperformat_sale_order" model="report.paperformat">
        <field name="name">A4 -Sale Quotation</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">30</field>
        <field name="margin_bottom">30</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">23</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_sale_order_inherit" model="ir.actions.report">
        <field name="name">Quote Contract</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">atlas_base.report_sale_order_inherit</field>
        <field name="report_file">atlas_base.report_sale_order_inherit</field>
        <field name="print_report_name">'Quote Contract - %s' % (object.name)</field>
        <field name="binding_model_id" ref="model_sale_order"/>
        <field name="paperformat_id" ref="atlas_base.paperformat_sale_order"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
