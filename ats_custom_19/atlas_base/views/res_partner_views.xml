<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_partner_property_altas_base" model="ir.ui.view">
        <field name="name">res.partner.form.inherit.altas.base</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <div name="button_box" position="inside">
                <button class="oe_stat_button" name="%(atlas_base.open_view_project_all)d" context="{'search_default_partner_id': id, 'default_partner_id': id}"
                        type="action" icon="fa-tag">
                    <field name="project_count" widget="statinfo" string="Projects"/>
                </button>
            </div>

            <span class="o_form_label o_td_label" position="before">
                <field name="nick_name"/>
            </span>

            <field name="mobile" position="attributes">
                <attribute name="widget"></attribute>
            </field>

            <field name="phone" position="attributes">
                <attribute name="widget"></attribute>
            </field>

            <xpath expr="//field[@name='user_ids']" position="after">
                <field name="home_phone" widget="phone"/>
                <field name="fax" widget="phone"/>
            </xpath>

            <xpath expr="//field[@name='vat']" position="after">
                <field name="passport_no" string="Passport No"/>
            </xpath>

            <xpath expr="//field[@name='category_id']" position="after">
                <field name="rating"/>
                <field name="client_type" required="1"/>
                <field name="client_type_id" invisible="client_type == 'residential'"/>
                <field name="is_active"/>
            </xpath>

            <xpath expr="//field[@name='passport_no']" position="after">
                <field name="description_text"/>
            </xpath>

            <notebook position="inside">
                <page string="Facility">
                    <field name="facility_ids">
                        <list string="Facility">
                            <field name="name" optional="show"/>
                            <field name="location_id" domain="['|',('parent_id', '=', parent.id), ('id','=',parent.id)]"/>
                            <field name="facility_type" optional="show"/>
                            <field name="sale_order_id" optional="show"/>
                            <field name="system_type" optional="show"/>
                            <field name="water_surface" optional="show"/>
                            <field name="volume" optional="hide"/>
                            <field name="facility_project_id" optional="hide"/>
                            <field name="crm_lead_id" optional="hide"/>
                            <field name="facility_id" optional="hide"/>
                            <field name="facility_type_id" optional="hide"/>
                        </list>
                        <form string="Facility">
                            <group>
                                <field name="name"/>
                                <field name="partner_id" invisible="1"/>
                                <field name="facility_id" string="Facility config"/>
                                <field name="facility_type_id"/>
                                <field name="location_id" domain="['|',('parent_id', '=', parent.id),('id','=',parent.id)]"/>
                                <field name="facility_type" invisible="1"/>
                                <field name="facility_project_id" domain="[('partner_id', 'child_of', parent.id)]"/>
                                <field name="system_type"/>
                                <field name="water_surface"/>
                                <field name="volume"/>
                            </group>
                        </form>
                    </field>
                </page>

                <page string="Equipments">
                    <field name="equipment_ids">
                        <list string="Equipments" editable="bottom">
                            <field name="sr_number" optional="hide"/>
                            <field name="product_id"/>
                            <field name="name" readonly="1"/>
                            <field name="description" optional="show"/>
                            <field name="partner_id" optional="show" domain="[('id', 'child_of', parent.id)]"/>
                            <field name="facility_id" optional="show" domain="[('partner_id', 'child_of', parent.id)]"/>
                            <field name="source" optional="hide"/>
                            <field name="installation_date" optional="show"/>
                            <field name="warranty_start_date" optional="show"/>
                            <field name="warranty_end_date" optional="show"/>
                            <field name="contract_number" optional="show"/>
                            <field name="issue_number" optional="show"/>
                            <field name="status" optional="show"/>
                            <field name="phase" optional="hide"/>
                            <field name="electrical_load" optional="hide"/>
                            <field name="quant_done" optional="hide"/>
                        </list>
                    </field>
                </page>

                <page string="Installed Equipment" invisible="1">
                    <field name="stock_move_ids" readonly="1">
                        <list>
                            <field name="date" groups="base.group_no_one" decoration-danger="(state not in ('cancel','done')) and date &gt; current_date"/>
                            <field name="reference"/>
                            <field name="picking_type_id" invisible="1"/>
                            <field name="create_date" invisible="1" groups="base.group_no_one"/>
                            <field name="product_id"/>
                            <field name="location_id" options="{'no_create': True}" string="From"/>
                            <field name="product_uom_qty"/>
                            <field name="product_uom" options="{'no_open': True, 'no_create': True}" string="Unit of Measure" groups="uom.group_uom"/>
                            <field name="state" widget="badge" decoration-success="state == 'done'" decoration-info="state not in ('done', 'cancel')"/>
                        </list>
                    </field>
                </page>
            </notebook>

            <xpath expr="//field[@name='child_ids']//form//field[@name='country_id']" position="after">
                <group colspan="2" col="2">
                    <separator string="Geolocation" colspan="2"/>
                    <button string="Geolocate" name="geo_localize" colspan="2" icon="fa-check" type="object"/>
                    <div>
                        <span class="oe_inline">( On</span>
                        <field name="date_localization" nolabel="1" class="oe_inline"/>
                        <span>: Lat :</span>
                        <field name="partner_latitude" nolabel="1" class="oe_inline"/>
                        <span>; Long:</span>
                        <field name="partner_longitude" nolabel="1" class="oe_inline"/>
                        <span>)</span>
                    </div>
                </group>
            </xpath>

        </field>
    </record>

    <record id="res_partner_view_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.view.form.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//form/sheet/notebook/page[@name='contact_addresses']/field/kanban" position="inside">
                <field name="customer_rank" invisible="1"/>
                <field name="city" required="type == 'delivery' or customer_rank &gt; 0"/>
                <field name="governorate_id" required="type == 'delivery' or customer_rank &gt; 0"/>
            </xpath>

            <xpath expr="//form/sheet/notebook/page[@name='contact_addresses']/field/form/sheet/group/group[2]/field[@name='mobile']" position="after">
                <field name="customer_rank" invisible="1"/>
                <field name="city" required="type == 'delivery' or customer_rank &gt; 0"/>
                <field name="governorate_id" required="type == 'delivery' or customer_rank &gt; 0"/>
            </xpath>

        </field>
    </record>

    <record id="res_partner_view_search" model="ir.ui.view">
        <field name="name">res.partner.search.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_res_partner_filter"/>
        <field name="arch" type="xml">

            <field name="name" position="after">
                <field string="Arabic Name" name="ar_name" filter_domain="[('ar_name', 'ilike', self)]"/>
            </field>

        </field>
    </record>

    <record id="account_move_form_inherit2" model="ir.ui.view">
        <field name="name">account.move.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="project_sale.account_move_project_field"/>
        <field name="arch" type="xml">

            <field name="project_id" position="after">
                <field name="project_opportunity_type"/>
            </field>

        </field>
    </record>

    <record model="ir.ui.view" id="view_account_move_searchds">
        <field name="name">account.move.search</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='draft']" position="after">
                <separator/>
                <filter name="project_opportunity_type" domain="[('project_opportunity_type', '!=',False)]"
                        string="Opportunity Type" context="{'group_by': 'project_opportunity_type'}"/>
                <separator/>
            </xpath>

        </field>
    </record>

    <record id="res_company_form_inherit1" model="ir.ui.view">
        <field name="name">res.company.inherit</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='website']" position="after">
                <field name="reg_no"/>
            </xpath>

            <xpath expr="//field[@name='phone']" position="after">
                <field name="fax"/>
            </xpath>

        </field>
    </record>

</odoo>
