<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="empty_layout_purchase">
        <t t-if="not o and doc">
            <t t-set="o" t-value="o.with_context({'lang':o.partner_id.lang})"/>
        </t>
        <t t-if="o and 'company_id' in o">
            <t t-set="company" t-value="o.company_id.sudo()"/>
        </t>
        <t t-if="not o or not 'company_id' in o">
            <t t-set="company" t-value="res_company"/>
        </t>

        <div class="header">
            <div class="row">
                <div class="col-8"/>
                <div class="col-4">
                    <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 250px; max-width: 220px;" alt="Logo"/>
                </div>
            </div>
        </div>

        <div class="article o_report_layout_standard" t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-raw="0"/>
        </div>

        <div class="footer">
            <div class="row">
                <div class="col-2"/>
                <div class="col-8" style="color:Blue;font-size: 12px">
                    <center>
                        <span t-field="o.company_id.name"/>
                        <br/>
                        Phone:<span t-field="o.company_id.phone"/>
                        E-MAIL:<span t-field="o.company_id.email"/>
                        <br/>
                        <span t-field="o.company_id.street"/>,
                        <span t-field="o.company_id.street2"/>,
                        <span t-field="o.company_id.city"/>
                        <br/>
                        <span t-field="o.company_id.website"/>
                    </center>
                </div>
                <div class="col-2"/>
            </div>
        </div>

    </template>

    <template id="report_purchaseorder_document_inheritt" inherit_id="purchase.report_purchaseorder_document">
        <xpath expr="//table" position="replace">

            <table class="table table-sm o_main_table">
                <thead>
                    <tr>
                        <th name="th_description"><strong>Description</strong></th>
                        <th name="th_taxes"><strong>Taxes</strong></th>
                        <th name="th_date_req" class="text-center"><strong>Date Req.</strong></th>
                        <th name="th_quantity" class="text-right"><strong>Qty</strong></th>
                        <th name="th_price_unit" class="text-right"><strong>Unit Price</strong></th>
                        <th name="th_amount" class="text-right"><strong>Amount</strong></th>
                    </tr>
                </thead>

                <tbody>
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="o.order_line" t-as="line">
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>

                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                            <t t-if="not line.display_type">
                                <td id="product"><span t-field="line.name"/></td>
                                <td name="td_taxes"><span t-esc="', '.join(map(lambda x: x.name, line.taxes_id))"/></td>
                                <td class="text-center"><span t-field="line.date_planned" t-options="{'widget': 'date'}"/></td>
                                <td class="text-right">
                                    <span t-field="line.product_qty"/>
                                    <span t-field="line.product_uom.name" groups="uom.group_uom"/>
                                </td>
                                <td class="text-right"><span t-field="line.price_unit"/></td>
                                <td class="text-right">
                                    <span t-field="line.price_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </t>
                            <t t-if="line.display_type == 'line_section'">
                                <td colspan="99" id="section"><span t-field="line.name"/></td>
                                <t t-set="current_section" t-value="line"/>
                                <t t-set="current_subtotal" t-value="0"/>
                            </t>
                            <t t-if="line.display_type == 'line_note'">
                                <td colspan="99" id="note"><span t-field="line.name"/></td>
                            </t>
                        </tr>
                        <t t-if="current_section and (line_last or o.order_line[line_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-right">
                                <td colspan="99" id="subtotal">
                                    <strong class="mr16">Subtotal</strong>
                                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: o.currency_id}"/>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

        </xpath>
    </template>

    <template id="report_purchaseorder_document_inherit">
        <t t-call="atlas_base.empty_layout_purchase">
            <t t-set="o" t-value="o.with_context(lang=o.partner_id.lang)"/>

            <page>
                <div class="row">
                    <div class="col-8"/>
                    <div class="col-3 mt-10">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 230px; max-width: 200px;" alt="Logo"/>
                    </div>
                    <div class="col-1"/>
                </div>

                <div class="row">
                    <div class="col-2 mt-10">
                        <img t-if="o.company_id.logo" t-att-src="image_data_uri(o.company_id.logo)" style="max-height: 250px; max-width: 220px;" alt="Logo"/>
                    </div>
                    <div class="col-6"/>
                    <div class="col-4">
                        <br/>
                        <br/>
                        <h4><strong style="color:#0180c0">PURCHASE ORDER</strong></h4>
                        <div class="row">
                            <div class="col-3">
                                <strong>P.O. #</strong>
                            </div>
                            <div class="col-5">
                                <span style="color:black" t-field="o.name"/>
                            </div>
                        </div>
                        <div class="row">
                            <div class="col-3">
                                <strong>Date</strong>
                            </div>
                            <div class="col-5">
                                <span style="color:black" t-field="o.date_planned" t-options="{'widget': 'date'}"/>
                            </div>
                        </div>
                    </div>
                </div>

                <div class="row">
                    <div class="col-4">
                        <h5>
                            <strong t-field="o.company_id.name"/>
                            <br/>
                        </h5>
                        <span t-field="o.company_id.street"/>,
                        <span t-field="o.company_id.street2"/>,
                        <span t-field="o.company_id.city"/>,
                        <span t-field="o.company_id.zip"/>,
                        <br/>
                        P.
                        <span t-field="o.company_id.phone"/>
                    </div>
                    <div class="col-8"/>
                </div>
                <br/>

                <div class="row">
                    <div class="col-2">
                        <div style="background-color:#0180c0;color:white">Vendor:</div>
                    </div>
                    <div class="col-4">
                        <div t-field="o.partner_id"
                             t-options="{&quot;widget&quot;: &quot;contact&quot;, &quot;fields&quot;: [&quot;address&quot;, &quot;name&quot;, &quot;phone&quot;], &quot;no_marker&quot;: True, &quot;phone_icons&quot;: True}"/>
                        <p t-if="o.partner_id.vat"><t t-esc="o.company_id.country_id.vat_label or 'Tax ID'"/>:
                            <span t-field="o.partner_id.vat"/>
                        </p>
                    </div>
                    <div class="col-2">
                        <div style="background-color:#0180c0;color:white">Ship To:</div>,
                    </div>
                    <div class="col-4">
                        <div>
                            <span t-field="o.company_id.street"/>,
                            <span t-field="o.company_id.street2"/>,
                            <br/>
                            <span t-field="o.company_id.phone"/>,
                            <br/>
                            <span t-field="o.company_id.email"/>
                        </div>
                    </div>
                </div>
                <br/>

                <table class="table table-sm border-black o_main_table">
                    <thead style="background-color:#0180c0;color:white">
                        <tr>
                            <th><strong>Line</strong></th>
                            <th class="text-right"><strong>Qty</strong></th>
                            <th><strong>Photo</strong></th>
                            <th><strong>Internal Ref #</strong></th>
                            <th><strong>Vendor Part #</strong></th>
                            <th><strong>Description</strong></th>
                            <th class="text-right"><strong>Unit Price</strong></th>
                            <th class="text-right"><strong>Discount(%)</strong></th>
                            <th class="text-right"><strong>Total Cost</strong></th>
                        </tr>
                    </thead>
                    <tbody>
                        <t t-set="current_subtotal" t-value="0"/>
                        <t t-set="subtotal" t-value="0"/>
                        <t t-set="grand_total" t-value="0"/>
                        <t t-foreach="o.order_line" t-as="line">
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                            <t t-set="current_subtotal" t-value="current_subtotal + line.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                            <tr t-att-class="'bg-200 font-weight-bold o_line_section' if line.display_type == 'line_section' else 'font-italic o_line_note' if line.display_type == 'line_note' else ''">
                                <t t-if="not line.display_type">
                                    <td><t t-esc="line_index + 1"/></td>
                                    <td id="product"><span t-field="line.product_qty"/></td>
                                    <td>
                                        <span t-field="line.product_id.image_128"
                                              t-options="{'widget': 'image', 'qweb_img_responsive': False, 'class': 'rounded o_image_64_max mb-2'}"/>
                                    </td>
                                    <td><span t-field="line.product_id.supplie_id"/></td>
                                    <td><span t-field="line.name"/></td>
                                    <td><span t-field="line.product_id.default_code"/></td>
                                    <td class="text-right"><span t-field="line.price_unit"/></td>
                                    <td class="text-right"><span t-field="line.discount"/></td>
                                    <td class="text-right"><span t-field="line.price_subtotal"/></td>
                                    <t t-set="subtotal" t-value="line.price_unit * line.product_qty"/>
                                    <t t-set="grand_total" t-value="subtotal + grand_total"/>
                                </t>
                            </tr>
                        </t>
                        <tr style="border-bottom: 1px solid #2e74b5">
                            <td class="text-center" colspan="6" style="border: 2px solid #2e74b5;"><strong class="mr16">Total</strong></td>
                            <td class="text-right" colspan="4" style="border: 2px solid #2e74b5;">
                                <strong class="mr16">
                                    <span t-field="o.currency_id"/>
                                    <span t-field="o.amount_total" t-options="{'widget': 'float', 'precision': 3}"/>
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br/>

                <div class="row">
                    <div class="col-4">
                        <div style="background-color:#0180c0;color:white">Comments or Special Instructions:</div>
                    </div>
                    <div class="col-6"/>
                </div>
                <br/>
                <br/>
                <br/>

                <strong>
                    If you have any questions about this purchase order, please contact
                    <br/>
                    <span t-field="o.company_id.street"/>,
                    <span t-field="o.company_id.street2"/>,
                    <br/>
                    <span t-field="o.company_id.phone"/>,
                    <br/>
                    <span t-field="o.company_id.email"/>
                </strong>
            </page>
        </t>
    </template>

    <template id="report_purchaseorder_inherit">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="atlas_base.report_purchaseorder_document_inherit" t-lang="o.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="paperformat_purchaseorder" model="report.paperformat">
        <field name="name">A4 -Purchase Quotation</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">5</field>
        <field name="margin_bottom">22</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">80</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_purchase_order_inherit" model="ir.actions.report">
        <field name="name">Atlas Purchase Order</field>
        <field name="model">purchase.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">atlas_base.report_purchaseorder_inherit</field>
        <field name="report_file">atlas_base.report_purchaseorder_inherit</field>
        <field name="print_report_name">
            (object.state in ('draft', 'sent') and 'Request for Quotation - %s' % (object.name) or
            'Purchase Order - %s' % (object.name))
        </field>
        <field name="binding_model_id" ref="model_purchase_order"/>
        <field name="paperformat_id" ref="atlas_base.paperformat_purchaseorder"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
