<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="portal_my_project_inherit" inherit_id="project.portal_my_project">
        <xpath expr="//div[@class='row']" position="after">
            <div class="col-12 col-md-6 mb-2 mb-md-0">
                <t t-set="facility_ids_sum" t-value="sum(map(float, project.facility_ids.filtered(lambda rec: rec.volume).mapped('volume')))"/>
                <t t-if="facility_ids_sum > 0">
                    <div class="col pl-sm-0">
                        <p>Facility Volume:<span t-esc="facility_ids_sum"/></p>
                    </div>
                </t>
            </div>
        </xpath>
    </template>

    <template id="portal_my_task_inherit" inherit_id="project.portal_my_task">
        <xpath expr="//div[3]" position="after">
            <div class="col-12 col-md-6 mb-2 mb-md-0" style="margin-top: -35px;">
                <t t-set="facility_ids_sum" t-value="sum(map(float, task.project_id.facility_ids.filtered(lambda rec: rec.volume).mapped('volume')))"/>
                <t t-if="facility_ids_sum > 0">
                    <div class="col pl-sm-0">
                        <p>Facility Volume:<span t-esc="facility_ids_sum"/></p>
                    </div>
                </t>
            </div>
        </xpath>

    </template>

</odoo>
