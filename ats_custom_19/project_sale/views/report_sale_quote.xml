<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <template id="report_saleorder_document2" inherit_id="sale.report_saleorder_document" primary="True">
        <xpath expr="//th[@name='th_priceunit']" position="replace"></xpath>
        <xpath expr="//th[@name='th_discount']" position="replace"></xpath>
        <xpath expr="//th[@name='th_taxes']" position="replace"></xpath>
        <xpath expr="//th[@name='th_subtotal']" position="replace"></xpath>
        <xpath expr="//td[@name='td_priceunit']" position="replace"></xpath>

        <xpath expr="//td[@t-if='display_discount']" position="replace"></xpath>

        <xpath expr="//td[@name='td_taxes']" position="replace"></xpath>
        <xpath expr="//td[@name='td_subtotal']" position="replace"></xpath>
        <xpath expr="//td[@name='td_section_subtotal']" position="replace">
            <td name="td_section_subtotal" colspan="99">
                <t t-if="current_section.id not in doc.so_line_ids.ids">
                    <strong class="mr16">Subtotal</strong>
                    <span t-esc="current_subtotal" t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                </t>
            </td>
        </xpath>
    </template>

    <template id="report_saleorder2">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="project_sale.report_saleorder_document2" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
