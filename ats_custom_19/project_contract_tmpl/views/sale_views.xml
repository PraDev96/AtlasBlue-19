<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_order_view_inherited" model="ir.ui.view">
        <field name="name">view_sale_order_inherited_form</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="open_contract_of_project" type="object" class="oe_stat_button" icon="fa-file-o">
                    <field name="contract_count" string="Contracts" widget="statinfo"/>
                </button>
            </xpath>

        </field>
    </record>

</odoo>
