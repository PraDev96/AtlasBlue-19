<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_employee_link_project_wizard" model="ir.ui.view">
        <field name="name">import.employee.link.project.wizard.form</field>
        <field name="model">import.employee.link.project.wizard</field>
        <field name="arch" type="xml">

            <form string="Import Partner">
                <group>
                    <field name="file" filename="filename"/>
                    <field name="filename"/>
                </group>
                <footer>
                    <button name="import_employee" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_import_employee_link_project_wizard" model="ir.actions.act_window">
        <field name="name">Import Employee Number</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">import.employee.link.project.wizard</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_import_employee_link_project_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="import_employee_link_project_menu"
              name="Import Employee Link Project"
              action="action_import_employee_link_project_wizard"
              parent="hr.hr_menu_hr_reports"
              sequence="45"/>

</odoo>
