<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="fleet_vehicle_view_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <field name="state_id" position="after">
                <!-- <button name="action_project" type="object" string="Project" /> -->
                <button name="action_stolen" type="object" string="Stolen" invisible="state not in ('parking', 'custody')"/>
                <button name="action_accident" type="object" string="Accident" invisible="state not in ('parking', 'custody')"/>
                <button name="action_parking" type="object" string="Parking" invisible="state not in ('stolen', 'accident', 'custody')"/>
                <button name="action_custody" type="object" string="Custody" invisible="state != 'parking'"/>
                <button name="%(hr_atlas_blue.action_add_accessory_wizard)d" type="action" string="Add Accessory"/>
                <button name="%(hr_atlas_blue.action_remove_accessory_wizard)d" type="action" string="Manage Accessory"/>
                <field name="state" widget="statusbar" statusbar_visible="parking,project,stolen,accident" readonly="1"/>
            </field>

            <field name="state_id" position="replace"/>

            <field name="license_plate" position="attributes">
                <attribute name="required">True</attribute>
            </field>

            <field name="acquisition_date" position="attributes">
                <attribute name="string">Branding License End Date</attribute>
            </field>

            <div name="button_box" position="inside">
                <button name="action_fleet_document" type="object" class="oe_stat_button" icon="fa-file" context="{'search_default_fleet_vehicle_id': id}">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="file_count"/>
                        </span>
                        <span class="o_stat_text">Documents</span>
                    </div>
                </button>

                <button name="action_driver_history" type="object" class="oe_stat_button" icon="fa-users">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="driver_history_count"/>
                        </span>
                        <span class="o_stat_text">Driver Project History</span>
                    </div>
                </button>

                <button name="action_employee_vehicle_history" type="object" class="oe_stat_button" icon="fa-list">
                    <div class="o_field_widget o_stat_info">
                        <span class="o_stat_value">
                            <field name="employee_vehicle_history_count"/>
                        </span>
                        <span class="o_stat_text">Driver Vehicle History</span>
                    </div>
                </button>
            </div>

            <field name="image_128" position="after">
                <field name="fleet_logo" widget="image" class="oe_avatar"/>
            </field>

            <field name="residual_value" position="after">
                <field name="product_id"/>
            </field>

            <field name="location" position="after">
                <field name="location_id"/>
                <field name="project_id"/>
                <field name="internal_reference"/>
                <field name="condition" invisible="1"/>
                <field name="condition_id"/>
            </field>

            <field name="location" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="horsepower" position="after">
                <field name="cubic_capacity"/>
            </field>
            <field name="next_assignation_date" position="after">
                <field name="register_expiry_date"/>
                <field name="gps_id"/>
            </field>

            <xpath expr="//group" position="after">
                <notebook>
                    <page string="Accessory History">
                        <field name="move_ids"/>
                    </page>
                    <page string="Fleet Project History">
                        <field name="histroy_fleet_employee_ids">
                            <list string="Fleet Project History">
                                <field name="project_id"/>
                                <field name="start_date"/>
                                <field name="end_date"/>
                            </list>
                            <form string="Fleet Project History">
                                <group>
                                    <group>
                                        <field name="start_date"/>
                                        <field name="project_id"/>
                                    </group>
                                    <group>
                                        <field name="end_date"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </page>
                    <page string="Fleet Movement History">
                        <field name="fleet_movement_ids" readonly="True">
                            <list string="Fleet Movement History">
                                <field name="date_state"/>
                                <field name="from_state"/>
                                <field name="to_state"/>
                                <field name="from_project_id"/>
                                <field name="to_project_id"/>
                            </list>
                            <form string="Fleet Project History">
                                <group>
                                    <group>
                                        <field name="from_state"/>
                                        <field name="from_project_id"/>
                                        <field name="date_state"/>
                                    </group>
                                    <group>
                                        <field name="to_state"/>
                                        <field name="to_project_id"/>
                                    </group>
                                </group>
                            </form>
                        </field>
                    </page>
                    <page string="Vehicle Driver History">
                        <field name="driver_vehicle_history_ids" readonly="True">
                            <list string="Driver Vehicle History">
                                <field name="date"/>
                                <field name="from_employee_id"/>
                                <field name="to_employee_id"/>
                            </list>
                        </field>
                    </page>
                </notebook>
            </xpath>

            <field name="condition" position="after">
                <field name="fleet_division_id"/>
                <field name="partner_id" invisible="1"/>
                <field name="sponser_id"/>
            </field>

        </field>
    </record>

    <record id="fleet_vehicle_view_search_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.search.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_search"/>
        <field name="arch" type="xml">

            <field name="tag_ids" position="after">
                <field name="fleet_division_id"/>
                <!-- <field name="project_type_id"/> -->
                <field name="location_id"/>
                <field name="tag_ids"/>
                <field name="register_expiry_date"/>
                <field name="vin_sn"/>
            </field>

            <filter name="groupby_status" position="replace">
                <filter string="Status" name="groupby_status" context="{'group_by': 'state'}"/>
                <filter string="Division" name="groupby_division" context="{'group_by': 'fleet_division_id'}"/>
                <!-- <filter string="Project Type" name="groupby_project_type" context="{'group_by': 'project_type_id'}"/> -->
                <filter string="Location" name="groupby_location_id" context="{'group_by': 'location_id'}"/>
                <filter string="Condition" name="groupby_condition_id" context="{'group_by': 'condition_id'}"/>
                <filter string="Register Expiry Date" name="groupby_register_expiry_date" context="{'group_by': 'register_expiry_date'}"/>
                <filter string="Chassis No" name="groupby_vin_sn" context="{'group_by': 'vin_sn'}"/>
            </filter>

        </field>
    </record>

    <record id="fleet_vehicle_view_tree_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.tree.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree"/>
        <field name="arch" type="xml">

            <field name="future_driver_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="state_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="future_driver_id" position="after">
                <!-- <field name="project_type_id" optional="hide"/> -->
                <field name="location_id" optional="hide"/>
                <field name="fleet_division_id" optional="hide"/>
                <field name="condition_id" optional="hide"/>
                <field name="model_year" optional="hide"/>
            </field>

            <field name="state_id" position="before">
                <field name="gps_id" optional="hide"/>
                <field name="sim_ser_number" optional="hide"/>
                <field name="sim_phone_number" optional="hide"/>
                <field name="install_date" optional="hide"/>
            </field>

            <field name="state_id" position="after">
                <field name="register_expiry_date" optional="hide"/>
                <field name="odometer" optional="hide"/>
            </field>

        </field>
    </record>

    <record id="view_fleet_vehicle_pivot" model="ir.ui.view">
        <field name="name">fleet.vehicle.pivot</field>
        <field name="model">fleet.vehicle</field>
        <field name="arch" type="xml">
            <pivot string="Vehicle">
                <field name="condition_id" type="row"/>
                <field name="first_contract_date" type="col"/>
                <field name="net_car_value" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="fleet.fleet_vehicle_action" model="ir.actions.act_window">
        <field name="view_mode">kanban,tree,form,activity,pivot</field>
    </record>

    <!--  Log Services Line -->
    <record id="fleet_vehicle_log_services_view_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.form.inherit</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_form"/>
        <field name="arch" type="xml">

            <field name="amount" position="after">
                <field name="invoice_id" domain="[('move_type', 'in', ('out_invoice', 'in_invoice'))]"/>
                <field name="fleet_amount" invisible="1"/>
            </field>

        </field>
    </record>

    <record id="fleet_vehicle_log_services_view_tree_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.log.services.tree.inherit</field>
        <field name="model">fleet.vehicle.log.services</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_log_services_view_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//tree" position="attributes">
                <attribute name="default_order">date desc</attribute>
            </xpath>

            <field name="amount" position="after">
                <field name="gps_id" optional="hide"/>
                <field name="odometer"/>
            </field>

        </field>
    </record>

