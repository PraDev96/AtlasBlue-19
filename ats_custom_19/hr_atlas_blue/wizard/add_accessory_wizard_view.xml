<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_add_accessory_wizard_form" model="ir.ui.view">
        <field name="name">add.accessory.wizard.form</field>
        <field name="model">add.accessory.wizard</field>
        <field name="arch" type="xml">

            <form string="Add Accessory">
                <field name="wizard_line_ids" context="{'form_accessory': True}">
                    <list string="Accessory" editable="top">
                        <field name="product_id" domain="[('accessory_ok', '=', True)]" context="{'form_accessory': True}"/>
                        <field name="uom_id"/>
                        <field name="lot_id" domain="[('product_id', '=', product_id)]" context="{'default_product_id': product_id}"/>
                        <field name="available_quantity" readonly="True"/>
                        <field name="quantity"/>
                    </list>
                </field>
                <footer>
                    <button string="Add Accessory" name="add_accessory" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_add_accessory_wizard" model="ir.actions.act_window">
        <field name="name">Add accessorys Wizard</field>
        <field name="res_model">add.accessory.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
