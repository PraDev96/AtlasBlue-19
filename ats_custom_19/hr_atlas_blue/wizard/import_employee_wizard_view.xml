<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_import_rental_employee_wizard" model="ir.ui.view">
        <field name="name">import.rental.employee.wizard.form</field>
        <field name="model">import.rental.employee.wizard</field>
        <field name="arch" type="xml">

            <form string="Import Employee">
                <group>
                    <field name="file" filename="name"/>
                    <field name="name"/>
                    <div class="o_row">
                        <div>Please Create Separate Sheets as named below</div>
                        <ul>
                            <li>Employee</li>
                            <li>Department</li>
                            <li>Job Position</li>
                        </ul>
                    </div>
                </group>
                <footer>
                    <button name="import_data" string="Import" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-default" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_import_rental_employee_wizard" model="ir.actions.act_window">
        <field name="name">Import Rental Employee</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">import.rental.employee.wizard</field>
        <field name="view_mode">tree,form</field>
        <field name="view_id" ref="view_import_rental_employee_wizard"/>
        <field name="target">new</field>
    </record>

    <menuitem id="action_import_rental_employee_wizard_menu"
              name="Import Rental Employee"
              parent="hr.hr_menu_hr_reports"
              action="action_import_rental_employee_wizard"
              sequence="1"/>

</odoo>
