<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="external_layout_fleet_handover">
        <t t-if="not o" t-set="o" t-value="doc"/>

        <t t-if="not company">
            <!-- Multicompany -->
            <t t-if="company_id">
                <t t-set="company" t-value="company_id"/>
            </t>
            <t t-elif="o and 'company_id' in o">
                <t t-set="company" t-value="o.company_id.sudo()"/>
            </t>
            <t t-else="else">
                <t t-set="company" t-value="res_company"/>
            </t>
        </t>

        <t t-call="fleet_handover.external_layout_header_fleet_handover">
            <t t-raw="0"/>
        </t>

    </template>

    <template id="external_layout_header_fleet_handover">
        <div t-attf-class="header o_company_#{company.id}_layout" t-att-style="report_header_style">
            <div class="row">
                <div class="col-6" name="company_address">
                    <div t-field="company.partner_id" t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": true}'/>
                </div>
                <div class="col-6 mb4 text-right">
                    <img t-if="company.logo" t-att-src="image_data_uri(company.logo)" style="max-height: 145px; max-width: 245px;" alt="Logo"/>
                </div>
            </div>

            <div t-if="company.logo or company.report_header" class="row zero_min_height">
                <div class="col-12">
                    <div style="border-bottom: 1px solid black;"/>
                </div>
            </div>

        </div>

        <div t-attf-class="article o_report_layout_standard o_company_#{company.id}_layout"
             t-att-data-oe-model="o and o._name" t-att-data-oe-id="o and o.id" t-att-data-oe-lang="o and o.env.context.get('lang')">
            <t t-call="web.address_layout"/>
            <t t-raw="0"/>
        </div>

    </template>

    <!-- <report
        id="action_report_fleet_handover"
        string="Fleet Handover"
        model="fleet.handover"
        report_type="qweb-pdf"
        file="fleet_handover.report_fleet_handover"
        name="fleet_handover.report_fleet_handover"
        print_report_name="'Fleet Handover - %s' % (object.name)"
    /> -->

    <record id="action_report_fleet_handover" model="ir.actions.report">
        <field name="name">Fleet Handover</field>
        <field name="model">fleet.handover</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fleet_handover.report_fleet_handover</field>
        <field name="report_file">fleet_handover.report_fleet_handover</field>
        <field name="print_report_name">'Fleet Handover - %s' % (object.name)</field>
    </record>

</odoo>
