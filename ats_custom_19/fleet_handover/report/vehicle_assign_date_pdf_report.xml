<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_vehical_assignation">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">

                <div class="page">
                    <strong>Print Date</strong>:
                    <t t-esc="datetime.datetime.now().strftime('%Y-%m-%d %H:%M:%S')"/>
                    <h3 class="text-center">VEHICLE ASSIGNATION</h3>
                    <table class="table table-condensed">
                        <thead>
                            <tr style="background-color:#f9f9f9;">
                                <td class="text-left" style="background-color:#C0C0C0;">
                                    <strong>VEHICLE NAME</strong>
                                </td>
                                <td class="text-left" style="background-color:#C0C0C0;">
                                    <strong>ASSIGNATION To</strong>
                                </td>
                                <td class="text-right" style="background-color:#C0C0C0;">
                                    <strong>Date</strong>
                                </td>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="handover_data" t-as="fleet_data">
                                <td class="text-left">
                                    <span t-esc="fleet_data['fleet_vehilce_id']"/>
                                </td>
                                <td class="text-left">
                                    <span t-esc="fleet_data['assign_to']"/>
                                </td>
                                <td class="text-right">
                                    <span t-esc="fleet_data['date']"/>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>
            </t>
        </t>
    </template>

    <record id="action_report_vehical_assignation" model="ir.actions.report">
        <field name="name">Fleet Assignation</field>
        <field name="model">fleet.handover</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">fleet_handover.report_vehical_assignation</field>
        <field name="report_file">fleet_handover.report_vehical_assignation</field>
        <field name="print_report_name">'VEHICLE ASSIGNATION REPORT'</field>
    </record>

    <!--<report
            id="action_report_vehical_assignation"
            string="fleet Assignation"
            model="fleet.handover"
            report_type="qweb-pdf"
            name="fleet_handover.report_vehical_assignation"
            file="fleet_handover.report_vehical_assignation"
            print_report_name="'VEHICLE ASSIGNATION REPORT'"
    />-->

</odoo>
