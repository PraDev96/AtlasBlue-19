<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Brand -->
    <record id="product_brand_form_view" model="ir.ui.view">
        <field name="name">product.brand.form.view</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">

            <form string="Product Brand">
                <sheet>
                    <field name="image" widget="image" class="oe_avatar"/>
                    <div class="oe_title">
                        <h2>
                            <field name="name"/>
                        </h2>
                    </div>
                    <group>
                        <group>
                            <field name="is_publish"/>
                        </group>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <record id="product_brand_tree_view" model="ir.ui.view">
        <field name="name">product.brand.tree.view</field>
        <field name="model">product.brand</field>
        <field name="arch" type="xml">

            <list string="Product Brand">
                <field name="name"/>
                <field name="is_publish"/>
            </list>

        </field>
    </record>

    <record id="action_product_brand" model="ir.actions.act_window">
        <field name="name">Product Brands</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">product.brand</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Add New Brand
            </p>
        </field>
    </record>

    <menuitem id="menu_stock_product_brand"
              action="action_product_brand"
              parent="stock.menu_product_in_config_stock"
              sequence="5"/>

    <menuitem id="menu_sale_product_brand"
              action="action_product_brand"
              parent="sale.prod_config_main"
              sequence="5"/>


    <record id="product_template_only_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.product.form.inherit</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_only_form_view"/>
        <field name="arch" type="xml">

            <field name="categ_id" position="after">
                <field name="brand_id"/>
            </field>

        </field>
    </record>

</odoo>
