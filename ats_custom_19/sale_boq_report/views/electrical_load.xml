<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_project_electrical_load">
        <t t-call="web.basic_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>

            <div class="page">
                <div class="row">
                    <div class="col-8 pull-left">
                        <span t-esc="context_timestamp(datetime.datetime.now()).strftime('%Y-%m-%d')"/>
                    </div>
                    <div class="col-4">
                        <img style="max-height: 100px;" src="/sale_boq_report/static/atlas.jpg"/>
                    </div>
                </div>
                <br/>

                <div class="row">
                    <div class="col-8">
                        <strong>Name:</strong>
                        <span style="margin-left: 5px;" t-field="doc.partner_id.display_name"/>
                        <br/>
                        <strong>Address:</strong>
                        <span style="margin-left: 5px;" t-field="doc.project_city"/>
                        <br/>
                        <strong>Mobile:</strong>
                        <span style="margin-left: 5px;" t-field="doc.partner_id.mobile"/>
                        <br/>
                    </div>
                    <div class="col-4"/>
                </div>
                <div>
                    <strong>Project Name:</strong>
                    <span style="margin-left: 5px;" t-esc="doc.name"/>
                </div>
                <br/>
                <div>
                    <u>
                        <strong>Re: Electrical load for:</strong>
                        <span style="margin-left: 5px;" t-field="doc.opportunity_type"/>
                    </u>
                </div>
                <br/>
                <div>
                    <strong>With the above reference, we would like to inform you the required electrical power for your
                        <span t-field="doc.opportunity_type"/>
                        as follows:-
                    </strong>
                </div>
                <br/>
                <br/>

                <table class="table table-bordered table-sm" style="border: 2px solid black;">
                    <t t-set="lines" t-value="doc.get_electrical_product_details()"/>
                    <!--<t t-set="lines" t-value="doc.get_filtered_order_lines()"/>-->
                    <thead>
                        <tr>
                            <th style="vertical-align: middle; text-align: center;">SNo</th>
                            <th style="vertical-align: middle;">Item</th>
                            <th style="vertical-align: middle; text-align: center;">Quantity</th>
                            <th style="vertical-align: middle; text-align: center;">Unit load
                                <br/>
                                (KW)
                            </th>
                            <th style="vertical-align: middle; text-align: center;">Total Load
                                <br/>
                                (KW)
                            </th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-set="total_qty" t-value="0.0"/>
                        <t t-set="total_unit" t-value="0.0"/>
                        <t t-set="total_qty" t-value="0.0"/>
                        <t t-foreach="lines" t-as="line">
                            <tr>
                                <td style="vertical-align: middle; text-align: center;">
                                    <span t-esc="line_index + 1"/>
                                </td>
                                <td style="vertical-align: middle;">
                                    <span t-esc="line.get('name')"/>
                                </td>
                                <td style="vertical-align: middle; text-align: center;">
                                    <span t-esc="line.get('product_uom_qty')"/>
                                    <t t-set="total_qty" t-value="line.get('product_uom_qty') * line.get('electrical_load')"/>
                                </td>
                                <td style="vertical-align: middle; text-align: center;">
                                    <t t-set="ele_load" t-value="line.get('electrical_load')"/>
                                    <span t-esc="ele_load" t-options="{'widget': 'float', 'precision': 3}"/>
                                </td>
                                <td style="vertical-align: middle; text-align: center;">
                                    <span t-esc="total_qty" t-options="{'widget': 'float', 'precision': 3}"/>
                                    <t t-set="total_unit" t-value="total_unit + total_qty"/>
                                </td>

                            </tr>
                        </t>
                        <tr style="border: 2px solid black;">
                            <td class="text-center" colspan="2" style="border: 2px solid black;">
                                <strong class="mr16" colspan="6">Total Connected load (KW)</strong>
                            </td>
                            <td colspan="3" style="vertical-align: middle; text-align: center; border: 2px solid black;">
                                <strong class="mr16">
                                    <span t-esc="total_unit" t-options="{'widget': 'float', 'precision': 3}"/>
                                </strong>
                            </td>
                        </tr>
                        <tr style="border: 2px solid black;">
                            <td class="text-center" colspan="2" style="border: 2px solid black;">
                                <strong class="mr16">Round up total load (KW)</strong>
                            </td>
                            <td colspan="3" style="vertical-align: middle; text-align: center; border: 2px solid black;">
                                <strong class="mr16">
                                    <span t-esc="ceil(total_unit * 1.15)" t-options="{'widget': 'float', 'precision': 3}"/>
                                </strong>
                            </td>
                        </tr>
                    </tbody>
                </table>
                <br/>

                <div class="row">
                    <div class="col-4">
                        <span>Thanking you,
                            <br/>
                            Yours Faithfully.
                        </span>
                    </div>
                    <div class="col-4"/>
                    <div class="col-4">
                        <strong>Date Received</strong>
                        <br/>
                        <br/>
                        <strong>Name</strong>
                        <br/>
                        <strong>Signature</strong>
                    </div>
                </div>

                <div>
                    <t t-set="current_user" t-value="env['res.users'].browse(context.get('uid'))"/>
                    <b>
                        <span t-esc="current_user.name"/>
                        <br/>
                        <span t-esc="current_user.employee_id.job_id.name"/>
                    </b>
                </div>

            </div>
        </t>
    </template>

    <template id="report_project_electrical_load_tmpl">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sale_boq_report.report_project_electrical_load" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

    <record id="paperformat_latter" model="report.paperformat">
        <field name="name">Electrical Load</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">15</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">70</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_project_electrical_load_tmpl" model="ir.actions.report">
        <field name="name">Basic - Electrical Load</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_boq_report.report_project_electrical_load_tmpl</field>
        <field name="report_file">sale_boq_report.report_project_electrical_load_tmpl</field>
        <field name="paperformat_id" ref="sale_boq_report.paperformat_latter"/>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Swimming Pool - %s' % (object.name)) or 'Swimming Pool - %s' % (object.name)</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
