<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="emp_leave_encashment_search_view" model="ir.ui.view">
        <field name="name">emp.leave.encashment.search.view</field>
        <field name="model">emp.leave.encashment</field>
        <field name="arch" type="xml">

            <search string="Leave Payment">
                <field name="identification_id"/>
                <field name="department_id"/>
                <field name="mobile"/>
                <field name="phone"/>
                <field name="employee_id"/>
                <filter name="filter_pay_by_payslip" string="Pay by Payslip" domain="[('pay_by_payslip','=',True)]"/>
                <filter name="filter_no_pay_by_payslip" string="Without Payslip" domain="[('pay_by_payslip','=',False)]"/>
                <filter name="filter_date_payslip" string="Leave Payment Date" date="date_payslip"/>
                <group string="Group By">
                    <filter string="Departnment" name="group_by_department_id" context="{'group_by': 'department_id'}"/>
                    <filter string="Employee" name="group_by_employee_id" context="{'group_by': 'employee_id'}"/>
                    <filter string="State" name="group_by_state" context="{'group_by': 'state'}"/>
                    <separator/>
                    <filter string="Payslip Date" name="group_by_date_payslip" context="{'group_by': 'date_payslip'}"/>
                    <separator/>
                </group>
            </search>

        </field>
    </record>

    <record id="emp_leave_encashment_tree_view" model="ir.ui.view">
        <field name="name">emp.leave.encashment.tree.inherit</field>
        <field name="model">emp.leave.encashment</field>
        <field name="arch" type="xml">

            <list string="Leave Payment">
                <field name="name"/>
                <field name="employee_id"/>
                <field name="date_payslip"/>
                <field name="price_unit"/>
                <field name="payable_leave_count"/>
                <field name="tot_amount" sum="Total"/>
                <field name="department_id"/>
                <field name="company_id"/>
                <field name="state"/>
                <field name="pay_by_payslip"/>
            </list>

        </field>
    </record>

    <record id="emp_leave_encashment_form_view" model="ir.ui.view">
        <field name="name">emp.leave.encashment.form.inherit</field>
        <field name="model">emp.leave.encashment</field>
        <field name="arch" type="xml">

            <form string="Leave Payment">
                <header>
                    <button name="action_confirm" type="object" class="btn-primary" string="Confirm" invisible="state != 'draft'"/>
                    <button name="action_paid" type="object" class="btn-primary" string="Paid" invisible="pay_by_payslip == True or state in ('draft', 'paid', 'cancel')"/>
                    <button string="Cancel" name="action_cancel" action="object" invisible="state != 'confirm'" type='object'/>
                    <button string="Reset" name="action_reset" action="object" invisible="state != 'cancel'" type='object'/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm"/>
                </header>

                <sheet>
                    <widget name="web_ribbon" text="Paid" invisible="state != 'paid'"/>
                    <widget name="web_ribbon" text="Due" invisible="state != 'confirm'"/>
                    <label for="name"/>
                    <h2>
                        <field name="name" readonly="state != 'draft'"/>
                    </h2>

                    <group>
                        <group>
                            <field name="employee_id" readonly="state != 'draft'" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="contract_id" readonly="state != 'draft'" options="{'no_create': True, 'no_edit': True}"/>
                            <field name="currency_id" invisible="1"/>
                            <field name="monthly_salary" widget="monetary" force_save="1"/>
                            <field name="department_id" readonly="1" force_save="1"/>
                            <field name="mobile" invisible="1"/>
                            <field name="phone" invisible="1"/>
                            <field name="identification_id" invisible="1"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="date_payslip" string="Leave Payment Date" readonly="state != 'draft'"/>
                            <field name="pay_by_payslip" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="holiday_id" readonly="state != 'draft'"
                                   domain="[('employee_id','=',employee_id), ('holiday_status_id.allow_encashment', '=', True), ('already_encashed', '=', False)]"/>
                            <field name="holiday_status_id" readonly="state != 'draft'"/>
                            <field name="emp_input_id" invisible="emp_input_id == False" readonly="1" force_save="1"/>

                            <field name="accured_balance"/>
                            <!-- <field name="balance_leave_days"/> -->
                            <field name="leave_days"/>
                            <field name="paid_leave_days" readonly="1" force_save="1"/>
                            <field name="unpaid_leave_days"/>
                            <field name="public_days"/>

                            <label for="tot_leave_count" invisible="1"/>
                            <div class="o_row" invisible="1">
                                <field name="tot_leave_count"/>
                                <span>Days</span>
                            </div>
                            <label for="tot_leave_encashed" invisible="1"/>
                            <div class="o_row" invisible="1">
                                <field name="tot_leave_encashed"/>
                                <span>Days</span>
                            </div>
                            <label for="tot_leave_balance" invisible="1"/>
                            <div class="o_row" invisible="1">
                                <field name="tot_leave_balance"/>
                                <span>Days</span>
                            </div>

                            <label for="payable_leave_count" invisible="1"/>
                            <div class="o_row" invisible="1">
                                <field name="payable_leave_count" readonly="state != 'draft'"/>
                                <span>Days</span>
                            </div>
                            <hr/>
                            <field name="price_unit" widget="monetary" readonly="state != 'draft'" invisible="1"/>
                            <field name="cur_month_leave_amount" widget="monetary"/>
                            <field name="adv_leave_amount" widget="monetary"/>
                            <field name="tot_amount" widget="monetary"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Leave Analysis" invisible="1">
                            <field name="leave_report_ids" readonly="1" force_save="1">
                                <list create="0" edit="0" delete="0">
                                    <field name="employee_id"/>
                                    <field name="number_of_days" string="Number of Days" sum="Remaining Days"/>
                                    <field name="date_from"/>
                                    <field name="date_to"/>
                                    <field name="holiday_status_id"/>
                                    <field name="state"/>
                                    <field name="leave_type"/>
                                    <field name="name"/>
                                </list>
                            </field>
                        </page>
                        <page string="Extra Info">
                            <group readonly="1">
                                <group>
                                    <field name="write_date"/>
                                    <field name="write_uid"/>
                                    <field name="create_date"/>
                                    <field name="create_uid"/>
                                </group>
                                <group string="Leave Date">
                                    <field name="request_date_from" readonly="True"/>
                                    <field name="request_date_to" readonly="True"/>
                                </group>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </form>
        </field>
    </record>

    <record id="emp_leave_encashment_action" model="ir.actions.act_window">
        <field name="name">Leave Payment</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">emp.leave.encashment</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_emp_leave_encashment"
              name="Leave Payment"
              action="emp_leave_encashment_action"
              parent="hr_payroll.menu_hr_payroll_payslips"
              sequence="105"/>


    <!-- Contract -->
    <record id="hr_contract_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <field name="hr_responsible_id" position="after">
                <label for="leave_allocation"/>
                <div class="o_row" name="leave_allocation">
                    <field name="leave_allocation" nolabel="1"/>
                    <field name="allocation_type"/>
                </div>
            </field>

        </field>
    </record>

</odoo>
