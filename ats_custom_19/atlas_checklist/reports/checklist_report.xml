<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="paperformat_checklist" model="report.paperformat">
            <field name="name">Electrical Load</field>
            <field name="default" eval="True"/>
            <field name="format">A4</field>
            <field name="page_height">0</field>
            <field name="page_width">0</field>
            <field name="orientation">Portrait</field>
            <field name="margin_top">3</field>
            <field name="margin_bottom">15</field>
            <field name="margin_left">7</field>
            <field name="margin_right">7</field>
            <field name="header_line" eval="False"/>
            <field name="header_spacing">70</field>
            <field name="dpi">90</field>
        </record>

        <record id="action_report_project_checklist" model="ir.actions.report">
            <field name="name">Project Checklist</field>
            <field name="model">project.checklist</field>
            <field name="report_type">qweb-pdf</field>
            <field name="report_name">atlas_checklist.report_project_checklist</field>
            <field name="report_file">atlas_checklist.report_project_checklist</field>
            <field name="print_report_name">"Project CheckList"</field>
            <field name="binding_model_id" ref="model_project_checklist"/>
            <field name="binding_type">report</field>
            <field name="paperformat_id" ref="atlas_checklist.paperformat_checklist"/>
        </record>

        <template id="report_project_checklist">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="doc">
                    <t t-call="atlas_checklist.project_checklist_template"/>
                </t>
            </t>
        </template>

        <template id="project_checklist_template">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">
                    <div class="page">
                        <t t-foreach="doc" t-as="o">
                            <div class="row">
                                <div class="col-8 pull-left"><span/></div>
                                <div class="col-4">
                                    <img style="max-height: 100px;" src="/atlas_checklist/static/atlas.jpg"/>
                                </div>
                            </div>
                            <h5 class="text-center">Weekly Service Report</h5>
                            <div style="font-size:13px;text-align:left;">
                                <div class="row">
                                    <div class="text-left col-8">
                                        <span>Client: <strong t-field="o.projects_id.sudo().partner_id.name"/></span>
                                         <span>Client Number: </span>
                                         <span>Contract#: <strong t-field="o.projects_id.sudo().number"/>
                                    </span>
                                         <span>Pool ID#: </span>
                                    </div>
                                    <div class="text-right col-4">
                                        <span>Service Team: <strong t-field="o.projects_id.sudo().team_id.name"/></span>
                                        <br/>
                                    </div>
                                </div>
                                <div class="row">
                                    <div class="col-8 text-left">
                                        <span>Type: <strong t-field="o.projects_id.service_type"/></span>
                                    </div>
                                    <div class="col-4 text-right">
                                        <span>Date: <strong t-field="o.date"/></span>
                                    </div>
                                </div>
                                <div class="row col-12">
                                    <div class="text-left">
                                        <span>Weekly Visits: <strong t-esc="o.projects_id.sudo().number_of_days_per_week"/></span>
                                         <span>Days: <t t-foreach="o.projects_id.sudo().day_ids" t-as="days"><strong t-esc="days.day"/>,</t></span>
                                         <span>Contract End Date: <strong t-esc="o.projects_id.sudo().contract_end_date"/></span>
                                    </div>
                                </div>
                                <div class="row col-12">
                                    <div class="text-left">
                                        <span>Area: <strong t-esc="o.projects_id.sudo().project_city.display_name"/></span>
                                         <span>Address:
                                        <strong>
                                            <t t-if="o.projects_id.sudo().project_adress.name"><span t-esc="o.projects_id.sudo().project_adress.name"/>, </t>
                                            <t t-if="o.projects_id.sudo().project_adress.street"><span t-esc="o.projects_id.sudo().project_adress.street"/>, </t>
                                            <t t-if="o.projects_id.sudo().project_adress.street2"><span t-esc="o.projects_id.sudo().project_adress.street2"/>, </t>
                                            <t t-if="o.projects_id.sudo().project_adress.city"><span t-esc="o.projects_id.sudo().project_adress.city"/>, </t>
                                            <t t-if="o.projects_id.sudo().project_adress.state_id.name"><span t-esc="o.projects_id.sudo().project_adress.state_id.name"/>, </t>
                                            <t t-if="o.projects_id.sudo().project_adress.zip"><span t-esc="o.projects_id.sudo().project_adress.zip"/>, </t>
                                            <span t-esc="o.projects_id.sudo().project_adress.country_id.name"/>
                                        </strong>
                                        </span> <span>Phone: <strong t-esc="o.projects_id.sudo().phone"/></span>
                                    </div>
                                </div>
                                <div class="row col-12">
                                    <span class="text-left">Details: <span t-field="o.projects_id.description" t-options="{'no_marker': True,'wrap': False}"/></span>
                                </div>
                            </div>
                            <table class="table table-bordered table-sm" style="font-size:17px;border: 1px solid black;">
                                <tr style="font-size:17px;">
                                    <td class="text-center" style="width:80%"><span>Description</span></td>
                                    <td class="text-center" style="width:20%"><span>Inspection</span></td>
                                </tr>
                                <tr style="font-size:17px;">
                                    <td colspan="2"><span><strong>Swimming Pool</strong></span></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Vacuum Pool</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.vacuum_pool">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Brush Pool</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.brush_pool">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Clean Tiles</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.clean_tiles">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Skim Pool</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.skim_pool">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Clean Skimmer/Overflow Gutter</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.clean_skimmer_overflow">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Clean Deck Area-50cm from pool edge</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.clean_deck_area">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:17px;">
                                    <td colspan="2"><span><strong>Machine Room</strong></span></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Back Wash Filter Pressure Reading Before backwash</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.back_wash_filter_before"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Back Wash Filter Pressure Reading After backwash</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.back_wash_filter_after"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Clean Pump Strainer(s)</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.clean_pump_strainer">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Clean Machine Room(Ones a Month)</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.clean_machine_room">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Clean Balance Tank</span></td>
                                    <td class="text-center" style="width:20%">
                                        <t t-if="o.clean_balance_tank">
                                            <img src="/atlas_checklist/static/src/img/right2.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                        <t t-else="">
                                            <img src="/atlas_checklist/static/src/img/blank.jpg" style="height:20px;width:25px;border: 2px solid ;black;"
                                                 class="img img-fluid img-center"/>
                                        </t>
                                    </td>
                                </tr>
                                <tr style="font-size:17px;">
                                    <td colspan="2"><span><strong>Water Chemistry</strong></span></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Water Temperature</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.water_temperature"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Free Chlorine Level 1-3 PPM</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.free_chlorin_level"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>PH Level 7.4-7.6 Chemical</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.ph_level"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Total Alkalinity 80-120ppm</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.total_alkalinity"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Calcium Hardness 200-250ppm</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.calcium_hardness"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Cyanuric Acid 30-50 PPM</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.cyanuric_acid"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Total Chlorine</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.total_chlorine"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>Salinity</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.salinity"/></td>
                                </tr>
                                <tr style="font-size:13px;">
                                    <td class="text-left" style="width:80%"><span>TDS</span></td>
                                    <td class="text-center" style="width:20%"><span t-field="o.tds"/></td>
                                </tr>
                            </table>
                            <table class="table table-borderless" style="font-size:13px;text-align:left;" width="30%">
                                <tr class='text-center'>
                                    <img t-if="o.signature" t-att-src="'data:image/png;base64,%s' % (o.signature.decode('utf-8'))" style="max-height: 1cm; max-width: 3cm;"/>
                                </tr>
                                <tr class='text-center'>
                                    <hr style="border-style:thin;border-top-width:1px;border-color:black;width:15%"/>Client Signature
                                </tr>
                            </table>
                        </t>
                    </div>
                </t>
            </t>
        </template>

    </data>
</odoo>
