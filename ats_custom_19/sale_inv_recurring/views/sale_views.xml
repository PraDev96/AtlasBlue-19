<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="sale_recurring_invoice_form" model="ir.ui.view">
        <field name="name">sale.recurring.invoice.form.inherit</field>
        <field name="model">sale.recurring.invoice</field>
        <field name="arch" type="xml">

            <form>
                <header>
                    <button name="action_confirm_inv_recurrence" string="Confirm Recurrent Invoice" type="object" class="oe_highlight" invisible="state != 'draft'"/>
                    <button name="action_reset" string="Reset" type="object" class="oe_highlight" invisible="state != 'cancel'"/>
                    <button name="action_cancel" string="Cancel Further Recurrence" class="oe_highlight"  invisible="state != 'running'"
                            type="object" confirm="Future schedule will be cancelled, Generated Invoices will not be removed. Would you like to proceed ?"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <h2>
                        <field name="name"/>
                    </h2>
                    <group>
                        <group>
                            <field name="inv_start_date" readonly="state != 'draft'"/>
                            <field name="recurrent_inv_nbr" readonly="state != 'draft'"/>
                            <label for="interval_nbr"/>
                            <div class="o_row">
                                <field name="interval_nbr" readonly="state != 'draft'"/>
                                <field name="interval_unit" readonly="state != 'draft'"/>
                            </div>
                        </group>
                        <group>
                            <field name="instant_create" readonly="state != 'draft'"/>
                            <field name="should_auto_post" readonly="state != 'draft'"/>
                            <field name="ref_invoice_id" readonly="1"/>
                        </group>
                    </group>

                    <notebook>
                        <page string="Schedule">
                            <field name="line_ids" readonly="1">
                                <list>
                                    <field name="date_invoice"/>
                                    <field name="ref_invoice_id" optional="hide"/>
                                    <field name="invoice_id"/>
                                    <field name="state"/>
                                </list>
                            </field>
                        </page>
                        <page string="Recurrent Invoices">
                            <field name="recurrent_inv_ids" readonly="1"/>
                        </page>
                        <page string="Confirmed By">
                            <group>
                                <field name="recurrent_user_id" invisible="recurrent_user_id == False"/>
                                <field name="recurrent_confirmed_date" invisible="recurrent_user_id == False"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>

                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>

            </form>
        </field>
    </record>

    <record id="sale_recurring_invoice_tree" model="ir.ui.view">
        <field name="name">sale.recurring.invoice.tree.inherit</field>
        <field name="model">sale.recurring.invoice</field>
        <field name="arch" type="xml">

            <list>
                <field name="name"/>
                <field name="inv_start_date"/>
                <field name="recurrent_inv_nbr"/>
                <field name="interval_nbr"/>
                <field name="interval_unit"/>
                <field name="ref_invoice_id"/>
                <field name="state"/>
            </list>

        </field>
    </record>

    <record id="sale_recurring_invoice_action" model="ir.actions.act_window">
        <field name="name">Recurring Invoices</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">sale.recurring.invoice</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_recurring_invoice_ref"
              name="Recurring Invoices"
              parent="account.menu_finance_receivables"
              sequence="20"/>


    <record id="view_move_form" model="ir.ui.view">
        <field name="name">account.move.form</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//button[@name='action_register_payment']" position="after">
                <button name="action_invoice_recurrent" type="object" class="oe_highlight" invisible="move_type != 'out_invoice'"
                        context="{'default_ref_invoice_id': id}" string="Recurrent Invoice" groups="account.group_account_invoice"/>
            </xpath>

            <field name="invoice_date" position="after">
                <field name="recurrent_ref_id" readonly="1" invisible="recurrent_ref_id == False"/>
            </field>

        </field>
    </record>

</odoo>
