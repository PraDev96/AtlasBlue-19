<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_users_form_inherit_amek" model="ir.ui.view">
        <field name="name">res.users.form.inherit.amek</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">

            <xpath expr="//page" position="after">
                <page string="Menus">
                    <group>
                        <field name="restricted_menus" widget="many2many_tags" options="{'no_create': True, 'no_open': True}"/>
                    </group>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
