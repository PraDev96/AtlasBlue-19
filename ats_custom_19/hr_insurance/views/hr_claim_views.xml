<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <!-- HR Claim -->
    <record id="hr_claim_form_view" model="ir.ui.view">
        <field name="name">hr.claim.form</field>
        <field name="model">hr.claim</field>
        <field name="arch" type="xml">

            <form string="Claim">
                <header>
                    <button name="action_confirm" string='Confirm' type="object" invisible="state != 'draft'"/>
                    <button name="action_reset_draft" string="Reset Draft" type="object" invisible="state not in ('confirm', 'pending')"/>
                    <button name="action_pending" string="Pending" type="object" invisible="state not in ('draft', 'confirm')"/>
                    <button name="action_done" string="Done" type="object" invisible="state != 'confirm'"/>
                    <button name="action_cancel" string='Cancel' type="object" invisible="state != 'draft'"/>
                    <field name="attachment_number" invisible="1"/>
                    <widget name="attach_document" string="Attach Document" action="message_post" invisible="attachment_number &lt; 1 or id == False"/>
                    <widget name="attach_document" string="Attach Document" action="message_post" highlight="1" invisible="attachment_number &gt;= 1 or id == False"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,confirm,pending,done"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="company_id" invisible="1"/>
                            <field name="employee_id" context="{'default_company_id': company_id}"
                                   domain="['|', ('company_id', '=', company_id), ('company_id', '=', False)]"/>
                            <field name="joining_date"/>
                            <field name="job_position_id"/>
                            <field name="claim_date"/>
                            <field name='amount'/>
                            <field name="accident_date"/>
                            <field name="claim_payment_date"/>
                            <field name="confirm_date"/>
                        </group>
                        <group>
                            <field name="claim_type_id"/>
                            <field name="insurance_company_id"/>
                            <field name="claim_invoice_id"/>
                            <field name="resume_work_date"/>
                            <field name="claim_number"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="currency_id" invisible="0"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Expenses">
                            <field name="expense_ids" context="{'employee_id': employee_id}">
                                <list string="Expenses" decoration-bf="message_needaction == True" class="o_expense_tree" js_class="hr_expense_tree"
                                      decoration-info="state == 'draft'" decoration-muted="state == 'cancel'">
                                    <field name="currency_id" invisible="True"/>
                                    <field name="nb_attachment" invisible="True"/>
                                    <field name="date"/>
                                    <field name="name"/>
                                    <field name="employee_id"/>
                                    <field name="sheet_id" invisible="not context.get('show_report', False)"/>
                                    <field name="payment_mode" optional="hide"/>
                                    <field name="analytic_distribution" optional="hide" groups="analytic.group_analytic_accounting"/>
                                    <field name="company_id" optional="hide" groups="base.group_multi_company"/>
                                    <!--<field name="analytic_tag_ids" optional="hide" widget="many2many_tags" groups="analytic.group_analytic_tags"/>-->
                                    <field name="total_amount" optional="hide" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                                    <button name="action_get_attachment_view" string="View Attached Documents"
                                            type="object" icon="fa-paperclip" invisible="nb_attachment == 0"/>
                                    <field name="message_needaction" invisible="1"/>
                                    <field name="state" optional="hide"/>
                                    <field name="activity_exception_decoration" optional="hide" widget="activity_exception"/>
                                </list>
                            </field>
                            <group class="oe_subtotal_footer oe_right">
                                <field name="total_expense" widget="monetary" options="{'currency_field': 'currency_id'}"/>
                            </group>
                        </page>
                    </notebook>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="hr_claim_tree_view" model="ir.ui.view">
        <field name="name">hr.claim.tree</field>
        <field name="model">hr.claim</field>
        <field name="arch" type="xml">
            <list string="Claim">
                <!-- <field name="name"/> -->
                <field name="claim_number"/>
                <field name="claim_type_id"/>
                <field name="employee_id"/>
                <field name="joining_date"/>
                <field name="job_position_id"/>
                <field name="claim_date"/>
                <field name="accident_date"/>
                <field name="claim_payment_date"/>
                <field name="resume_work_date"/>
                <field name="insurance_company_id"/>
                <field name="claim_invoice_id"/>
                <field name="attachment_number" invisible="1"/>
                <button name="action_get_attachment_view" string="View Attached Documents" type="object" icon="fa-paperclip" invisible="attachment_number == 0"/>
                <field name="amount" sum="Total"/>
                <field name="total_expense" sum="Total Expense"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="hr_claim_search_view" model="ir.ui.view">
        <field name="name">hr.claim.list.select</field>
        <field name="model">hr.claim</field>
        <field name="arch" type="xml">
            <search string="Search Claim">
                <field name="employee_id"/>
                <field name="claim_date"/>
                <field name="accident_date"/>
                <field name="resume_work_date"/>
                <field name="insurance_company_id"/>
                <field name="claim_invoice_id"/>
                <field name="claim_type_id"/>
                <field name="claim_payment_date"/>
                <field name="state"/>
                <group expand="0" string="Group By">
                    <filter string="Employee" name="employee" domain="[]" context="{'group_by': 'employee_id'}"/>
                    <filter name="insurance_company" string="Insurance Company" domain="[]" context="{'group_by': 'insurance_company_id'}"/>
                    <filter string="Claim Date" name="claim_date" domain="[]" context="{'group_by': 'claim_date'}"/>
                    <filter string="Accident Date" name="accident_date" domain="[]" context="{'group_by': 'accident_date'}"/>
                    <filter string="Status" name="state" domain="[]" context="{'group_by': 'state'}"/>
                    <filter string="Claim Type" name="claim_Ttype" domain="[]" context="{'group_by': 'claim_type_id'}"/>
                    <filter string="Claim Payment Date" name="claim_date" domain="[]" context="{'group_by': 'claim_payment_date'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_hr_claim" model="ir.actions.act_window">
        <field name="name">Claim</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.claim</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_hr_claim"
              name="Claim"
              parent="hr.menu_hr_root"
              groups="hr_insurance.group_claim_user"
              sequence="20"/>

    <menuitem id="hr_claim_menu"
              action="action_hr_claim"
              parent="menu_hr_claim"
              groups="hr_insurance.group_claim_user"
              sequence="35"/>


    <!-- Claim Type -->
    <record id="hr_claim_type_form_view" model="ir.ui.view">
        <field name="name">hr.claim.type.form</field>
        <field name="model">hr.claim.type</field>
        <field name="arch" type="xml">
            <form string="Claim Type">
                <sheet>
                    <group>
                        <field name="name"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="hr_claim_type_tree_view" model="ir.ui.view">
        <field name="name">hr.claim.type.tree</field>
        <field name="model">hr.claim.type</field>
        <field name="arch" type="xml">
            <list string="Claim Type">
                <field name="name"/>
            </list>
        </field>
    </record>

    <record id="action_hr_claim_type" model="ir.actions.act_window">
        <field name="name">Claim Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hr.claim.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="hr_claim_type_menu"
              action="action_hr_claim_type"
              parent="hr.menu_human_resources_configuration"
              sequence="40"/>


    <!-- HR Expense -->
    <record id="hr_expense_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.expense.view.form.inherit</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.hr_expense_view_form"/>
        <field name="arch" type="xml">

            <button name="action_view_sheet" position="after">
                <button name="action_reset_draft" type="object" string="Reset to Draft"
                        invisible="state not in ('reported', 'approved', 'done', 'refused')" class="oe_highlight"/>
            </button>

            <field name="company_id" position="before">
                <field name="requester_id"/>
            </field>

            <field name="date" position="after">
                <field name="payment_date"/>
            </field>

        </field>
    </record>

    <record id="view_expenses_tree_inherit" model="ir.ui.view">
        <field name="name">hr.expense.tree.inherit</field>
        <field name="model">hr.expense</field>
        <field name="inherit_id" ref="hr_expense.view_expenses_tree"/>
        <field name="arch" type="xml">
            <field name="state" position="before">
                <field name="requester_id"/>
            </field>
        </field>
    </record>

    <!--<record id="hr_expense.hr_expense_actions_my_unsubmitted" model="ir.actions.act_window">
        <field name="view_mode">tree,kanban,form,graph,pivot</field>
    </record>-->

    <!-- Move -->
    <record id="view_move_form_inherit" model="ir.ui.view">
        <field name="name">account.move.form.inherit</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <field name="ref" position="after">
                <field name="employee_id" invisible="move_type != 'entry'" readonly="True"/>
            </field>

        </field>
    </record>

</odoo>
