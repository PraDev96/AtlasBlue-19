<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_expense_approve_wizard_form" model="ir.ui.view">
        <field name="name">expense.approve.wizard.form</field>
        <field name="model">expense.approve.wizard</field>
        <field name="arch" type="xml">
            <form string="Expenses Approve">
                <span class="o_form_label">Warning: Are you sure want to Approve Expenses?</span>
                <footer>
                    <button string="Approve" name="action_approve" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--<act_window id="action_expense_approve_wizard"
                name="Expense Approve"
                res_model="expense.approve.wizard"
                binding_model="hr.expense"
                binding_views="list"
                view_mode="form"
                target="new"/>-->

    <record id="action_expense_approve_wizard" model="ir.actions.act_window">
        <field name="name">Expense Approve</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">expense.approve.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
