<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_order_form_inherit_configure_package" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.configure_package</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <xpath expr="//header" position="inside">
                <button name="action_configure_packages" string="Quotation Wizard" type="object" invisible="state != 'draft'"/>
            </xpath>
            <field name="payment_term_id" position="after">
                <field name="opportunity_type"/>
                <field name="root_facility_ids" widget="many2many_tags" readonly="1" force_save="1"/>
            </field>

        </field>
    </record>

    <record id="product_package_wizard_view_form" model="ir.ui.view">
        <field name="name">product.package.wizard.form</field>
        <field name="model">product.package.wizard</field>
        <field name="arch" type="xml">

            <form string="Select Package">
                <sheet>
                    <field name="line_ids">
                        <list editable="bottom" create="0" delete="0">
                            <field name="is_selected"/>
                            <field name="package_id" readonly="1" force_save="1"/>
                        </list>
                    </field>
                    <group>
                        <field name="all_selected" invisible="package_component_ids == []"/>
                    </group>

                    <separator string="Components" colspan="4"/>
                    <field name="package_component_ids" invisible="package_component_ids == False" nolabel="1">
                        <list editable="bottom">
                            <field name="is_selected"/>
                            <!--<field name="id" invisible="1"/>
                            <field name="product_pkg_wizard_id" invisible="1"/>-->
                            <field name="product_id"/>
                            <field name="product_uom_category_id" invisible="1"/>
                            <field name="product_uom"/>
                            <field name="product_uom_qty"/>
                            <field name="price_unit"/>
                        </list>
                    </field>

                    <field name="selected_package_ids" invisible="1" force_save="1">
                        <list>
                            <field name="id"/>
                            <field name="product_pkg_wizard_id" invisible="1"/>
                            <field name="package_ids" widget="many2many_tags"/>
                            <field name="component_ids" widget="many2many_tags"/>
                        </list>
                    </field>

                    <group>
                        <group>
                            <field name="sale_partner_id" invisible="1"/>
                            <field name="partner_id" domain="[('parent_id', '=', sale_partner_id)]"
                                   context="{'default_parent_id': sale_partner_id, 'form_view_ref':'product_package.create_contact_form_view', 'default_b_subcontact': True}"/>
                            <field name="system_type"/>
                            <label for="water_surface"/>
                            <div class="o_row">
                                <field name="water_surface"/>
                                <span class="oe_black">m²</span>
                            </div>
                            <label for="volume"/>
                            <div class="o_row">
                                <field name="volume"/>
                                <span class="oe_black">m³</span>
                            </div>
                            <field name="check_next_pkg" invisible="1"/>
                            <field name="check_skip_pkg" invisible="1"/>
                            <field name="highlight_confirm" invisible="1"/>
                            <field name="sale_order_id" invisible="1" force_save="1"/>
                            <field name="opportunity_type" invisible="1" force_save="1"/>
                            <field name="show_confirm_button" invisible="1" force_save="1"/>
                        </group>
                    </group>
                </sheet>
                <footer>
                    <button name="next_packages" string="Next" invisible="check_next_pkg == False" type="object" class="btn-secondary"/>
                    <button name="previous_packages" string="Previous" type="object" class="btn-secondary"/>
                    <button name="skip_packages" string="Skip" invisible="check_skip_pkg == False" type="object" class="btn-secondary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-primary" invisible="highlight_confirm == False"/>
                    <button name="action_confirm" string="Confirm" type="object" class="btn-secondary" invisible="highlight_confirm == True"/>
                </footer>
            </form>

        </field>
    </record>


    <record id="package_config_tree_view" model="ir.ui.view">
        <field name="name">package.config.tree.view</field>
        <field name="model">package.config</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="opportunity_type"/>
                <field name="is_root_package"/>
                <field name="component_ids"/>
                <field name="next_package_ids"/>
            </list>
        </field>
    </record>

    <record id="package_config_form_view" model="ir.ui.view">
        <field name="name">package.config.form</field>
        <field name="model">package.config</field>
        <field name="arch" type="xml">

            <form>
                <sheet>
                    <div class="oe_button_box" name="button_box"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1>
                            <field name="name"/>
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="opportunity_type" invisible="is_root_package != True"/>
                            <field name="is_root_package"/>
                            <field name="is_facility"/>
                            <field name="next_package_ids" widget="many2many_tags"/>
                            <field name="skip_package_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Components" name="component_ids">
                            <field name="component_ids" nolabel="1" context="{'default_package_id': id}">
                                <list editable="bottom">
                                    <field name="product_id"/>
                                    <field name="product_uom_category_id" invisible="1"/>
                                    <field name="product_uom"/>
                                    <field name="product_uom_qty"/>
                                    <field name="price_unit" readonly="1"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>

        </field>
    </record>

    <record id="package_config_action" model="ir.actions.act_window">
        <field name="name">Quotation Wizard</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">package.config</field>
        <field name="view_mode">tree,form,kanban</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create a new Product Package
            </p>
        </field>
    </record>

    <menuitem id="menu_package_config"
              name="Quotation Wizard"
              action="package_config_action"
              parent="sale.product_menu_catalog"
              sequence="100"/>

</odoo>
