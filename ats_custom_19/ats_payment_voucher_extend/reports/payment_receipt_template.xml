<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="payment_receipt_document_inherit_narration" inherit_id="account.report_payment_receipt_document">

        <xpath expr="//div[@name='payment_method']" position="replace">
            <div name="payment_method" t-if="o.journal_id" class="col-6">
                Payment Method:<span t-field="o.journal_id.name"/>
            </div>
        </xpath>

        <xpath expr="//div[hasclass('mb-4')]" position="inside">
            <div class="oe_structure"></div>
            <div name="amount_in_words" class="row">
                <div class="col-6" t-if="o.amount">
                    Payment Amount in Words: <span t-esc="o.currency_id.amount_to_text(o.amount)"/>
                </div>
            </div>
        </xpath>

        <xpath expr="//table[@name='invoices']" position="after">
            <div t-if="o.description" name="payment_narration">
                <h6><strong>Narration</strong></h6>
                <span t-field="o.description"/>
            </div>

            <div name="payment_note_section" style="margin-top: 30px; margin-bottom: 40px;">
                <span class="fst-italic">Note: This document generated by the system; Therefore not required the Signature and Stamp.</span>
            </div>

            <div class="row text-center">
                <div class="col-6"/>
                <div name="payment_user_name" class="col-6">
                    <strong>Created By:</strong>
                </div>
            </div>
            <div class="row text-center">
                <div class="col-6"/>
                <div name="payment_user_name_data" class="col-6">
                    <span t-field="o.create_uid.name"/>
                </div>
            </div>
        </xpath>

    </template>

</odoo>
