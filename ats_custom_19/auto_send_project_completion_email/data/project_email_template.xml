<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="project_complition_notification_mail_template" model="mail.template">
        <field name="name">Project Completion: Send by email</field>
        <field name="model_id" ref="project.model_project_project"/>
        <field name="email_from">{{ user.partner_id.email |safe }}</field>
        <field name="subject">Reminder For Project Completion. Of Project ${object.name}</field>
        <!--<field name="report_template" eval="False"/>
        <field name="report_name">Project Completion Invoice Report</field>-->
        <field name="body_html" type="html">
            <div style="margin: 0px; padding: 0px;">
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Hello
                </p>
                <br/>
                <!-- <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Your Project ref.${object.name} Total Completion  ${object.project_progress}
                </p> -->
                <p style="margin: 0px; padding: 0px; font-size: 13px;">
                    Please, find an attachment below.
                </p>
            </div>
        </field>
    </record>

</odoo>
