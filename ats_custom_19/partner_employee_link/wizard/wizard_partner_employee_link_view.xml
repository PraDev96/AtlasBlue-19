<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="wizard_partner_employee_link_view" model="ir.ui.view">
        <field name="name">wizard.partner.employee.link.form</field>
        <field name="model">wizard.partner.employee.link</field>
        <field name="arch" type="xml">

            <form string="Create Partner">
                <span class="o_form_label">Warning: Are you sure want to create Partner for Employee?</span>
                <footer>
                    <button string="Apply" name="action_link" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_wizard_partner_employee_link" model="ir.actions.act_window">
        <field name="name">Create Partner</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">wizard.partner.employee.link</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
        <field name="binding_model_id" ref="hr.model_hr_employee"/>
        <field name="binding_view_types">list,form</field>
    </record>

</odoo>
