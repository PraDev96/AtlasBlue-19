<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_quick_add_product_sale_wizard_form" model="ir.ui.view">
            <field name="name">view.quick.add.product.sale.wizard.form</field>
            <field name="model">wizard.quick.add.product.sale</field>
            <field name="arch" type="xml">

                <form string="Order Bulk Products">
                    <group>
                        <group></group>
                        <group>
                            <field name="search_product" placeholder="Search Products Here"/>
                        </group>
                    </group>
                    <separator string="Add Products"/>
                    <field name="quick_product_line_ids" mode="tree">
                        <tree editable="bottom" create="0" delete="0">
                            <field name="quick_product_wizard_id" invisible="1"/>
                            <field name="is_select"/>
                            <field name="product_id"/>
                        </tree>
                    </field>

                    <separator string="Selected Products"/>
                    <field name="selected_product_ids" mode="tree" readonly="0">
                        <tree create="false" editable="false" delete="true">
                            <field name="default_code"/>
                            <field name="name"/>
                            <field name="lst_price"/>
                            <field name="standard_price"/>
                            <field name="qty_available"/>
                            <field name="virtual_available"/>
                            <field name="uom_id"/>
                        </tree>
                    </field>

                    <footer>
                        <button name="confirm_products" string="Confirm" type="object" class="btn-primary"/>
                        <button string="Discard" class="btn-default" special="cancel"/>
                    </footer>
                </form>

            </field>
        </record>

    </data>
</odoo>
