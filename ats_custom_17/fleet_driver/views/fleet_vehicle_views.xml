<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id="fleet_vehicle_view_form_inherit12" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form"/>
        <field name="arch" type="xml">

            <field name="driver_id" position="replace">
                <field name="emp_driver_id" options="{'no_create': True, 'no_edit': True}"/>
                <field name="driver_id" invisible="1"/>
                <field name="driver_employee_id" invisible="1"/>
                <field name="phone"/>
                <field name="mobile" invisible="1"/>
                <field name="work_location"/>
            </field>

            <field name="future_driver_id" position="replace">
                <field name="future_emp_driver_id" options="{'no_create': True, 'no_edit': True}"/>
                <field name="future_driver_id" invisible="1"/>
                <field name="future_driver_employee_id" invisible="1"/>
            </field>

        </field>
    </record>

</odoo>
