<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="fleet_handover_wizard_form" model="ir.ui.view">
        <field name="name">fleet.handover.wizard.form</field>
        <field name="model">fleet.handover.wizard</field>
        <field name="arch" type="xml">
            <form string="VEHICLE ASSIGNATION REPORT">
                <sheet>
                    <group>
                        <group>
                            <field name="start_date"/>
                        </group>
                        <group>
                            <field name="end_date"/>
                        </group>
                        <group>
                            <field name="fleet_vehicle_ids" widget="many2many_tags"/>
                        </group>
                        
                    </group>
                </sheet>
                <footer>
                    <button name="print_excel" type="object" string="Print" class="btn btn-primary"/>
                    <button name="print_all_pdf" type="object" string="Print PDF" class="btn btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_fleet_handover_wizard" model="ir.actions.act_window">
        <field name="name">VEHICLE ASSIGNATION REPORT</field>
        <field name="res_model">fleet.handover.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="fleet_handover_wizard_form"/>
        <field name="target">new</field>
    </record>

    <menuitem
        id="menu_fleet_handover_wizard"
        name="VEHICLE ASSIGNATION REPORT"
        parent="fleet.menu_fleet_reporting"
        action="action_fleet_handover_wizard"
        sequence="5"/>

</odoo>
