<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <record id="seq_concrete_checklist" model="ir.sequence">
        <field name="name">Concrete Checklist Sequence</field>
        <field name="code">concrete.checklist.seq</field>
        <field name="prefix">CON/%(year)s/%(month)s/</field>
        <field name="padding">3</field>
        <field name="number_next">1</field>
        <field name="number_increment">1</field>
    </record>

