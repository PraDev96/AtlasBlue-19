<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_atlas_base_inherit_installation_details" model="ir.ui.view">
        <field name="name">project.atlas.base.inherit.installation.details</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Installation Details" invisible="opportunity_type not in ('project', 'renovation')">
                    <separator string="Installation Details"/>
                    <field name="service_installation_detail_ids" nolabel="1">
                        <tree create='0' delete="false">
                            <field name="name" required="1" readonly="1"/>
                            <field name="expected_start_date"/>
                            <field name="installation_completion_date"/>
                            <field name="warranty_end_date"/>
                            <field name="is_goods_ordered"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>


    <record id="project_installation_details_form_view" model="ir.ui.view">
        <field name="name">project.installation.details.form.view</field>
        <field name="model">installation.completion.detail</field>
        <field name="arch" type="xml">
            <form string="Installation Details Form" create='0' delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="project_id" readonly="1"/>
                            <field name="expected_start_date"/>
                            <field name="warranty_end_date"/>
                        </group>
                        <group>
                            <field name="name"/>
                            <field name="installation_completion_date"/>
                            <field name="is_goods_ordered"/>
                        </group>
                    </group>
                </sheet>
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </form>
        </field>
    </record>

    <record id="project_installation_details_search_view" model="ir.ui.view">
        <field name="name">project.installation.details.search.view</field>
        <field name="model">installation.completion.detail</field>
        <field name="arch" type="xml">
            <search string="Installation Details search">
                <field name="is_goods_ordered"/>
                <field name="project_name"/>
                <field name="name"/>
                <filter string="Is Ordered" name="filter_is_goods_ordered" domain="[('is_goods_ordered', '=', True)]"/>
                <separator/>
                <group expand="0" string="Group By">
                    <filter string="Project" name="group_by_project" context="{'group_by': 'project_id'}"/>
                    <separator/>
                    <filter string="Service Name" name="group_by_name" context="{'group_by': 'name'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="project_installation_details_tree_view" model="ir.ui.view">
        <field name="name">project.installation.details.tree.view</field>
        <field name="model">installation.completion.detail</field>
        <field name="arch" type="xml">
            <tree string="Installation Details Tree" create="false" delete="false">
                <field name="project_id" column_invisible="1"/>
                <field name="project_name" string="Project"/>
                <button name="action_view_project" type="object" title="Journal Entry" icon="fa-arrow-right"/>
                <field name="name"/>
                <field name="expected_start_date"/>
                <field name="installation_completion_date"/>
                <field name="warranty_end_date"/>
                <field name="is_goods_ordered"/>
            </tree>
        </field>
    </record>

    <record id="action_project_installation_details" model="ir.actions.act_window">
        <field name="name">Project Installation Details</field>
        <field name="res_model">installation.completion.detail</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_group_by_project': 1}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Projects Service Details found!
            </p>
        </field>
    </record>

    <menuitem id="menu_project_project_installation_details"
              name="Installation Details"
              parent="project.menu_main_pm"
              action="action_project_installation_details"
              groups="project.group_project_manager"
              sequence="2"/>

    <record id="project.menu_project_management" model="ir.ui.menu">
        <field name="sequence">3</field>
        <field name="parent_id" ref="project.menu_main_pm"/>
    </record>

</odoo>
