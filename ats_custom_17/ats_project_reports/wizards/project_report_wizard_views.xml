<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="project_report_wizard_form_view" model="ir.ui.view">
        <field name="name">project.report.wizard.form</field>
        <field name="model">project.report.wizard</field>
        <field name="arch" type="xml">
            <form string="Project Report">
                <group>
                    <group>
                        <field name="period_type" readonly="1"/>
                    </group>
                    <group>
                        <label for="date_from" invisible="period_type != 'daily'" string="Date"/>
                        <label for="date_from" invisible="period_type == 'daily'" string="From Date"/>
                        <field name="date_from" required="1" force_save="1" nolabel="1" readonly="period_type not in ('daily', 'custom_period')"/>
                        <field name="date_to" required="1" invisible="period_type == 'daily'" readonly="period_type != 'custom_period'" force_save="1"/>
                        <field name="exclude_employee_ids" options="{'no_open': True, 'no_create': True}" force_save="1" widget="many2many_tags_avatar"/>
                    </group>
                </group>
                <footer>
                    <button name="action_print_excel" string="Print Excel" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_project_report_wizard" model="ir.actions.act_window">
        <field name="name">Project Reports</field>
        <field name="res_model">project.report.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_project_report_wizard"
              name="Project Reports"
              action="action_project_report_wizard"
              parent="project.menu_project_report"
              sequence="100"/>

</odoo>
