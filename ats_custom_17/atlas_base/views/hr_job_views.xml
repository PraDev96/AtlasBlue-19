<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_job_form_view_inherit1" model="ir.ui.view">
        <field name="name">hr.job.form.inherit</field>
        <field name="model">hr.job</field>
        <field name="inherit_id" ref="hr.view_hr_job_form"/>
        <field name="arch" type="xml">

            <field name="user_id" position="after">
                <field name="cc"/>
            </field>

        </field>
    </record>

    <!-- Encasement -->
    <record id="emp_leave_encasement_form_view_inherit" model="ir.ui.view">
        <field name="name">emp.leave.encasement.form.inherit</field>
        <field name="model">emp.leave.encashment</field>
        <field name="inherit_id" ref="hr_leave_encashment.emp_leave_encashment_form_view"/>
        <field name="arch" type="xml">

            <field name="adv_leave_amount" position="after">
                <field name="public_leave_amount" widget="monetary"/>
            </field>

        </field>
    </record>

</odoo>
