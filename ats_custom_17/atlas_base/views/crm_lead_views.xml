<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_view_form_inherit_altas_base" model="ir.ui.view">
        <field name="name">crm.lead.form.inherit.altas.base</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//notebook" position="inside">
                <page string="Facility" name="facility">
                    <field name="facility_ids">
                        <tree string="Facility">
                            <field name="name" optional="show"/>
                            <field name="location_id" domain="['|',('parent_id', '=', parent.partner_id), ('id','=',parent.partner_id)]"/>
                            <field name="facility_type" optional="show"/>
                            <field name="sale_order_id" optional="show"/>
                            <field name="system_type" optional="show"/>
                            <field name="water_surface" optional="show"/>
                            <field name="volume" optional="hide"/>
                            <field name="facility_project_id" optional="hide"/>
                            <field name="crm_lead_id" optional="hide"/>
                            <field name="facility_id" string="Facility config" optional="hide"/>
                            <field name="facility_type_id" optional="hide"/>
                        </tree>
                        <form string="Facility">
                            <group>
                                <field name="name"/>
                                <field name="location_id" domain="['|',('parent_id', '=', parent.partner_id), ('id','=',parent.partner_id)]"/>
                                <field name="facility_type"/>
                                <field name="facility_id"/>
                                <field name="facility_type_id"/>
                                <field name="system_type"/>
                                <field name="water_surface"/>
                                <field name="volume"/>
                            </group>
                        </form>
                    </field>
                </page>
            </xpath>

            <xpath expr="//group[@name='lead_partner']" position="before">
                <group>
                    <field name="quote_ref"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='tag_ids']" position="after">
                <field name="project_name"/>
                <field name="project_type_detail_id"/>
                <field name="opportunity_type"/>
            </xpath>

            <xpath expr="//field[@name='lost_reason_id']" position="after">
                <field name="lost_other_reason" invisible="active == True"/>
            </xpath>

            <xpath expr="//field[@name='opportunity_type']" position="after">
                <label for="service_duration" invisible="opportunity_type != 'service'"/>
                <div class="o_row no-gutters align-items-end">
                    <div class="col">
                        <div class="o_row">
                            <field name="service_duration" invisible="opportunity_type != 'service'"/>
                            <field name="no_of_day_type" invisible="opportunity_type != 'service'"/>
                        </div>
                    </div>
                </div>
            </xpath>

            <xpath expr="//h1" position="before">
                <h2><field name="crm_no" nolabel="1"/></h2>
            </xpath>

            <xpath expr="//field[@name='user_id']" position="before">
                <field name="lead_time_id"/>
                <field name="facility_type_ids" widget="many2many_tags"/>
            </xpath>

            <xpath expr="//group[@name='opportunity_partner']/field[@name='partner_id']" position="attributes">
                <attribute name="domain">[('parent_id', '=', False)]</attribute>
            </xpath>

        </field>
    </record>

    <record id="crm_lead_lost_view_form_inherit" model="ir.ui.view">
        <field name="name">crm.lead.lost.form.inherit</field>
        <field name="model">crm.lead.lost</field>
        <field name="inherit_id" ref="crm.crm_lead_lost_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='lost_reason_id']" position="after">
                <field name="other_reason"/>
            </xpath>

        </field>
    </record>

    <!-- ============================ CRM Week Days ============================ -->
    <record id="crm_week_days_view_tree" model="ir.ui.view">
        <field name="name">week.days.view.tree</field>
        <field name="model">week.days</field>
        <field name="arch" type="xml">
            <tree editable="bottom">
                <field name="day"/>
            </tree>
        </field>
    </record>

    <record id="crm_week_days_view_search" model="ir.ui.view">
        <field name="name">week.days.view.search</field>
        <field name="model">week.days</field>
        <field name="arch" type="xml">
            <search>
                <field name="day"/>
            </search>
        </field>
    </record>

    <record id="crm_week_days_action" model="ir.actions.act_window">
        <field name="name">Week Days</field>
        <field name="res_model">week.days</field>
        <field name="view_mode">tree</field>
    </record>

    <menuitem id="crm_days_menu_config"
              name="Week Days"
              action="crm_week_days_action"
              parent="crm.crm_menu_config"/>

</odoo>
