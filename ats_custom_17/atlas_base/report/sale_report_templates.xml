<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- This is for make visible the quantity only in the optional product table -->
    <template id="sale_report_templates_inherited" inherit_id="sale.report_saleorder_document">
        <xpath expr="//table[@name='table_optional_products']" position="replace">
            <table name="table_optional_products" class="table table-sm">
                <thead>
                    <tr>
                        <th name="th_option_name" class="text-left">Description</th>
                        <th name="th_quantity" class="text-right">Quantity</th>
                    </tr>
                </thead>
                <tbody class="sale_tbody">
                    <t t-set="current_subtotal" t-value="0"/>
                    <t t-foreach="doc.sale_order_option_ids" t-as="option">
                        <t t-set="current_subtotal" t-value="current_subtotal + option.price_subtotal" groups="account.group_show_line_subtotals_tax_excluded"/>
                        <t t-set="current_subtotal" t-value="current_subtotal + option.price_total" groups="account.group_show_line_subtotals_tax_included"/>
                        <tr t-att-class="'bg-200 font-weight-bold o_line_section' if option.display_type == 'line_section' else 'font-italic o_line_note' if option.display_type == 'line_note' else ''">
                            <t t-if="not option.display_type">
                                <td name="td_option_name"><span t-field="option.name"/></td>
                                <td name="td_quantity" class="text-right">
                                    <span t-field="option.product_uom_qty"/>
                                    <span t-field="option.uom_id"/>
                                </td>
                            </t>
                        </tr>
                        <t t-if="current_section and (option_last or doc.sale_order_option_ids[option_index+1].display_type == 'line_section')">
                            <tr class="is-subtotal text-right">
                                <td name="td_section_subtotal" colspan="99">
                                    <t t-if="current_section.id not in doc.so_option_ids.ids">
                                        <span t-esc="line_last"/>
                                        <strong class="mr16">Subtotal</strong>
                                        <span t-esc="current_subtotal"
                                              t-options="{&quot;widget&quot;: &quot;monetary&quot;, &quot;display_currency&quot;: doc.pricelist_id.currency_id}"/>
                                    </t>
                                </td>
                            </tr>
                        </t>
                    </t>
                </tbody>
            </table>

            <div class="clearfix" name="so_total_summary">
                <div id="total" class="row" name="total">
                    <div t-attf-class="#{'col-6' if report_type != 'html' else 'col-sm-7 col-md-6'} ml-auto">
                        <table class="table table-sm">
                            <tr class="border-black o_subtotal" style="">
                                <td name="td_amount_untaxed_label"><strong>Subtotal</strong></td>
                                <td name="td_amount_untaxed" class="text-right"><span t-field="doc.amount_untaxed_op"/></td>
                            </tr>
                            <tr class="border-black o_total">
                                <td name="td_amount_total_label"><strong>Total</strong></td>
                                <td name="td_amount_total" class="text-right"><span t-field="doc.amount_total_op"/></td>
                            </tr>
                        </table>
                    </div>
                </div>
            </div>

        </xpath>
    </template>

</odoo>
