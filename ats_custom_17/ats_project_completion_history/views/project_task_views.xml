<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_task_form2_inherit_completion_history" model="ir.ui.view">
        <field name="name">project.task.form.inherit.completion.history</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@name='button_box']" position="inside">
                <button class="oe_stat_button" name="action_view_completion_history" type="object" icon="fa-history" invisible="project_completion_history_count == 0">
                    <div class="o_stat_info">
                        <field name="project_completion_history_count"/>
                        <span class="o_stat_text">History</span>
                    </div>
                </button>
            </xpath>
            <xpath expr="//field[@name='user_ids']" position="attributes">
                <attribute name="required">weightage</attribute>
            </xpath>
            <xpath expr="//notebook" position="inside">
                <page name="project_completion_history_line" string="Project Completion History">
                    <field name='completion_history_ids' mode="tree" readonly="1">
                        <tree>
                            <field name="track_date"/>
                            <field name="project_id"/>
                            <field name="project_total_so_amount" optional="hide"/>
                            <field name="project_value_amount" optional="hide"/>
                            <field name="project_subtotal_amount"/>
                            <field name="task_progress" optional="hide"/>
                            <field name="user_id"/>
                            <field name="old_completion"/>
                            <field name="new_completion"/>
                            <field name="difference" sum="Total Difference(%)" decoration-success="difference &gt; 0" decoration-danger="difference &lt; 0"/>
                            <field name="weightage_pulling_amount" sum="Total Pulled Amount"
                                   decoration-success="weightage_pulling_amount &gt; 0" decoration-danger="weightage_pulling_amount &lt; 0"/>
                        </tree>
                    </field>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
