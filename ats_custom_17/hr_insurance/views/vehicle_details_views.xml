<?xml version='1.0' encoding='UTF-8'?>
<odoo>

    <record id='vehicle_model_view_form' model='ir.ui.view'>
        <field name="name">vehicle.model.form</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <form string="Motor">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="model_year"/>
                    </group>
                    <group>
                        <field name="make_id"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id='vehicle_model_view_tree' model='ir.ui.view'>
        <field name="name">vehicle.model.tree</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <tree string="Vehicle">
                <field name="name"/>
                <field name="make_id"/>
                <field name="model_year"/>
            </tree>
        </field>
    </record>

    <record id="vehicle_model_view_search" model="ir.ui.view">
        <field name="name">vehicle.model.search</field>
        <field name="model">vehicle.model</field>
        <field name="arch" type="xml">
            <search string="Models">
                <field name="name"/>
                <field name="make_id"/>
                <field name="model_year"/>
            </search>
        </field>
    </record>

    <record id='vehicle_model_action' model='ir.actions.act_window'>
        <field name="name">Vehicle Model</field>
        <field name="res_model">vehicle.model</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="vehicle_model_action_menu"
              action="vehicle_model_action"
              parent="sale.menu_sale_config"
              sequence="10"/>


    <!-- Vehicle Type -->
    <record id='vehicle_make_view_form' model='ir.ui.view'>
        <field name="name">vehicle.make.form</field>
        <field name="model">vehicle.make</field>
        <field name="arch" type="xml">
            <form string="Vehicle Type">
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="image" widget="image"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id='vehicle_make_view_tree' model='ir.ui.view'>
        <field name="name">vehicle.make.tree</field>
        <field name="model">vehicle.make</field>
        <field name="arch" type="xml">
            <tree string="Vehicle Type">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id='vehicle_type_action' model='ir.actions.act_window'>
        <field name="name">Vehicle Make</field>
        <field name="res_model">vehicle.make</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="vehicle_make_action_menu"
              name="Vehicle Make"
              action="vehicle_type_action"
              parent="sale.menu_sale_config"
              sequence="20"/>


    <!-- DBdy Style -->
    <record id='vehicle_bodystyle_view_form' model='ir.ui.view'>
        <field name="name">vehicle.bodystyle.form</field>
        <field name="model">vehicle.bodystyle</field>
        <field name="arch" type="xml">
            <form string="Vehicle Body-Style">
                <group>
                    <group>
                        <field name="name"/>
                    </group>
                    <group>
                        <field name="make_id"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id='vehicle_bodystyle_view_tree' model='ir.ui.view'>
        <field name="name">vehicle.bodystyle.tree</field>
        <field name="model">vehicle.bodystyle</field>
        <field name="arch" type="xml">
            <tree string="vehicle Bodystyle">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id='vehicle_bodystyle_action' model='ir.actions.act_window'>
        <field name="name">Vehicle Bodystyle</field>
        <field name="res_model">vehicle.bodystyle</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="motor_bodystyle"
              name="Vehicle Bodystyle"
              action="vehicle_bodystyle_action"
              parent="sale.menu_sale_config"
              sequence="30"/>


    <!-- Motor Vehicle -->
    <menuitem id="motor_vehicle_main"
              name="Vehicles"
              parent="sale.sale_menu_root"
              sequence="2"/>

    <record id='motor_vehicle_view_form' model='ir.ui.view'>
        <field name="name">motor.vehicle.form</field>
        <field name="model">motor.vehicle</field>
        <field name="arch" type="xml">
            <form string="Vehicle">
                <group>
                    <group>
                        <field name="name"/>
                        <field name="make_id" string="Make"/>
                        <field name="model_id" domain="[('make_id', '=', make_id)]" required="True"/>
                        <field name="partner_id"/>
                        <field name="fleet_vehicle_id"/>
                        <field name="active" invisible="1"/>
                    </group>
                    <group>
                        <field name="vin"/>
                        <field name="chasis_no"/>
                        <field name="bodystyle_id" domain="[('make_id', '=', make_id)]"/>
                        <field name="manufacture_year"/>
                        <field name="image" widget='image' class="oe_avatar"/>
                    </group>
                </group>
            </form>
        </field>
    </record>

    <record id='motor_vehicle_view_tree' model='ir.ui.view'>
        <field name="name">motor.vehicle.tree</field>
        <field name="model">motor.vehicle</field>
        <field name="arch" type="xml">
            <tree string="Vehicle">
                <field name="name"/>
                <field name="chasis_no"/>
                <field name="model_id"/>
                <field name="make_id"/>
                <field name="manufacture_year"/>
                <field name="partner_id"/>
                <field name="fleet_vehicle_id"/>
            </tree>
        </field>
    </record>

    <record id="motor_vehicle_view_search" model="ir.ui.view">
        <field name="name">motor.vehicle.search</field>
        <field name="model">motor.vehicle</field>
        <field name="arch" type="xml">
            <search string="Vehicles">
                <field name="name"/>
                <field name="chasis_no"/>
                <field name="model_id"/>
                <field name="make_id"/>
                <field name="partner_id"/>
                <field name="fleet_vehicle_id"/>
                <separator string="Archived">
                    <field name="active"/>
                </separator>
                <group expand="0" string="Group By">
                    <filter string="Archived" name="active" domain="[]" context="{'group_by': 'active'}"/>
                    <filter string="Model" name="model_id" domain="[]" context="{'group_by': 'model_id'}"/>
                    <filter string="Make" name="make_id" domain="[]" context="{'group_by': 'make_id'}"/>
                    <filter string="Partner" name="partner_id" domain="[]" context="{'group_by': 'partner_id'}"/>
                    <filter string="Fleet Vehicle" name="fleet_vehicle_id" domain="[]" context="{'group_by': 'fleet_vehicle_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id='motor_vehicle_action' model='ir.actions.act_window'>
        <field name="name">Vehicles</field>
        <field name="res_model">motor.vehicle</field>
        <field name="view_mode">tree,form</field>
    </record>

    <!-- <menuitem action="motor_vehicle_action" parent="motor_vehicle_main" id="motor_vehicle_action_menu" /> -->

    <!-- <menuitem action="motor_vehicle_action" name="Motor Vehicles" parent="fleet.fleet_vehicles" id="fleet_motor_vehicle_action_menu" /> -->

</odoo>
