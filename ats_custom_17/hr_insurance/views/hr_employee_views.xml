<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <record id="employee_contract_form_view" model="ir.ui.view">
        <field name="name">employee.contract.type.form</field>
        <field name="model">employee.contract.type</field>
        <field name="arch" type="xml">
            <form string="Contract Type">
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="employee_contract_tree_view" model="ir.ui.view">
        <field name="name">employee.contract.tree</field>
        <field name="model">employee.contract.type</field>
        <field name="arch" type="xml">
            <tree string="Contract Type">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_employee_contract_type" model="ir.actions.act_window">
        <field name="name">Contract Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">employee.contract.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="employee_contract_type_menu"
              parent="hr.menu_human_resources_configuration"
              action="action_employee_contract_type"
              sequence="5"/>


    <!-- Hiring Type -->
    <record id="hiring_type_form_view" model="ir.ui.view">
        <field name="name">hiring.type.form</field>
        <field name="model">hiring.type</field>
        <field name="arch" type="xml">
            <form string="Hiring Type">
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="hiring_type_tree_view" model="ir.ui.view">
        <field name="name">hiring.type.tree</field>
        <field name="model">hiring.type</field>
        <field name="arch" type="xml">
            <tree string="Hiring Type">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_hiring_type" model="ir.actions.act_window">
        <field name="name">Hiring Type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">hiring.type</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="hiring_type_menu"
              parent="hr.menu_human_resources_configuration"
              action="action_hiring_type"
              sequence="5"/>


    <!-- Employee -->
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">
            <field name="company_assets" position="after">
                <!--<field name="contract_type_id"/>-->
                <field name="hiring_type_id"/>
                <field name="departure_date" invisible="1"/>
                <field name="resume_work_date" invisible="1"/>
            </field>

        </field>
    </record>

    <record id="payroll_hr_employee_form_inherit" model="ir.ui.view">
        <field name="name">payroll.hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr_payroll.payroll_hr_employee_view_form"/>
        <field name="arch" type="xml">

            <field name="registration_number" position="after">
                <label for="is_suspended"/>
                <div>
                    <field name="is_suspended" readonly="True"/>
                    <button name="action_suspend" string="Suspend" type="object" invisible="is_suspended == True"/>
                    <button name="action_resume" string="Resume" type="object" invisible="is_suspended != True"/>
                </div>
            </field>
        </field>
    </record>

</odoo>
