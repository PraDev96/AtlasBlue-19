<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <data>

        <!-- Sequences for hr.claim -->
        <record id="seq_hr_claim" model="ir.sequence">
            <field name="name">Claim</field>
            <field name="code">hr.claim</field>
            <field name="prefix">CLAIM/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_hr_insurance" model="ir.sequence">
            <field name="name">Insurance</field>
            <field name="code">hr.insurance</field>
            <field name="prefix">INS/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

    </data>
</odoo>
