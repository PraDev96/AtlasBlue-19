<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_claim_confirm_wizard_form" model="ir.ui.view">
        <field name="name">claim.confirm.wizard.form</field>
        <field name="model">claim.confirm.wizard</field>
        <field name="arch" type="xml">

            <form string="Claim Confirm">
                <span class="o_form_label">Warning: Are you sure want to make claim confirm?</span>
                <footer>
                    <button string="Confirm" name="action_confirm" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <!--<act_window id="action_claim_confirm_wizard"
                name="Claim Confirm"
                res_model="claim.confirm.wizard"
                binding_model="hr.claim"
                binding_views="list"
                view_mode="form"
                target="new"/>-->

    <record id="action_claim_confirm_wizard" model="ir.actions.act_window">
        <field name="name">Claim Confirm</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">claim.confirm.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
