<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_claim_done_wizard_form" model="ir.ui.view">
        <field name="name">claim.done.wizard.form</field>
        <field name="model">claim.done.wizard</field>
        <field name="arch" type="xml">
            <form string="Claim Done">
                <span class="o_form_label">Warning: Are you sure want to make claim done?</span>
                <footer>
                    <button string="Done" name="action_done" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--<act_window id="action_claim_done_wizard"
                name="Claim Done"
                res_model="claim.done.wizard"
                binding_model="hr.claim"
                binding_views="list"
                view_mode="form"
                target="new"/>-->

    <record id="action_claim_done_wizard" model="ir.actions.act_window">
        <field name="name">Claim Done</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">claim.done.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
