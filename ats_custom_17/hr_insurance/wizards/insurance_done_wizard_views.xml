<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_insurance_done_wizard_form" model="ir.ui.view">
        <field name="name">insurance.done.wizard.form</field>
        <field name="model">insurance.done.wizard</field>
        <field name="arch" type="xml">
            <form string="Insurance Done">
                <span class="o_form_label">Warning: Are you sure want to make insurance done?</span>
                <footer>
                    <button string="Done" name="action_done" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--<act_window
        name="Insurance Done"
        id="action_insurance_done_wizard"
        res_model="insurance.done.wizard"
        binding_model="hr.insurance"
        binding_views="list"
        view_mode="form"
        target="new"/>-->

    <record id="action_insurance_done_wizard" model="ir.actions.act_window">
        <field name="name">Insurance Done</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">insurance.done.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
