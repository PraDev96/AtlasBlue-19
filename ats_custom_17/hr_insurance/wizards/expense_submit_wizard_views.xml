<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_expense_submit_wizard_form" model="ir.ui.view">
        <field name="name">expense.submit.wizard.form</field>
        <field name="model">expense.submit.wizard</field>
        <field name="arch" type="xml">
            <form string="Insurance Done">
                <span class="o_form_label">Warning: Are you sure want to Submit Expenses?</span>
                <footer>
                    <button string="Submit" name="action_submit" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--<act_window id="action_expense_submit_wizard"
                name="Expense Submit"
                res_model="expense.submit.wizard"
                binding_model="hr.expense"
                binding_views="list"
                view_mode="form"
                target="new"/>-->

    <record id="action_expense_submit_wizard" model="ir.actions.act_window">
        <field name="name">Expense Submit</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">expense.submit.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
