<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- This is for Project Settings -->
    <record id="res_config_settings_project_inherit_timesheet_limit" model="ir.ui.view">
        <field name="name">res.config.settings.project.inherit.timesheet.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="project.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='log_time_tasks_setting']" position="after">
                <setting id="timesheet_daily_limit_setting" string="Timesheet Daily Limit" help="Set a Maximum Daily Limit for Timesheet Entries">
                    <field name="use_timesheet_daily_limit"/>
                    <div class="content-group" invisible="not use_timesheet_daily_limit">
                        <div class="mt16">
                            <label for="timesheet_daily_limit" string="Max Hours per Day"/>
                            <field name="timesheet_daily_limit" widget="timesheet_uom" class="w-25 text-center oe_inline"/>
                            <span>Hours</span>
                        </div>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>

    <!-- This is for Timesheet Settings -->
    <record id="res_config_settings_hr_timesheet_inherit_timesheet_limit" model="ir.ui.view">
        <field name="name">res.config.settings.hr_timesheet.inherit.timesheet.limit</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="hr_timesheet.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='reminder_allow']" position="after">
                <setting id="timesheet_daily_limit_setting" string="Timesheet Daily Limit" help="Set a Maximum Daily Limit for Timesheet Entries">
                    <field name="use_timesheet_daily_limit"/>
                    <div class="content-group" invisible="not use_timesheet_daily_limit">
                        <div class="mt16">
                            <label for="timesheet_daily_limit" string="Max Hours per Day"/>
                            <field name="timesheet_daily_limit" widget="timesheet_uom" class="w-25 text-center oe_inline"/>
                            <span>Hours</span>
                        </div>
                    </div>
                </setting>

            </xpath>
        </field>
    </record>

</odoo>
