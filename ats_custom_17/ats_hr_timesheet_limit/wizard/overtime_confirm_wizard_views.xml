<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="timesheet_confirm_overtime_hours_view_form" model="ir.ui.view">
        <field name="name">timesheet.confirm.overtime.wizard.view.form</field>
        <field name="model">timesheet.overtime.confirm.wizard</field>
        <field name="arch" type="xml">
            <form string="Confirm Overtime Hours Form">
                <group>
                    <field name="analytic_line_id" invisible="1"/>
                    <field name="overtime_hours" widget="timesheet_uom"/>
                </group>
                <footer>
                    <button name="action_confirm_overtime" string="Submit" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

</odoo>
