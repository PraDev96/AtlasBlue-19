<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_sponser_form" model="ir.ui.view">
        <field name="name">fleet.sponser.form</field>
        <field name="model">fleet.sponser</field>
        <field name="arch" type="xml">
            <form string="Sponser">
                <group>
                    <field name="name"/>
                </group>
            </form>
        </field>
    </record>

    <record id="view_fleet_sponser_tree" model="ir.ui.view">
        <field name="name">fleet.sponser.tree</field>
        <field name="model">fleet.sponser</field>
        <field name="field_parent"></field>
        <field name="arch" type="xml">
            <tree string="Sponser">
                <field name="name"/>
            </tree>
        </field>
    </record>

    <record id="action_fleet_sponser" model="ir.actions.act_window">
        <field name="name">Sponsers</field>
        <field name="res_model">fleet.sponser</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_action_fleet_sponser"
              name="Sponsers"
              action="action_fleet_sponser"
              parent="fleet.fleet_configuration" sequence="10"/>

</odoo>
