<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_fleet_restaurant_form" model="ir.ui.view">
        <field name="name">fleet.restaurant.form</field>
        <field name="model">fleet.restaurant</field>
        <field name="arch" type="xml">
            <form string="Restaurant">
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="restaurant_id"/>
                            <field name="company_id"/>
                        </group>
                        <group>
                            <field name="location"/>
                            <field name="project_id"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_fleet_restaurant_tree" model="ir.ui.view">
        <field name="name">fleet.restaurant.tree</field>
        <field name="model">fleet.restaurant</field>
        <field name="arch" type="xml">
            <tree string="Restaurant">
                <field name="name"/>
                <field name="location"/>
                <field name="restaurant_id"/>
                <field name="project_id"/>
                <field name="company_id"/>
            </tree>
        </field>
    </record>

    <record id="action_fleet_restaurant" model="ir.actions.act_window">
        <field name="name">Restaurants</field>
        <field name="res_model">fleet.restaurant</field>
        <field name="view_mode">tree,form</field>
    </record>


    <!-- <menuitem name="Restaurants" parent="project.menu_main_pm" id="menu_parent_fleet_restaurant"/> -->

    <!-- <menuitem action="action_fleet_restaurant" id="menu_action_fleet_restaurant" name="Restaurants" parent="menu_parent_fleet_restaurant" sequence="10"/> -->

</odoo>
