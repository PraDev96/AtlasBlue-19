<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_remove_employee_wizard_form" model="ir.ui.view">
        <field name="name">remove.employee.wizard.form</field>
        <field name="model">remove.employee.wizard</field>
        <field name="arch" type="xml">

            <form string="Remove Employees">
                <group>
                    <field name="end_date"/>
                    <field name="project_id" invisible="1"/>
                    <field name="employee_ids" widget="many2many_tags" context="{'from_project_id': project_id}"/>
                </group>
                <footer>
                    <button string="Remove Employee" name="remove_employee" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_remove_employee_wizard" model="ir.actions.act_window">
        <field name="name">Remove Employees Wizard</field>
        <field name="res_model">remove.employee.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
