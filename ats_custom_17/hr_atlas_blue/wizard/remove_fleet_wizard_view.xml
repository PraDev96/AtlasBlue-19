<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_remove_fleet_wizard_form" model="ir.ui.view">
        <field name="name">remove.fleet.wizard.form</field>
        <field name="model">remove.fleet.wizard</field>
        <field name="arch" type="xml">

            <form string="Remove Fleet">
                <group>
                    <field name="end_date"/>
                    <field name="project_id" invisible="1"/>
                    <field name="fleet_ids" widget="many2many_tags" context="{'from_project_id': project_id}"/>
                </group>
                <footer>
                    <button string="Remove Fleet" name="remove_fleet" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_remove_fleet_wizard" model="ir.actions.act_window">
        <field name="name">Remove Fleet Wizard</field>
        <field name="res_model">remove.fleet.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
