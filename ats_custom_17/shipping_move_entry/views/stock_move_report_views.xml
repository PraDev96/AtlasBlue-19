<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="stock_move_line_search_inherit_picking_code" model="ir.ui.view">
        <field name="name">stock.move.line.search.inherit.picking_code</field>
        <field name="model">stock.move.line</field>
        <field name="inherit_id" ref="stock.stock_move_line_view_search"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='by_picking']" position="after">
                <filter string="Transfer Type" name="by_picking_code" domain="[]" context="{'group_by': 'picking_code'}"/>
            </xpath>


        </field>
    </record>

</odoo>
