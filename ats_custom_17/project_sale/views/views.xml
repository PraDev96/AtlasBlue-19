<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="account_move_project_field" model="ir.ui.view">
        <field name="name">account.move.form.customized</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[hasclass('o_col')]" position="after">
                <field name="project_id" domain="[('partner_id', '=', partner_id)]"
                       readonly="state != 'draft'" options="{'no_quick_create': True, 'no_create_edit': True}"/>
            </xpath>

        </field>
    </record>

    <record id="stock_picking_field" model="ir.ui.view">
        <field name="name">stock.picking.form.customized</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">

            <field name="origin" position="after">
                <field name="project_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
                <field name="account_analytic_id" options="{'no_quick_create': True, 'no_create_edit': True}"/>
            </field>

        </field>
    </record>

    <record id="act_purchase_order_open_all" model="ir.actions.act_window">
        <field name="name">RFQ and Purchases</field>
        <field name="res_model">purchase.order</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a RFQ, the first step of a new sale.
            </p>
            <p>Your next actions should flow efficiently: confirm the RFQ to a Sales Order, then create the Invoice and collect the Payment.</p>
        </field>
    </record>

    <record id="purchase_order_form_project_field" model="ir.ui.view">
        <field name="name">purchase.order.form.v.customized</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="project_id" domain="[('partner_id', '=', partner_id)]"
                       readonly="state not in ('draft', 'sent')" options="{'no_quick_create': True, 'no_create_edit': True}"/>
            </field>

        </field>
    </record>

    <record id="act_sale_order_open_all" model="ir.actions.act_window">
        <field name="name">Quotations and Sales</field>
        <field name="res_model">sale.order</field>
        <field name="view_mode">tree,form,graph</field>
        <field name="groups_id" eval="[(4, ref('sales_team.group_sale_salesman'))]"/>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Create a Quotation, the first step of a new sale.
            </p>
            <p>Your next actions should flow efficiently: confirm the Quotation to a Sales Order, then create the Invoice and collect the Payment.</p>
        </field>
    </record>

    <record id="view_order_form_project_field" model="ir.ui.view">
        <field name="name">sale.order.form.v.customized</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">

            <field name="partner_id" position="after">
                <field name="project_id" domain="[('partner_id', '=', partner_id)]" options="{'no_quick_create': True, 'no_create_edit': True}"/>
            </field>
            <field name="medium_id" position="attributes">
                <attrbute name="invisible">1</attrbute>
            </field>

        </field>
    </record>

</odoo>
