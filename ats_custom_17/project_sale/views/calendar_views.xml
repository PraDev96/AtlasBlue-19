<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_calendar_event_form" model="ir.ui.view">
        <field name="name">calendar.event.form.v.customized</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_form"/>
        <field name="arch" type="xml">

            <field name="location" position="after">
                <field name="project_id" options="{'no_create': True, 'no_edit': True}"/>
                <field name="type_of_project_id"/>
                <field name="task_id" readonly="1" force_save="1"/>
                <field name="partner_id" string="Customer"/>
                <field name="team_id"/>
                <field name="user_id" string="Team Leader"/>
            </field>

        </field>
    </record>

    <record id="calendar_event_view_search_inherit_1" model="ir.ui.view">
        <field name="name">calendar.event.search.inherit.appointment</field>
        <field name="model">calendar.event</field>
        <field name="inherit_id" ref="calendar.view_calendar_event_search"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='responsible']" position="after">
                <separator/>
                <filter string="Project Type" name="type_of_project_id" domain="[]" context="{'group_by': 'type_of_project_id'}"/>
            </xpath>

        </field>
    </record>

    <record id="action_create_task_from_calendar_event" model="ir.actions.server">
        <field name="name">Create Task</field>
        <field name="model_id" ref="project_sale.model_calendar_event"/>
        <field name="binding_model_id" ref="project_sale.model_calendar_event"/>
        <field name="state">code</field>
        <field name="code">action = records.create_task_from_calendar_event()</field>
    </record>

</odoo>
