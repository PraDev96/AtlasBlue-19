<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Employee -->
    <record id="view_employee_form_inherit" model="ir.ui.view">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_hr_employee_penalty" class="oe_stat_button" type="object" icon="fa-task" groups="hr_penalty.group_penalty_user">
                    <div class="o_stat_info">
                        <field name="penalty_count"/>
                        <span class="o_stat_text"> Penalty </span>
                    </div>
                </button>
            </xpath>

            <xpath expr="//page[@name='hr_settings']" position="after">
                <page string="Penalty" invisible="1"> <!-- groups="hr_penalty.group_penalty_user" -->
                    <field name="penalty_ids">
                        <tree string="Penalty">
                            <field name="name"/>
                            <field name="date_penalty"/>
                            <field name="warning_type"/>
                            <field name="amount"/>
                            <field name="deducted_payslip"/>
                            <field name="state"/>
                        </tree>
                    </field>
                </page>
            </xpath>

        </field>
    </record>

</odoo>
