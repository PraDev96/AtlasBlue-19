<?xml version="1.0" encoding="utf-8" ?>
<odoo>

    <record id="attachment_tree_inherit_project_name" model="ir.ui.view">
        <field name="name">attachment.tree.inherit.project_name</field>
        <field name="model">ir.attachment</field>
        <field name="inherit_id" ref="base.view_attachment_tree"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='res_id']" position="after">
                <field name="project_name"/>
                <field name="project_task_state"/>
            </xpath>

        </field>
    </record>

    <record id="my_attachments_view_search" model="ir.ui.view">
        <field name="name">my.attachments.view.search</field>
        <field name="model">ir.attachment</field>
        <field name="mode">primary</field>
        <field name="arch" type="xml">

            <search string="Search Attachment">
                <filter string="My Attachment" domain="[('create_uid', '=', uid)]" name="my_attachment_filter"/>
            </search>

        </field>
    </record>

    <record id="action_my_attachments" model="ir.actions.act_window">
        <field name="name">My Attachments</field>
        <field name="res_model">ir.attachment</field>
        <field name="view_mode">tree,form</field>
        <field name="context">{'search_default_my_attachment_filter': 1}</field>
        <field name="domain">[('mimetype', 'not in', ('application/xml', 'application/javascript', 'text/calendar', 'text/css', 'text/plain', 'text/scss'))]</field>
        <field name="search_view_id" ref="my_attachments_view_search"/>
    </record>

    <menuitem id="menu_my_attachments"
              name="My Attachments"
              action="action_my_attachments"
              groups="base.group_user"
              parent="contacts.menu_contacts"/>

</odoo>
