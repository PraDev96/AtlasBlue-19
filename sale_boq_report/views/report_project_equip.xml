<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <template id="report_project_equip">
        <t t-call="web.external_layout">
            <t t-set="doc" t-value="doc.with_context(lang=doc.partner_id.lang)"/>
            <t t-set="address">
                <div t-field="doc.partner_id"
                     t-options='{"widget": "contact", "fields": ["address", "name"], "no_marker": True}'/>
                <p t-if="doc.partner_id.vat"><t t-esc="doc.company_id.country_id.vat_label or 'Tax ID'"/>:
                    <span t-field="doc.partner_id.vat"/>
                </p>
            </t>

            <div class="page">
                <div class="oe_structure"/>

                <h2 class="mt16">
                    <span t-field="doc.name"/>
                </h2>

                <table class="table table-sm o_main_table">
                    <thead style="display: table-row-group">
                        <tr>
                            <th>Sr Number</th>
                            <th name="th_description">Name</th>
                            <th name="th_quantity">Description</th>
                            <th>Source</th>
                            <th>Facility</th>
                            <th>Installation Date</th>
                            <th name="th_description">Warranty Start Date</th>
                            <th name="th_quantity">Warranty End Date</th>
                            <th>Contract Number</th>
                            <th name="th_description">Issue Number</th>
                            <th name="th_quantity">Vendor</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody class="sale_tbody">
                        <t t-foreach="doc.equipment_ids" t-as="line">
                            <tr>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.sr_number"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.name"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.description"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.source"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.facility_id"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.installation_date"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.warranty_start_date"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.warranty_end_date"/>
                                </td>
                                <td class="text-right" style="border-right: 1px solid black;">
                                    <span t-field="line.contract_number"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.issue_number"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.partner_id"/>
                                </td>
                                <td style="border-right: 1px solid black;">
                                    <span t-field="line.status"/>
                                </td>
                            </tr>
                        </t>
                    </tbody>
                </table>

            </div>
        </t>
    </template>

    <template id="report_project_equip_tmpl">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="doc">
                <t t-call="sale_boq_report.report_project_equip" t-lang="doc.partner_id.lang"/>
            </t>
        </t>
    </template>

</odoo>
