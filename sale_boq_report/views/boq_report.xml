<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="paperformat_boq" model="report.paperformat">
        <field name="name">A4 - Boq</field>
        <field name="default" eval="True"/>
        <field name="format">A4</field>
        <field name="page_height">0</field>
        <field name="page_width">0</field>
        <field name="orientation">Portrait</field>
        <field name="margin_top">55</field>
        <field name="margin_bottom">15</field>
        <field name="margin_left">7</field>
        <field name="margin_right">7</field>
        <field name="header_line" eval="False"/>
        <field name="header_spacing">50</field>
        <field name="dpi">90</field>
    </record>

    <record id="action_report_saleorder_print" model="ir.actions.report">
        <field name="name">Bill Of Quantity</field>
        <field name="model">sale.order</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_boq_report.report_saleorder_print</field>
        <field name="report_file">sale_boq_report.report_saleorder_print</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Bill Of Quantity - %s' % (object.name)) or 'Bill Of Quantity - %s' % (object.name)</field>
        <field name="binding_model_id" ref="sale.model_sale_order"/>
        <field name="binding_type">report</field>
        <field name="paperformat_id" ref="sale_boq_report.paperformat_boq"/>
    </record>

    <record id="action_report_project_boq_tmpl" model="ir.actions.report">
        <field name="name">Bill Of Quantity</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_boq_report.report_project_boq_tmpl</field>
        <field name="report_file">sale_boq_report.report_project_boq_tmpl</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Bill Of Quantity - %s' % (object.name)) or 'Bill Of Quantity - %s' % (object.name)</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
    </record>

    <record id="action_report_project_equip_tmpl" model="ir.actions.report">
        <field name="name">Equipments</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">sale_boq_report.report_project_equip_tmpl</field>
        <field name="report_file">sale_boq_report.report_project_equip_tmpl</field>
        <field name="print_report_name">(object.state in ('draft', 'sent') and 'Equipments - %s' % (object.name)) or 'Equipments - %s' % (object.name)</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
