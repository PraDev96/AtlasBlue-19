<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Contract Template -->
    <record id='view_contract_template_tree' model='ir.ui.view'>
        <field name='name'>view.contract.template.tree</field>
        <field name='model'>contract.template</field>
        <field name='arch' type='xml'>

            <tree string='Contract Template'>
                <field name='name'/>
            </tree>

        </field>
    </record>

    <record id='view_contract_template_form' model="ir.ui.view">
        <field name="name">view.contract.template.form</field>
        <field name="model">contract.template</field>
        <field name="arch" type="xml">

            <form string="Contract Template">
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="toggle_active" type="object" class="oe_stat_button" icon="fa-archive">
                            <field name="active" widget="boolean_button" options="{'terminology': 'archive'}"/>
                        </button>
                    </div>
                    <group>
                        <field name="name" required="True"/>
                        <field name="body" required="True"/>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <record id="action_contract_template" model="ir.actions.act_window">
        <field name="name">Contract Template</field>
        <field name="res_model">contract.template</field>
        <field name="view_mode">tree,form</field>
    </record>

    <menuitem id="menu_sale_contract_tmpl"
              name="Contract Template"
              action="action_contract_template"
              parent="sale.menu_sale_config"
              sequence="20"/>


    <!-- Sale Contract -->
    <record id='view_sale_contract_tree' model='ir.ui.view'>
        <field name='name'>view.sale.contract.tree</field>
        <field name='model'>sale.contract</field>
        <field name='arch' type='xml'>

            <tree string='Contract Template'>
                <field name='sale_order_id'/>
                <field name="contract_template_id"/>
                <field name="write_uid"/>
                <field name="write_date"/>
            </tree>

        </field>
    </record>

    <record id='view_sale_contract_form' model="ir.ui.view">
        <field name="name">view.sale.contract.form</field>
        <field name="model">sale.contract</field>
        <field name="arch" type="xml">

            <form string="Contract Template">
                <header>
                    <button name="action_print_contract" string="Print" type="object" class="oe_highlight"/>
                </header>
                <sheet>
                    <group>
                        <field name="sale_order_id" options="{'no_create': True}" required="True"/>
                        <field name="contract_template_id"/>
                        <field name="body" required="True"/>
                    </group>
                </sheet>
            </form>

        </field>
    </record>

    <record id="view_sale_contract_filter" model="ir.ui.view">
        <field name="name">view.sale.contract.search</field>
        <field name="model">sale.contract</field>
        <field name="arch" type="xml">

            <search string="Search Move">
                <group expand="0" string="Group By">
                    <filter string="Sale Order" name="sale_order" domain="[]" context="{'group_by':'sale_order_id'}"/>
                </group>
            </search>

        </field>
    </record>

    <record id="action_sale_contract" model="ir.actions.act_window">
        <field name="name">Sale Contract</field>
        <field name="res_model">sale.contract</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_sale_contract_filter"/>
    </record>

    <menuitem id="menu_sale_contract"
              name="Sale Contract"
              action="action_sale_contract"
              parent="sale.sale_order_menu"
              groups="sales_team.group_sale_manager"
              sequence="100"/>


    <record id="contract_report_action" model="ir.actions.report">
        <field name="name">Contract Report</field>
        <field name="model">sale.contract</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">project_contract_tmpl.report_sale_contract</field>
        <field name="report_file">project_contract_tmpl.report_sale_contract</field>
        <field name="print_report_name">'Project-Sale Contract'</field>
    </record>

    <!-- Contract Template -->
    <template id="report_sale_contract">
        <t t-call="web.html_container">
            <t t-call="web.external_layout">
                <div class="page">
                    <t t-foreach="docs" t-as="contract">
                        <t t-set="lang" t-value="contract.sale_order_id.partner_id.lang or contract.sale_order_id.company_id.partner_id.lang"/>
                        <p t-raw="contract.body"/>
                    </t>
                </div>
            </t>
        </t>
    </template>

</odoo>
