<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Checklist Form Inherited for Civil/Mechanical Checklist fields -->
    <record id="project_checklist_form_inherit_civil_checklist" model="ir.ui.view">
        <field name="name">project.checklist.form.inherit.civil.checklist</field>
        <field name="model">project.checklist</field>
        <field name="inherit_id" ref="atlas_checklist.project_checklist_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="attributes">
                <attribute name="edit">1</attribute>
            </xpath>
            <xpath expr="//group[1]" position="before">
                <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                <div class="oe_title">
                    <h1>
                        <field name="name" readonly="1"/>
                    </h1>
                </div>
            </xpath>

            <xpath expr="//sheet" position="before">
                <header>
                    <field name="state" invisible="1"/>
                    <field name="active" invisible="1"/>
                    <field name="checklist_type" invisible="1"/>
                    <button name="action_checklist_validate" data-hotkey="v" string="Approve"
                            invisible="state != 'draft' or checklist_type == 'service' or not active" type="object"
                            class="btn-primary" groups="ats_civil_project_checklist.group_civil_project_checklist_approval"/>
                    <button name="action_print_civil_checklist" data-hotkey="v" string="Print Checklist" type="object"
                            class="btn-primary" invisible="state != 'validate' or checklist_type == 'service' or not active"/>
                    <button name="action_checklist_reset_to_draft" string="Reset to Draft"
                            type="object" invisible="state == 'draft' or checklist_type == 'service' or not active"
                            data-hotkey="d" groups="ats_civil_project_checklist.group_civil_project_checklist_approval"/>
                    <field name="state" widget="statusbar" invisible="not active or checklist_type == 'service'"/>
                </header>
            </xpath>

            <xpath expr="//field[@name='projects_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='task_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='date']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='employee_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <xpath expr="//group[@name='swimming_pool']" position="replace">
                <group name="swimming_pool" string="Swimming Pool" invisible="checklist_type != 'service'">
                    <field name="vacuum_pool" readonly="1"/>
                    <field name="brush_pool" readonly="1"/>
                    <field name="skim_pool" readonly="1"/>
                    <field name="clean_skimmer_overflow" readonly="1"/>
                    <field name="clean_deck_area" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='machine_room']" position="replace">
                <group name="machine_room" string="Machine Room" invisible="checklist_type != 'service'">
                    <field name="back_wash_filter_before" readonly="1"/>
                    <field name="back_wash_filter_after" readonly="1"/>
                    <field name="clean_pump_strainer" readonly="1"/>
                    <field name="clean_machine_room" readonly="1"/>
                    <field name="clean_balance_tank" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='water_chemistry']" position="replace">
                <group name="water_chemistry" string="Water Chemistry" invisible="checklist_type != 'service'">
                    <field name="water_temperature" readonly="1"/>
                    <field name="free_chlorin_level" readonly="1"/>
                    <field name="ph_level" readonly="1"/>
                    <field name="total_alkalinity" readonly="1"/>
                    <field name="cyanuric_acid" readonly="1"/>
                    <field name="calcium_hardness" readonly="1"/>
                    <field name="total_chlorine" readonly="1"/>
                    <field name="salinity" readonly="1"/>
                    <field name="tds" readonly="1"/>
                </group>
            </xpath>
            <xpath expr="//group[@name='signature']" position="replace">
                <group name="signature" string="Signature" invisible="checklist_type != 'service'">
                    <field name="signed_by" readonly="1"/>
                    <field name="signed_on" readonly="1"/>
                    <field name="signature" widget="image" readonly="1"/>
                    <field name='mail_sent_done' force_save="1" readonly="1"/>
                </group>
            </xpath>

            <xpath expr="//field[@name='projects_id']" position="before">
                <field name="checklist_type" readonly="1"/>
            </xpath>

            <xpath expr="//group[@name='signature']" position="after">
                <!-- Concrete -->
                <group name="con_section" string="Concrete" invisible="checklist_type != 'concrete'">
                    <field name="visit_site_and_finish_floor_level" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="excavation_and_compaction" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="cement_block_for_pool_layout" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="casting_clearance_concrete" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="external_waterproofing" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="steel_reinforcement_for_floor" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="steel_reinforcement_for_walls" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="casting_reinforcement_concrete_floor" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="form_work_for_walls" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="casting_reinforcement_concrete_walls" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="remove_framework_and_clean" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="curing_with_water" readonly="state == 'validate' or checklist_type == 'service'"/>
                </group>
                <!-- Concrete END -->

                <!-- Embedded Piping -->
                <group name="emp_section_1" string="Embedded Piping Section 1" invisible="checklist_type != 'embedded_piping'">
                    <field name="emp_floor_inlets" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_vacuum_point" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_main_drain" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_tank_suction" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_wall_suction" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_filling_lines" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_electrical_supply" readonly="state == 'validate' or checklist_type == 'service'"/>
                </group>
                <group name="emp_section_2" string="Embedded Piping Section 2" invisible="checklist_type != 'embedded_piping'">
                    <field name="emp_skimmer" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_big_lights" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_small_lights" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_jets" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_sump_pit" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_drain_pipes" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="emp_location_of_junction_box" readonly="state == 'validate' or checklist_type == 'service'"/>
                </group>
                <group name="emp_section_3" string="Embedded Piping Section 3" invisible="checklist_type != 'embedded_piping'">
