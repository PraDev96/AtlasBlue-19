                <group name="wbw_section_2" string="Embedded Piping Section 2" invisible="checklist_type != 'work_before_waterproofing'">
                    <field name="wbw_skimmer" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="wbw_big_lights" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="wbw_small_lights" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="wbw_jets" readonly="state == 'validate' or checklist_type == 'service'"/>
                    <field name="wbw_sump_pit" readonly="state == 'validate' or checklist_type == 'service'"/>
