    <!-- Checklist Tree Inherited for Civil/Mechanical Checklist fields -->
    <record id="project_checklist_tree_inherit_civil_checklist" model="ir.ui.view">
        <field name="name">project.checklist.tree.inherit.civil.checklist</field>
        <field name="model">project.checklist</field>
        <field name="inherit_id" ref="atlas_checklist.project_checklist_tree_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='projects_id']" position="before">
                <field name="name"/>
                <field name="checklist_type"/>
            </xpath>
            <xpath expr="//field[@name='signed_by']" position="after">
                <field name="signed_on" optional="hide"/>
                <field name="state"/>
            </xpath>
        </field>
    </record>

    <!-- Checklist Search Inherited for Civil/Mechanical Checklist fields -->
    <record id="project_checklist_search_inherit_civil_checklist" model="ir.ui.view">
        <field name="name">project.checklist.search.inherit.civil.checklist</field>
        <field name="model">project.checklist</field>
        <field name="inherit_id" ref="atlas_checklist.project_checklist_search_view"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='projects_id']" position="after">
                <field name="name"/>
            </xpath>
            <xpath expr="//filter[@name='group_employee']" position="after">
                <separator/>
                <filter string="Checklist Type" name="group_checklist_type" context="{'group_by': 'checklist_type'}"/>
                <filter string="Status" name="group_state" context="{'group_by': 'state'}"/>
                <separator/>
                <filter string="Archived" name="inactive" domain="[('active', '=', False)]"/>
                <separator/>
            </xpath>
            <xpath expr="//filter[@name='date']" position="after">
                <separator/>
                <filter string="Draft" name="draft_state" domain="[('state', '=', 'draft')]" help="UnValidated Checklist"/>
                <filter string="Approved" name="validated_state" domain="[('state', '=', 'validate')]" help="Validated Checklist"/>
                <separator/>
            </xpath>
        </field>
    </record>

    <!-- Civil/Mechanical Project Checklist Action -->
    <record id="action_civil_project_mechanical_checklist" model="ir.actions.act_window">
        <field name="name">Mechanical Project Checklist</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">project.checklist</field>
        <field name="view_mode">tree,form</field>
        <field name="domain">[('checklist_type', '!=', 'service')]</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No Civil / Mechanical Projects Checklist found!
            </p>
        </field>
    </record>

    <!-- Civil/Mechanical Project Checklist Menu -->
    <menuitem id="menu_civil_project_checklist"
              name="Mechanical Project Checklist"
              parent="project.menu_project_config"
              action="action_civil_project_mechanical_checklist"
              groups="ats_civil_project_checklist.group_civil_project_checklist"
              sequence="11"/>


    <!-- Service Project Checklist Action Domain -->
