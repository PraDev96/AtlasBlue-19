<?xml version='1.0' encoding='utf-8'?>
<odoo>

    <template id="project_progress_report">
        <t t-call="web.external_layout">
            <div class="page">
                <br/>
                <br/>
                <table class="table table-sm" style="border-bottom: 1px solid black;">
                    <thead>
                        <tr style="background:#1d2562;color:white;">
                            <th>
                                <span>Project Name</span>
                            </th>
                            <th>
                                <span>Project Completion(%)</span>
                            </th>
                            <th>
                                <span>Project Stage</span>
                            </th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr t-foreach="docs" t-as="o">
                            <td>
                                <span t-field="o.name"/>
                            </td>
                            <td class="text-right">
                                <span t-field="o.total_completion_percent"/>
                            </td>
                            <td>
                                <span t-field="o.state"/>
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </t>
    </template>

    <template id="project_progress_report_templates">
        <t t-call="web.html_container">
            <t t-call="auto_send_project_completion_email.project_progress_report" t-lang="lang"/>
        </t>
    </template>

    <!--<report
            id="project_report_action"
            model="project.project"
            string="Project Completion Report"
            report_type="qweb-pdf"
            name="auto_send_project_completion_email.project_progress_report_templates"
            file="auto_send_project_completion_email.project_progress_report_templates"
            print_report_name="(object.partner_id.name)"
    />-->

    <record id="project_report_action" model="ir.actions.report">
        <field name="name">Project Completion Report</field>
        <field name="model">project.project</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">auto_send_project_completion_email.project_progress_report_templates</field>
        <field name="report_file">auto_send_project_completion_email.project_progress_report_templates</field>
        <field name="print_report_name">(object.partner_id.name)</field>
        <field name="binding_model_id" ref="project.model_project_project"/>
        <field name="binding_type">report</field>
    </record>

</odoo>
