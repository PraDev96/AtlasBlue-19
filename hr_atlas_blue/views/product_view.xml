    <record id="product_template_form_view_inherit" model="ir.ui.view">
        <field name="name">product.template.form.inherit.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//div[@name='options']" position='inside'>
                <div>
                    <field name="vehicle_ok"/>
                    <label for="vehicle_ok"/>
                </div>
                <div>
                    <field name="accessory_ok"/>
                    <label for="accessory_ok"/>
                </div>
            </xpath>

            <field name="categ_id" position="after">
                <field name="plate_number"/>
            </field>

        </field>
    </record>

    <record id="product_template_tree_view_inherit" model="ir.ui.view">
        <field name="name">product.template.product.tree.inherit.rental</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_tree_view"/>
        <field name="arch" type="xml">

            <field name="name" position="after">
                <field name="weight"/>
            </field>

        </field>
    </record>

    <!-- Product -->
    <record id="product_normal_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.form.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_normal_form_view"/>
        <field name="arch" type="xml">
            <!-- <xpath expr="//div[@name='options']/div[2]" position="after">
                <div>
                    <field name="vehicle_ok"/>
                    <label for="vehicle_ok"/>
                </div>
                <div>
                    <field name="accessory_ok"/>
                    <label for="accessory_ok"/>
                </div>
            </xpath> -->

            <field name="default_code" position="after">
                <field name="plate_number"/>
            </field>

            <notebook position="inside">
                <page string="Vehicle" invisible="vehicle_ok == False">
                    <group>
                        <group>
                            <field name="vehicle_ok" invisible="1"/>
                            <field name="model_id" required="vehicle_ok == True"/>
                            <field name="vehicle_id" readonly="True"/>
                        </group>
                        <group>
                            <field name="license_plate" required="vehicle_ok == True"/>
                        </group>
                    </group>
                </page>
            </notebook>

            <xpath expr="//div[@name='button_box']" position="inside">
                <button name="action_fleet" class="oe_stat_button" type="object" icon="fa-car">
                    <div class="o_stat_info">
                        <field name="fleet_count"/>
                        <span class="o_stat_text">Fleets</span>
                    </div>
                </button>
            </xpath>

        </field>
    </record>

    <record id="product_search_form_view_inherit" model="ir.ui.view">
        <field name="name">product.product.search.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_search_form_view"/>
        <field name="arch" type="xml">

            <xpath expr="//filter[@name='categ_id']" position="after">
                <filter string="Plate Number" name="plate_number" context="{'group_by':'plate_number'}"/>
            </xpath>

        </field>
    </record>

    <record id="product_product_tree_view_inherit" model="ir.ui.view">
        <field name="name">product.product.tree.inherit</field>
        <field name="model">product.product</field>
        <field name="inherit_id" ref="product.product_product_tree_view"/>
        <field name="arch" type="xml">

            <field name="name" position="after">
                <field name="weight"/>
            </field>

        </field>
    </record>

