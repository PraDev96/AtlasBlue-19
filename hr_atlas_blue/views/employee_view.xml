    <!-- Employee Asset -->
    <record id="emp_asset_tree_inherit" model="ir.ui.view">
        <field name="name">employee.asset.more.fields.inherit</field>
        <field name="model">employee.asset</field>
        <field name="inherit_id" ref="boutiqaat_hr_base.emp_asset_tree"/>
        <field name="arch" type="xml">

            <field name="date_assigned" position="after">
                <field name="attachment_number" invisible="1"/>
                <button name="action_get_attachment_view" string="View Attached Documents" type="object" icon="fa-paperclip" invisible="attachment_number == 0"/>
                <field name="date_return"/>
                <field name="asset_category_id"/>
                <field name="asset_number_id"/>
                <field name="asset_condition_id"/>
                <field name="company_id"/>
            </field>

            <field name="employee_id" position="before">
                <field name="name"/>
            </field>

            <field name="employee_id" position="after">
                <field name="joining_date"/>
                <field name="job_position_id"/>
            </field>

        </field>
    </record>

    <record id="emp_asset_form_inherit" model="ir.ui.view">
        <field name="name">employee.asset.more.fields.inherit</field>
        <field name="model">employee.asset</field>
        <field name="inherit_id" ref="boutiqaat_hr_base.emp_asset_form"/>
        <field name="arch" type="xml">

            <xpath expr="//sheet" position="before">
                <div class="oe_edit_only">
                    <label for="name"/>
                </div>
                <h2>
                    <field name="name" placeholder="eg. Laptop"/>
                </h2>
                <header>
                    <button name="action_return" type="object" string="Return" invisible="date_return != False"/>
                    <widget name="attach_document" string="Attach Document" action="message_post" invisible="attachment_number &lt; 1 or id == False"/>
                    <widget name="attach_document" string="Attach Document" action="message_post" highlight="1" invisible="attachment_number &gt;= 1 or id == False"/>
                </header>
            </xpath>

            <field name="date_assigned" position="after">
                <field name="date_return"/>
                <field name="asset_number_id"/>
                <field name="asset_condition_id"/>
                <field name="detail_info"/>
                <field name="company_id"/>
            </field>

            <field name="employee_id" position="after">
                <field name="joining_date"/>
                <field name="job_position_id"/>
                <field name="asset_category_id"/>
            </field>

            <xpath expr="//sheet" position="after">
                <div class="oe_chatter">
                    <field name="message_follower_ids" widget="mail_followers" groups="base.group_user"/>
                    <field name="activity_ids" widget="mail_activity"/>
                    <field name="message_ids" widget="mail_thread"/>
                </div>
            </xpath>

            <xpath expr="//div[hasclass('oe_edit_only')]" position="after">
                <div class="oe_button_box" name="button_box">
                    <button name="action_get_attachment_view" class="oe_stat_button" icon="fa-file-text-o" type="object">
                        <field name="attachment_number" widget="statinfo" string="Documents" options="{'reload_on_button': true}"/>
                    </button>
                </div>
            </xpath>

        </field>
    </record>

    <record id="emp_asset_search_inherit" model="ir.ui.view">
        <field name="name">employee.asset.more.fields</field>
        <field name="model">employee.asset</field>
        <field name="inherit_id" ref="boutiqaat_hr_base.emp_asset_search"/>
        <field name="arch" type="xml">

            <field name="employee_id" position="replace">
                <field name="name"/>
            </field>

            <field name="name" position="before">
                <field name="employee_id"/>
            </field>

            <field name="date_assigned" position="after">
                <field name="asset_number_id"/>
            </field>
            <xpath expr="//filter[@name='date_assigned']" position="after">
                <filter string="Employee" name="employee_id" context="{'group_by':'employee_id'}"/>
                <filter string="Asset Category" name="asset_category_id" context="{'group_by':'asset_category_id'}"/>
                <filter string="Asset Condition" name="asset_condition_id" context="{'group_by':'asset_condition_id'}"/>
                <filter string="Asset Number" name="asset_number_id" context="{'group_by':'asset_number_id'}"/>
            </xpath>

        </field>
    </record>

