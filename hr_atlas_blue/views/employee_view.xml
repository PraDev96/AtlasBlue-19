    <record model="ir.ui.view" id="view_employee_asset_type_kanban">
        <field name="name">employee.asset.type.kanban</field>
        <field name="model">employee.asset.type</field>
        <field name="arch" type="xml">

            <kanban class="oe_background_grey o_kanban_dashboard o_project_kanban o_emphasize_colors" on_create="hr_atlas_blue.open_create_employee_asset_type">
                <field name="name"/>
                <field name="employee_asset_count"/>
                <templates>
                    <t t-name="kanban-box">
                        <div t-attf-class="oe_kanban_global_click oe_kanban_card">
                            <div>
                                <div class="oe_kanban_content">
                                    <div class="o_kanban_primary_left">
                                        <div class="o_primary">
                                            <span>
                                                <t t-esc="record.name.value"/>
                                            </span>
                                        </div>
                                    </div>
                                </div>
                                <div class="o_kanban_card_manage_pane dropdown-menu" role="menu">
                                    <div class="o_kanban_card_manage_section">
                                        <div role="menuitem">
                                            <a type="edit">Edit</a>
                                        </div>
                                        <div role="menuitem">
                                            <a type="delete">Delete</a>
                                        </div>
                                    </div>
                                </div>
                                <a class="o_kanban_manage_toggle_button o_left" href="#">
                                    <i class="fa fa-ellipsis-v" role="img" aria-label="Manage" title="Manage"/>
                                </a>
                            </div>

                            <div class="o_rental_kanban_boxes">
                                <a class="o_rental_kanban_boxes" name="%(employee_asset_kanban_action)d" type="action">
                                    <div>
                                        <span class="o_value">
                                            <t t-esc="record.employee_asset_count.value"/>
                                        </span>
                                        Assets
                                    </div>
                                </a>
                            </div>
                        </div>
                    </t>
                </templates>
            </kanban>

        </field>
    </record>

