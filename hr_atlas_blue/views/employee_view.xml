    <record id="hr_contract_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//group[@name='notes_group']" position="before">
                <group>
                    <group>
                        <field name="last_ticket_date"/>
                        <field name="ticket_per_month"/>
                        <field name="ticket_amount"/>
                        <field name="cost_per_hour"/>
                    </group>
                    <group>
                    </group>
                </group>
            </xpath>
            <xpath expr="//label[@for='books_allowance']" position="replace"/>
            <xpath expr="//div[@name='books_allowance']" position="replace">
