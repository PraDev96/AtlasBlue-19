<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="stock_fleet_locations_partner" model="stock.location">
        <field name="name">Fleet Location</field>
        <field name="usage">customer</field>
        <field name="is_fleet_location" eval="True"/>
        <field name="company_id"></field>
    </record>

    <record model="ir.ui.view" id="view_employee_form_inherit">
        <field name="name">hr.employee.form.inherit</field>
        <field name="model">hr.employee</field>
        <field name="inherit_id" ref="hr.view_employee_form"/>
        <field name="arch" type="xml">

            <field name="parent_id" position="after">
                <field name="allow_over_time" widget="float_time"/>
                <field name="current_position_id" invisible="1"/>
            </field>

            <field name="visa_no" position="after">
                <field name="visa_type_id"/>
                <field name="visa_issue_date"/>
            </field>

            <field name="visa_expire" position="after">
                <field name="visa_type_id" invisible="1"/>
                <field name="visa_issue_date" invisible="1"/>
                <field name="non_resident"/>
            </field>

            <field name="work_phone" position="after">
                <field name="kuwait_phone_number"/>
            </field>

            <field name="country_of_birth" position="after">
                <field name="health_card_start_date"/>
                <field name="health_card_end_date"/>
            </field>

            <field name="iban_number" position="after">
                <field name="bank_card_start_date"/>
                <field name="bank_card_expiry_date"/>
            </field>

            <field name="country_id" position="after">
                <field name="emp_code" invisible="1"/>
                <field name="employee_state"/>
            </field>

            <field name="civil_start_date" position="replace">
                <field name="civil_serial_number"/>
                <field name="vehicle_id"/>
            </field>

            <field name="residency_expiry_date" position="before">
                <field name="article_resideny_id"/>
                <field name="residency_start_date"/>
                <field name="license_expiry_date"/>
            </field>

            <field name="residency_number" position="after">
                <field name="vaccination_date"/>
                <field name="finger_print_date"/>
                <field name="medical_date"/>
                <field name="kuwait_entry_date"/>
            </field>

            <notebook position="inside">
                <page string="Employee Date History" name="employee_date_history">
                    <field name="employee_date_history_ids" readonly="1">
                        <tree string="Employee Date History" editable='top'>
                            <field name="name"/>
                            <field name="from_value"/>
                            <field name="to_value"/>
                            <field name="create_date"/>
                            <field name="write_date"/>
                            <field name="user_id"/>
                        </tree>
                        <form string="Employee Date History">
                            <group>
                                <group>
                                    <field name="name"/>
                                    <field name="from_value"/>
                                    <field name="create_date"/>
                                </group>
                                <group>
                                    <field name="user_id"/>
                                    <field name="to_value"/>
                                    <field name="write_date"/>
                                </group>
                            </group>
                        </form>
                    </field>
                </page>

                <page string="Employee Notes" name="employee_note">
                    <field name="employee_note_ids">
                        <tree string="Employee Notes">
                            <field name="name"/>
                            <field name="description"/>
                        </tree>
                        <form string="Employee Notes">
                            <group>
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                        </form>
                    </field>
                </page>
            </notebook>

            <field name="eos_additional_work" position="before">
                <field name="eos_opening_balance_days"/>
            </field>

            <field name="private_address" position="after">
                <field name="employee_address"/>
            </field>

            <field name="private_address" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

            <field name="work_location_id" position="attributes">
                <attribute name="invisible">1</attribute>
            </field>

        </field>
    </record>


