<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Project -->
    <record id="edit_project_inherit" model="ir.ui.view">
        <field name="name">project.project.form.inherit</field>
        <field name="model">project.project</field>
        <field name="inherit_id" ref="project.edit_project"/>
        <field name="arch" type="xml">

            <field name="date_end" position="after">
                <field name="project_months"/>
                <field name="hours_count"/>
                <field name="is_project_value_can_update" invisible="1"/>
                <field name="project_value" readonly="not is_project_value_can_update"/>
                <field name="project_cost" readonly="not is_project_value_can_update"/>
            </field>

            <field name="partner_id" position="after">
                <field name="partner_fees"/>
            </field>

            <field name="employee_cost_lines" position="before">
                <group>
                    <group>
                        <field name="res_allocation_by"/>
                    </group>
                    <group></group>
                </group>
            </field>

            <field name="employee_cost_lines" position="after">
                <group name="note_group" col="6">
                    <group colspan="4"/>
                    <group class="oe_subtotal_footer text-right" colspan="2">
                        <field name="sale_cost_total"/>
                        <field name="cost_total"/>
                        <div class="oe_subtotal_footer_separator oe_inline o_td_label">
                            <label for="margin_total"/>
                        </div>
                        <field name="margin_total" nolabel="1" class="oe_subtotal_footer_separator"/>
                    </group>
                    <div class="oe_clear"/>
                </group>
            </field>

        </field>
    </record>

    <!-- Task -->
    <record id="view_task_form2_inherit" model="ir.ui.view">
        <field name="name">project.task.form.inherit</field>
        <field name="model">project.task</field>
        <field name="inherit_id" ref="project.view_task_form2"/>
        <field name="arch" type="xml">

            <xpath expr="//label[@for='date_deadline']" position="before">
                <field name="date_start"/>
                <field name="task_end_date" invisible="1"/>
            </xpath>

            <field name="user_ids" position="before">
                <field name="employee_id"/>
                <field name="user_id"/>
                <field name="restaurant_id" invisible="1"/>
            </field>

            <field name="project_id" position="before">
                <field name="number"/>
            </field>

        </field>
    </record>

</odoo>
