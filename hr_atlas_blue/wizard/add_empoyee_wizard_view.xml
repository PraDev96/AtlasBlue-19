<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_add_employee_wizard_form" model="ir.ui.view">
        <field name="name">add.employee.wizard.form</field>
        <field name="model">add.employee.wizard</field>
        <field name="arch" type="xml">

            <form string="Add Employees">
                <group>
                    <field name="start_date"/>
                    <field name="employee_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button string="Add Employee" name="add_employee" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="action_add_employee_wizard" model="ir.actions.act_window">
        <field name="name">Add Employees Wizard</field>
        <field name="res_model">add.employee.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
