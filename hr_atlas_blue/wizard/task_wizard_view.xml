<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="field_service_consumed_wizard_view_form" model="ir.ui.view">
        <field name="name">field.service.consumed.wizard.form</field>
        <field name="model">field.service.consumed.wizard</field>
        <field name="arch" type="xml">

            <form string="Field Service Consumed Product Wizard">
                <group>
                    <group>
                        <field name="start_date"/>
                    </group>
                    <group>
                        <field name="end_date"/>
                    </group>
                </group>
                <group>
                    <field name="service_type"/>
                    <field name="product_category_ids" widget="many2many_tags" invisible="service_type != 'category'"/>
                    <field name="product_ids" widget="many2many_tags" invisible="service_type != 'product'"/>
                    <field name="partner_ids" widget="many2many_tags"/>
                    <field name="branch_ids" widget="many2many_tags"/>
                </group>
                <footer>
                    <button name="action_xlsx" string="Xlsx" type="object" class="btn-primary"/>
                    <button string="Cancel" class="btn-secondary" special="cancel"/>
                </footer>
            </form>

        </field>
    </record>

    <record id="field_service_consumed_wizard_action" model="ir.actions.act_window">
        <field name="name">Consume Product Report</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">field.service.consumed.wizard</field>
        <field name="view_mode">form</field>
        <field name="view_id" ref="field_service_consumed_wizard_view_form"/>
        <field name="target">new</field>
    </record>

    <menuitem id="task_reports"
              name="Consume Product Report"
              action="field_service_consumed_wizard_action"
              parent="industry_fsm.fsm_menu_reporting"
              sequence="92"/>

</odoo>
