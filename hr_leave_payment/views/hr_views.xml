<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="hr_leave_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.leave.form.inherit</field>
        <field name="model">hr.leave</field>
        <field name="inherit_id" ref="hr_holidays.hr_leave_view_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='name']" position="before">
                <field name="allow_encashment" invisible="1"/>
                <field name="payment_type" invisible="allow_encashment == False" readonly="state == 'validate'"/>
                <field name="period_date" invisible="allow_encashment ==  False" required="payment_type != False" readonly="state == 'validate'"/>
                <field name="payment_reference" invisible="allow_encashment == False" readonly="state == 'validate'"/>
                <field name="pay_days" invisible="allow_encashment == False"/>
                <field name="pay_rate" invisible="allow_encashment == False"/>
                <field name="payment_rate_total" invisible="allow_encashment == False"/>
                <field name="payslip_id" readonly="1" invisible="allow_encashment == False or payslip_id == False"/>
                <field name="emp_input_id" readonly="1" invisible="allow_encashment == False or emp_input_id == False"/>
            </xpath>

            <xpath expr="//sheet" position="inside">
                <div class="oe_button_box" name="button_box">
                    <button class="oe_stat_button" type="object" icon="fa-ticket" name="action_payslip_line_view" invisible="payslip_line_count == 0">
                        <field string="Payslip Lines" name="payslip_line_count" widget="statinfo"/>
                    </button>
                    <button class="oe_stat_button" type="object" icon="fa-calendar" name="action_emp_input_view" invisible="emp_input_line_count == 0">
                        <field string="Emp Input Lines" name="emp_input_line_count" widget="statinfo"/>
                    </button>
                </div>
            </xpath>

        </field>
    </record>

    <record id="edit_holiday_status_form_encasement" model="ir.ui.view">
        <field name="name">hr.leave.type.encasement.inherit</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.edit_holiday_status_form"/>
        <field name="arch" type="xml">

            <field name="leave_validation_type" position="after">
                <field name="allow_encashment"/>
            </field>

            <field name="request_unit" position="after">
                <field name="code"/>
            </field>

        </field>
    </record>

    <record id="holiday_status_tree_inherit_code" model="ir.ui.view">
        <field name="name">holiday.status.tree.inherit.code</field>
        <field name="model">hr.leave.type</field>
        <field name="inherit_id" ref="hr_holidays.view_holiday_status_normal_tree"/>
        <field name="arch" type="xml">

            <field name="display_name" position="after">
                <field name="code"/>
            </field>

        </field>
    </record>


    <record id="hr_contract_view_form_inherit" model="ir.ui.view">
        <field name="name">hr.contract.form.inherit</field>
        <field name="model">hr.contract</field>
        <field name="inherit_id" ref="hr_contract.hr_contract_view_form"/>
        <field name="arch" type="xml">

            <field name="hr_responsible_id" position="after">
                <label for="leave_allocation"/>
                <div class="o_row" name="leave_allocation">
                    <field name="leave_allocation" nolabel="1"/>
                    <field name="allocation_type"/>
                </div>
            </field>

        </field>
    </record>

    <!-- Payslip Line -->
    <record id="view_hr_payslip_line_leave_tree" model="ir.ui.view">
        <field name="name">hr.payslip.line.tree</field>
        <field name="model">hr.payslip.line</field>
        <field name="arch" type="xml">

            <tree string="Salary Structure" edit="false" create="false" delete="false">
                <field name="sequence"/>
                <field name="slip_id"/>
                <field name="employee_id"/>
                <field name="category_id"/>
                <field name="contract_id"/>
                <field name="name"/>
                <field name="rate"/>
                <field name="amount"/>
                <field name="code"/>
                <field name="category_id"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="quantity"/>
                <field name="rate"/>
                <field name="total"/>
                <field name="amount_select"/>
                <field name="partner_id"/>
            </tree>

        </field>
    </record>

    <!-- Employee Input Line -->
    <record id="view_emp_input_line_leave_tree" model="ir.ui.view">
        <field name="name">emp.input.line.leave.tree</field>
        <field name="model">emp.input.line</field>
        <field name="arch" type="xml">

            <tree string="Input Type" create="false" edit="false" delete="false">
                <field name="emp_input_id"/>
                <field name="payslip_id"/>
                <field name="payslip_date"/>
                <field name="amount" sum="Total Amount"/>
                <field name="state"/>
            </tree>

        </field>
    </record>

</odoo>
