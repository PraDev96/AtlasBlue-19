<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="0">

        <record model="ir.rule" id="hr_claim_comp_rule">
            <field name="name">Claim Multi-Company</field>
            <field name="model_id" ref="model_hr_claim"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="hr_insurance_comp_rule">
            <field name="name">Insurance Multi-Company</field>
            <field name="model_id" ref="model_hr_insurance"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record model="ir.rule" id="hr_insurance_type_user_rule">
            <field name="name">Insurance Type User</field>
            <field name="model_id" ref="hr_insurance.model_insurance_transcation_type"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|', ('user_ids', '=', False), ('user_ids', 'in', [user.id])]</field>
        </record>


        <record id="group_insurance_user" model="res.groups">
            <field name="name">Insurance User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record model="ir.rule" id="hr_insurance_user_rule">
            <field name="name">Insurance User</field>
            <field name="model_id" ref="model_hr_insurance"/>
            <field name="global" eval="True"/>
            <field name="domain_force">['|',('company_id','=',False),('company_id', 'in', company_ids)]</field>
        </record>

        <record id="group_claim_user" model="res.groups">
            <field name="name">Claim User</field>
            <field name="implied_ids" eval="[(4, ref('base.group_user'))]"/>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>


        <record id="group_expense_requester_user" model="res.groups">
            <field name="name">Expense Requester User</field>
            <field name="category_id" ref="base.module_category_hidden"/>
        </record>

        <record id="expense_requester_user_rule" model="ir.rule">
            <field name="name">Expense Requester Rule</field>
            <field name="model_id" ref="hr_expense.model_hr_expense"/>
            <field name="domain_force">['|',('requester_id', '=', user.id),('requester_id', '=', False)]</field>
            <field name="groups" eval="[(4, ref('hr_insurance.group_expense_requester_user'))]"/>
        </record>


        <record id="expense_requester_user_rule" model="ir.rule">
            <field name="name">Expense Requester Rule</field>
            <field name="model_id" ref="hr_insurance.model_insurance_transcation_type"/>
            <field name="domain_force">[('user_ids', 'in', user.id)]</field>
            <field name="groups" eval="[(4, ref('hr_insurance.group_expense_requester_user'))]"/>
        </record>

    </data>
</odoo>
