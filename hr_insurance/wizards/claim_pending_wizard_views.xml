<?xml version="1.0" encoding="UTF-8"?>
<odoo>

    <record id="view_claim_pending_wizard_form" model="ir.ui.view">
        <field name="name">claim.pending.wizard.form</field>
        <field name="model">claim.pending.wizard</field>
        <field name="arch" type="xml">
            <form string="Claim Pending">
                <span class="o_form_label">Warning: Are you sure want to make claim pending?</span>
                <footer>
                    <button string="Pending" name="action_pending" type="object" class="oe_highlight"/>
                    <button string="Cancel" class="btn btn-secondary" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <!--<act_window id="action_claim_pending_wizard"
                name="Claim Pending"
                res_model="claim.pending.wizard"
                binding_model="hr.claim"
                binding_views="list"
                view_mode="form"
                target="new"/>-->

    <record id="action_claim_pending_wizard" model="ir.actions.act_window">
        <field name="name">Claim Pending</field>
        <field name="type">ir.actions.act_window</field>
        <field name="res_model">claim.pending.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

</odoo>
