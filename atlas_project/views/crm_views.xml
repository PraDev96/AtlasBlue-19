<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="crm_lead_helpdesk" model="ir.ui.view">
        <field name="name">crm.lead.form.helpdesk</field>
        <field name="model">crm.lead</field>
        <field name="inherit_id" ref="crm.crm_lead_view_form"/>
        <field name="arch" type="xml">

            <field name='user_id' position="before">
                <field name="ticket_id"/>
            </field>
            <field name='team_id' position="attributes">
                <attribute name="domain">[('type_team','=','sale')]</attribute>
            </field>
            <xpath expr="//field[@name='team_id']" position="after">
                <field name="detail"/>
            </xpath>
            <xpath expr="//page[@name='lead']/group/group[3]/field[@name='medium_id']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>

            <field name='opportunity_type' position="after">
                <field name="number_of_days_per_week" invisible="opportunity_type != 'service'"/>
                <field name="day_ids" widget="many2many_tags" invisible="opportunity_type != 'service'"/>
                <field name="lead_through"/>
                <field name="hr_employee_id" invisible="lead_through != 'internal'"/>
                <field name="commission_to" invisible="lead_through != 'external_party'"/>
                <label for="commission"/>
                <div class="o_row">
                    <field name="commission"/>
                    <span class="oe_black">%</span>
                </div>
                <field name="third_party_id" invisible="1"/>
                <field name="commission" widget="percentage" invisible="1"/>
            </field>

        </field>
    </record>

    <record id="crm_stage_helpdesk" model="ir.ui.view">
        <field name="name">crm.stage.helpdesk</field>
        <field name="model">crm.stage</field>
        <field name="inherit_id" ref="crm.crm_stage_form"/>
        <field name="arch" type="xml">

            <field name='team_id' position="after">
                <field name="code"/>
            </field>

        </field>
    </record>

</odoo>
