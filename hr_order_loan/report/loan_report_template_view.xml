<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <template id="report_hr_order_loan_document">
            <t t-call="web.external_layout">
                <div class="page">
                    <h3 class="text-center">Loan Report</h3>

                    <div class="mt32 mb32">
                        <strong>Loan Number:</strong>
                        <span t-field="o.name"/>
                    </div>

                    <div class="row">
                        <table class="table table-sm table-borderless" cellpadding="0" cellspacing="0" width="590" style="padding: 8px;">
                            <tr>
                                <td>
                                    <strong>
                                        <strong>Employee</strong>
                                    </strong>
                                </td>
                                <td>
                                    <span t-field="o.employee_id"/>
                                </td>
                                <td>
                                    <strong>Date</strong>
                                </td>
                                <td>
                                    <span t-field="o.date"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>
                                        <strong>Receiving Date</strong>
                                    </strong>
                                </td>
                                <td>
                                    <span t-field="o.receiving_date"/>
                                </td>
                                <td>
                                    <strong>Payment Method</strong>
                                </td>
                                <td>
                                    <span t-field="o.payment_type"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Payment Start Date</strong>
                                </td>
                                <td>
                                    <span t-field="o.payment_date"/>
                                </td>
                                <td>
                                    <strong>Loan Amount</strong>
                                </td>
                                <td>
                                    <span t-field="o.loan_amount"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>No Of Installments</strong>
                                </td>
                                <td>
                                    <span t-field="o.installment"/>
                                </td>
                                <td>
                                    <strong>Job Position</strong>
                                </td>
                                <td>
                                    <span t-field="o.job_position"/>
                                </td>
                            </tr>
                            <tr>
                                <td>
                                    <strong>Settlement Date</strong>
                                </td>
                                <td>
                                    <span t-field="o.settlement_date"/>
                                </td>
                                <td>
                                    <strong>Company</strong>
                                </td>
                                <td>
                                    <span t-field="o.company_id"/>
                                </td>
                            </tr>
                        </table>
                    </div>

                    <div class="row">
                        <table class="table table-sm table-borderless" name="installment_table">
                            <thead>
                                <tr>
                                    <th class="text-center">No</th>
                                    <th class="text-center">Payment Date</th>
                                    <th class="text-center">Amount</th>
                                    <th class="text-center">Paid</th>
                                    <th class="text-center">Payslip Ref</th>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-set="no" t-value="1"/>
                                <t t-foreach="o.loan_lines" t-as="line">
                                    <tr>
                                        <td>
                                            <t t-esc="no"/>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="line.date"/>
                                        </td>
                                        <td class="text-right">
                                            <span t-field="line.amount"/>
                                        </td>
                                        <td class="text-center">
                                            <t t-if="line.paid">
                                                <i class="fa-check-square-o"/>
                                            </t>
                                            <t t-else="">
                                                <i class="fa fa-square-o"/>
                                            </t>
                                        </td>
                                        <td class="text-center">
                                            <span t-field="line.payslip_id"/>
                                        </td>
                                        <t t-set="no" t-value="no + 1"/>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>

                    <div class="row" style="page-break-inside: avoid;">
                        <table class="table table-bordered">
                            <tr>
                                <td class="text-center">
                                    <strong>Reviewed By</strong>
                                </td>
                                <td class="text-center">
                                    <strong>Acknowledged By</strong>
                                </td>
                                <td class="text-center">
                                    <strong>Approved By</strong>
                                </td>
                            </tr>
                            <tr style="height:50px;">
                                <td style="margin-top: 150px;">
                                </td>
                                <td>
                                </td>
                                <td>
                                </td>
                            </tr>
                            <tr style="height:50px;">
                                <td>
                                    <strong>Date</strong>
                                </td>
                                <td colspan="3">
                                </td>
                            </tr>
                        </table>
                    </div>

                </div>
            </t>
        </template>

        <template id="report_hr_order_loan">
            <t t-call="web.html_container">
                <t t-foreach="docs" t-as="o">
                    <t t-call="hr_order_loan.report_hr_order_loan_document"/>
                </t>
            </t>
        </template>

    </data>
</odoo>
