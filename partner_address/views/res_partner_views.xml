<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="partner_view_extra_address_fields" model="ir.ui.view">
        <field name="name">res.partner.extra.address.fields</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <field name="vat" position="before">
                <field name="customer_rank" invisible="1"/>
                <field name="governorate_id" options="{'no_create': True}" required="type == 'delivery' or customer_rank &gt; 0"/>
                <field name="area_id" domain="[('governorate_id', '=', governorate_id)]"
                       options="{'no_create': True}" required="type == 'delivery' or customer_rank &gt; 0"/>
                <field name="paci_number"/>
                <field name="block"/>
                <field name="avenue"/>
                <field name="house"/>
                <field name="floor"/>
                <field name="apartment_no"/>
            </field>
            <field name="vat" position="before">
                <field name="civil_code"/>
            </field>

        </field>
    </record>

    <record id="view_partner_form_inherit" model="ir.ui.view">
        <field name="name">res.partner.vat.inherit</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <xpath expr="//field[@name='child_ids']//form//field[@name='country_id']" position="after">
                <field name="area_id" placeholder="Area"/>
                <field name="block" placeholder="Block"/>
                <field name="avenue" placeholder="Avenue"/>
                <field name="house" placeholder="House"/>
                <field name="floor" placeholder="Floor"/>
                <field name="apartment_no" placeholder="Apartment"/>
            </xpath>

        </field>
    </record>

    <record id="partner_city_area_tree_view" model="ir.ui.view">
        <field name="name">res.city.area.tree</field>
        <field name="model">res.city.area</field>
        <field name="arch" type="xml">

            <tree editable="top">
                <field name="name"/>
                <field name="governorate_id"/>
                <field name="is_published"/>
            </tree>

        </field>
    </record>

    <record id="partner_city_area_action" model="ir.actions.act_window">
        <field name="name">City Area</field>
        <field name="res_model">res.city.area</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new City Area.
            </p>
        </field>
    </record>

    <menuitem id="menu_localisation_city_area"
              name="City Area"
              action="partner_city_area_action"
              parent="contacts.menu_localisation"
              sequence="20"/>

    <record id="partner_governorate_tree_view" model="ir.ui.view">
        <field name="name">res.governorate.tree</field>
        <field name="model">res.governorate</field>
        <field name="arch" type="xml">

            <tree editable="top">
                <field name="name"/>
                <field name="is_published"/>
            </tree>

        </field>
    </record>

    <record id="partner_governorate_action" model="ir.actions.act_window">
        <field name="name">Governorate</field>
        <field name="res_model">res.governorate</field>
        <field name="view_mode">tree</field>
        <field name="help" type="html">
            <p class="oe_view_nocontent_create">
                Click to create a new Governorate.
            </p>
        </field>
    </record>

    <menuitem id="menu_localisation_governorate"
              name="Governorate"
              action="partner_governorate_action"
              parent="contacts.menu_localisation"
              sequence="19"/>

</odoo>
